---
// src/pages/projects/[slug].astro
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import TechBadgeList from '../../components/TechBadgeList.astro';
import NoImagePlaceholder from '../../components/NoImagePlaceholder.astro';
import { supabase } from '../../utils/supabase';
import { getBaseUrl } from '../../utils/url';
import { parseProjectImages, isReadmeUrl, fetchReadmeMarkdown } from '../../utils/projects';
import { splitLines, splitCommaList } from '../../utils/text';
import { renderMarkdownSafe } from '../../utils/sanitize';
import { GitHubProjectsService } from '../../services/githubProjectsService';
import '../../styles/main.scss';

const { slug } = Astro.params;

let project: any = null;
let notFound = false;
let allProjectsList: any[] = [];

if (!slug) {
  notFound = true;
} else {
  try {
    const isNumeric = /^\d+$/.test(slug);

    let query = supabase
      .from('projects')
      .select(`
        *,
        project_experience (
          work_experience (*)
        )
      `);

    if (isNumeric) {
      query = query.eq('id', parseInt(slug, 10));
    } else {
      query = query.eq('slug', slug);
    }

    const { data, error } = await query.maybeSingle();

    const { data: allDbProjects } = await supabase
      .from('projects')
      .select(`
        *,
        project_experience (
          work_experience (*)
        )
      `);

    const { projects: ghProjects } = await GitHubProjectsService.getPortfolioProjects(supabase, allDbProjects || []);
    allProjectsList = ghProjects || allDbProjects || [];

    if (error || !data) {
      project = allProjectsList.find(
        (p) =>
          String(p.id).toLowerCase() === slug.toLowerCase() ||
          p.slug?.toLowerCase() === slug.toLowerCase() ||
          p.repo_name?.toLowerCase() === slug.toLowerCase()
      );

      if (!project) {
        notFound = true;
      }
    } else {
      project = data;
    }
  } catch (err) {
    console.error(`[projects/[slug]] Error resolving project "${slug}":`, err);
    notFound = true;
  }
}

// Compute Previous and Next project links for bottom navigation
let prevProject: any = null;
let nextProject: any = null;
if (project && allProjectsList.length > 1) {
  const currentIndex = allProjectsList.findIndex(
    (p) =>
      p.slug === project.slug ||
      String(p.id) === String(project.id) ||
      (p.repo_name && p.repo_name === project.repo_name)
  );

  if (currentIndex !== -1) {
    prevProject = currentIndex > 0 ? allProjectsList[currentIndex - 1] : allProjectsList[allProjectsList.length - 1];
    nextProject = currentIndex < allProjectsList.length - 1 ? allProjectsList[currentIndex + 1] : allProjectsList[0];
  }
}

const images = parseProjectImages(project);
const baseUrl = getBaseUrl();
const summaryPoints = splitLines(project?.summary);
const rawContent = project?.content?.trim() || '';
let parsedContentHtml = '';

if (rawContent) {
  try {
    if (isReadmeUrl(rawContent)) {
      const fetchedMarkdown = await fetchReadmeMarkdown(rawContent);
      if (fetchedMarkdown) {
        parsedContentHtml = renderMarkdownSafe(fetchedMarkdown);
      } else {
        parsedContentHtml = renderMarkdownSafe(`> 📖 **Project Documentation**\n>\n> [View README on GitHub](${rawContent})`);
      }
    } else {
      parsedContentHtml = renderMarkdownSafe(rawContent);
    }
  } catch (err) {
    console.error(`[projects/[slug]] Error rendering markdown for "${slug}":`, err);
    parsedContentHtml = '';
  }
}

// Extract linked company/internship experience
const associatedExperiences = (project?.project_experience || [])
  .map((pe: any) => pe.work_experience)
  .filter(Boolean);

const techCount = splitCommaList(project?.tech_stack).length;
const heroImage = images[0] || (project?.repo_name ? `https://opengraph.githubassets.com/1/ryguy0601/${project.repo_name}` : '/og-image.png');
const pageDescription = project?.summary ? project.summary.slice(0, 155) : 'Engineering deep dive and architecture showcase.';
---

<Layout 
  hasHero={false} 
  title={project ? `${project.title} — Ryan Cuccurullo` : 'Project Not Found'}
  description={pageDescription}
  image={heroImage}
>
  <div class="project-detail-wrapper position-relative overflow-hidden py-4 py-lg-5">
    
    <!-- Ambient Fluid Glow Background -->
    <div class="ambient-glow ambient-glow-1"></div>
    <div class="ambient-glow ambient-glow-2"></div>

    <div class="container position-relative z-2">
      <div class="row justify-content-center">
        <div class="col-12 col-xl-10 single-column-container">

          <!-- Top Navigation Strip -->
          <header class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
            <a href={`${baseUrl}projects`} class="btn btn-dark border border-secondary text-accent d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill shadow-sm nav-back-link">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
              </svg>
              <span class="font-monospace small">All Projects</span>
            </a>

            {project?.featured && (
              <span class="badge featured-badge-banner px-3 py-2 rounded-pill font-monospace small">
                ★ Featured Work
              </span>
            )}
          </header>

          {notFound || !project ? (
            /* 404 Empty State */
            <div class="my-5 py-5 text-center">
              <div class="card detail-glass-card p-5 rounded-4 shadow-2xl mx-auto" style="max-width: 580px;">
                <div class="mb-3 text-warning">
                  <svg width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M7.938 2.016a.13.13 0 0 1 .125 0l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.127.084H1.205a.163.163 0 0 1-.127-.084.185.185 0 0 1 .002-.183L7.938 2.016zM8 1a1 1 0 0 0-.86.49l-6.857 11.667A1 1 0 0 0 1.205 15h13.59a1 1 0 0 0 .862-1.843L8.86 1.49A1 1 0 0 0 8 1z"/>
                    <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995z"/>
                  </svg>
                </div>
                <h1 class="fw-bold mb-3 text-gradient">Project Not Found</h1>
                <p class="text-secondary mb-4">
                  We couldn't locate the project you requested. It may have been archived or removed.
                </p>
                <div>
                  <a href={`${baseUrl}projects`} class="btn btn-primary px-4 py-2 rounded-pill shadow">
                    Browse All Projects
                  </a>
                </div>
              </div>
            </div>
          ) : (
            /* Full Single-Column Project Case Presentation */
            <article class="project-showcase">
              
              <!-- 1. Header & Title -->
              <div class="project-headline mb-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2 font-monospace small text-muted">
                  <span>SELECTED WORK</span>
                  <span>&bull;</span>
                  <span>{techCount} TECHNOLOGIES</span>
                  {images.length > 0 && (
                    <>
                      <span>&bull;</span>
                      <span>{images.length} SCREENSHOT{images.length > 1 ? 'S' : ''}</span>
                    </>
                  )}
                </div>

                <h1 class="display-5 fw-bold text-gradient mb-2 text-break tracking-tight">
                  {project.title}
                </h1>

                {associatedExperiences.length > 0 && (
                  <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                    <span class="text-secondary small font-monospace">ENGINEERED AT:</span>
                    {associatedExperiences.map((exp: any) => (
                      <span class="badge bg-dark border border-secondary text-accent font-monospace px-3 py-1 rounded-pill small shadow-sm">
                        {exp.company} &bull; {exp.role}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <!-- 2. Full-Width Media Viewer (App Window) -->
              <div class="card detail-glass-card rounded-4 overflow-hidden shadow-2xl project-window-frame mb-3">
                
                <!-- Window Title Bar -->
                <div class="window-titlebar px-3 py-2 d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center gap-2">
                    <span class="window-dot dot-red"></span>
                    <span class="window-dot dot-yellow"></span>
                    <span class="window-dot dot-green"></span>
                  </div>
                  <span class="window-title font-monospace text-muted small text-truncate">
                    {project.title.toLowerCase().replace(/\s+/g, '-')}-preview.app
                  </span>
                </div>

                <!-- Window Inner Media Surface -->
                <div class="project-viewport-canvas position-relative">
                  {images.length > 0 ? (
                    <div id="projectDetailCarousel" class="carousel slide carousel-fade w-100 h-100" data-bs-ride="carousel" data-bs-interval="6500">
                      
                      <div class="carousel-inner h-100">
                        {images.map((imgPath: string, idx: number) => (
                          <div class={`carousel-item w-100 h-100 ${idx === 0 ? 'active' : ''}`}>
                            <div class="h-100 w-100 d-flex align-items-center justify-content-center p-2 p-md-3">
                              <img 
                                src={imgPath} 
                                class="d-block w-100 h-100 object-fit-contain rounded-2 carousel-zoom-img" 
                                alt={`${project.title} screenshot ${idx + 1}`}
                                loading={idx === 0 ? 'eager' : 'lazy'} 
                                role="button"
                                title="Click to enlarge"
                              />
                            </div>
                          </div>
                        ))}
                      </div>

                      {images.length > 1 && (
                        <>
                          <button class="carousel-control-prev inner-control-btn" type="button" data-bs-target="#projectDetailCarousel" data-bs-slide="prev" aria-label="Previous screenshot">
                            <span class="carousel-control-prev-icon rounded-circle p-2 shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                          </button>
                          <button class="carousel-control-next inner-control-btn" type="button" data-bs-target="#projectDetailCarousel" data-bs-slide="next" aria-label="Next screenshot">
                            <span class="carousel-control-next-icon rounded-circle p-2 shadow" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                          </button>
                        </>
                      )}
                    </div>
                  ) : (
                    <NoImagePlaceholder title={project.title} size="lg" />
                  )}
                </div>

              </div>

              <!-- Thumbnail Ribbon (if > 1 image) -->
              {images.length > 1 && (
                <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
                  {images.map((img: string, idx: number) => (
                    <button 
                      type="button" 
                      data-bs-target="#projectDetailCarousel" 
                      data-bs-slide-to={idx} 
                      class={`btn p-1 border rounded-3 overflow-hidden thumbnail-nav-btn ${idx === 0 ? 'active-thumb' : ''}`}
                      aria-label={`Slide ${idx + 1}`}
                    >
                      <img src={img} alt={`Thumbnail ${idx + 1}`} class="d-block object-fit-cover rounded-2" style="width: 72px; height: 46px;" />
                    </button>
                  ))}
                </div>
              )}

              <!-- 3. Half-and-Half Row: Tech Stack (Left) & Action Buttons (Right) -->
              <div class="row g-3 g-md-4 mb-4 align-items-stretch">
                
                <!-- Left Half: Technologies Deployed -->
                <div class="col-12 col-md-6 d-flex">
                  <div class="card detail-glass-card p-4 rounded-4 shadow-lg w-100 d-flex flex-column justify-content-center">
                    <div class="font-monospace text-muted small mb-3 tracking-wider">TECHNOLOGIES DEPLOYED</div>
                    <TechBadgeList techStack={project.tech_stack} showLabel={false} boxSize={42} iconSize={22} />
                  </div>
                </div>

                <!-- Right Half: Action Buttons -->
                <div class="col-12 col-md-6 d-flex">
                  <div class="card detail-glass-card p-4 rounded-4 shadow-lg w-100 d-flex flex-column justify-content-center">
                    <div class="font-monospace text-muted small mb-3 tracking-wider">DEPLOYMENT & REPO</div>
                    
                    <div class="d-flex flex-column flex-sm-row gap-2">
                      {project.live_url ? (
                        <a 
                          href={project.live_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="btn btn-primary flex-fill d-inline-flex align-items-center justify-content-center gap-2 py-2 px-3 shadow"
                        >
                          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                          <span class="fw-semibold">Live Site</span>
                        </a>
                      ) : (
                        <button disabled class="btn btn-outline-secondary opacity-50 flex-fill py-2 font-monospace small">
                          Offline Build
                        </button>
                      )}

                      {project.github_url && (
                        <a 
                          href={project.github_url} 
                          target="_blank" 
                          rel="noopener noreferrer" 
                          class="btn btn-outline-secondary flex-fill d-inline-flex align-items-center justify-content-center gap-2 py-2 px-3 custom-github-btn"
                        >
                          <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                          </svg>
                          <span>Repository</span>
                        </a>
                      )}
                    </div>
                  </div>
                </div>

              </div>

              <!-- 4. Full-Width Executive Summary Card -->
              {summaryPoints.length > 0 && (
                <div class="card detail-glass-card p-4 p-md-5 rounded-4 shadow-lg mb-4">
                  <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="text-accent fs-5">&bull;</span>
                    <h2 class="fw-bold text-light mb-0 fs-4">Project Overview</h2>
                  </div>

                  {summaryPoints.length > 1 ? (
                    <ul class="bullet-list ps-3 mb-0">
                      {summaryPoints.map((point: string) => (
                        <li class="mb-2">{point}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="lead fs-6 mb-0">
                      {summaryPoints[0]}
                    </p>
                  )}
                </div>
              )}

              <!-- 5. Full-Width Deep Architecture & Case Notes (Markdown Rendered) -->
              {parsedContentHtml && (
                <div class="card detail-glass-card p-4 p-md-5 rounded-4 shadow-lg mb-4">
                  <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="text-accent fs-5">&#9881;</span>
                    <h2 class="fw-bold text-light mb-0 fs-4">Architecture & Engineering Notes</h2>
                  </div>

                  <div class="markdown-content text-light line-relaxed" set:html={parsedContentHtml} />
                </div>
              )}

              <!-- 6. Next & Previous Project Navigation Footer -->
              {(prevProject || nextProject) && (
                <nav class="project-pagination-row row g-3 mt-2" aria-label="Project Navigation">
                  {prevProject && (
                    <div class="col-12 col-md-6">
                      <a 
                        href={`${baseUrl}projects/${prevProject.slug || prevProject.id}`} 
                        class="card detail-glass-card p-3 p-md-4 rounded-4 text-decoration-none project-nav-card h-100 d-flex flex-column justify-content-between"
                      >
                        <div class="d-flex align-items-center gap-2 text-muted font-monospace small mb-2">
                          <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                          </svg>
                          <span>PREVIOUS PROJECT</span>
                        </div>
                        <h4 class="fw-bold text-light mb-1 fs-5 project-nav-title">{prevProject.title}</h4>
                        <p class="text-secondary small mb-0 text-truncate">{prevProject.summary || 'View showcase'}</p>
                      </a>
                    </div>
                  )}

                  {nextProject && (
                    <div class="col-12 col-md-6 ms-auto">
                      <a 
                        href={`${baseUrl}projects/${nextProject.slug || nextProject.id}`} 
                        class="card detail-glass-card p-3 p-md-4 rounded-4 text-decoration-none project-nav-card h-100 d-flex flex-column justify-content-between text-md-end"
                      >
                        <div class="d-flex align-items-center justify-content-md-end gap-2 text-muted font-monospace small mb-2">
                          <span>NEXT PROJECT</span>
                          <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z"/>
                          </svg>
                        </div>
                        <h4 class="fw-bold text-light mb-1 fs-5 project-nav-title">{nextProject.title}</h4>
                        <p class="text-secondary small mb-0 text-truncate">{nextProject.summary || 'View showcase'}</p>
                      </a>
                    </div>
                  )}
                </nav>
              )}

            </article>
          )}

          <!-- Image Lightbox Modal -->
          <div id="imageLightboxModal" class="lightbox-modal" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
            <div class="lightbox-backdrop"></div>
            <div class="lightbox-content">
              <button type="button" class="lightbox-close-btn" aria-label="Close fullscreen preview">&times;</button>
              <img id="lightboxImage" src="" alt="Expanded preview" class="lightbox-img shadow-2xl" />
              <div id="lightboxCaption" class="lightbox-caption font-monospace small text-center text-muted mt-2"></div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    background-color: var(--body-bg) !important;
  }

  .project-detail-wrapper {
    min-height: calc(100vh - 80px);
    background-color: transparent;
  }

  .single-column-container {
    max-width: 980px;
  }

  /* Ambient Fluid Glow Accents */
  .ambient-glow {
    position: absolute;
    border-radius: var(--radius-circle);
    pointer-events: none;
    filter: blur(130px);
    opacity: 0.1;
    z-index: 1;
  }
  .ambient-glow-1 {
    top: 5%;
    left: 5%;
    width: 500px;
    height: 500px;
    background: var(--color-secondary);
  }
  .ambient-glow-2 {
    bottom: 10%;
    right: 5%;
    width: 500px;
    height: 500px;
    background: var(--color-primary);
  }

  /* Unified Glassmorphism Cards */
  .detail-glass-card {
    background-color: rgba(var(--card-bg-rgb), 0.62) !important;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--projects-card-border, var(--card-border-color)) !important;
    color: var(--body-color);
  }

  .project-detail-wrapper .border-secondary {
    border-color: var(--card-border-color) !important;
  }

  .featured-badge-banner {
    background-color: rgba(var(--color-warning-rgb), 0.12);
    color: var(--color-warning);
    border: 1px solid rgba(var(--color-warning-rgb), 0.3);
  }

  .nav-back-link {
    background-color: rgba(var(--card-bg-rgb), 0.7);
    border-color: var(--card-border-color);
    transition: all 0.2s ease;
  }
  .nav-back-link:hover {
    transform: translateX(-3px);
    border-color: var(--color-secondary) !important;
    background-color: var(--card-bg);
  }

  /* Window Box */
  .window-titlebar {
    background-color: rgba(var(--overlay-dark-rgb), 0.85);
    border-bottom: 1px solid var(--card-border-color);
  }

  .window-dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-circle);
    display: inline-block;
  }
  .dot-red { background: var(--color-danger); }
  .dot-yellow { background: var(--color-warning); }
  .dot-green { background: var(--color-success); }

  .project-viewport-canvas {
    width: 100%;
    min-height: 440px;
    height: 520px;
    aspect-ratio: 16 / 10;
    background-color: var(--body-bg);
  }

  .inner-control-btn {
    z-index: 10 !important;
    width: 48px;
    height: 100%;
    opacity: 0.75;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .inner-control-btn:hover {
    opacity: 1;
    transform: scale(1.06);
  }
  .inner-control-btn .carousel-control-prev-icon,
  .inner-control-btn .carousel-control-next-icon {
    background-color: rgba(var(--card-bg-rgb), 0.85);
    border: 1px solid var(--card-border-color);
  }

  /* Thumbnail buttons */
  .thumbnail-nav-btn {
    background: transparent;
    border: 2px solid var(--card-border-color) !important;
    opacity: 0.55;
    cursor: pointer;
    padding: 2px !important;
    transition: all 0.2s ease;
  }
  .thumbnail-nav-btn:hover {
    opacity: 0.9;
    border-color: rgba(var(--color-primary-rgb), 0.5) !important;
    transform: translateY(-2px);
  }
  .thumbnail-nav-btn.active-thumb {
    opacity: 1 !important;
    border-color: var(--color-primary) !important;
    box-shadow: 0 0 12px rgba(var(--color-primary-rgb), 0.5);
    transform: translateY(-2px) scale(1.04);
  }

  /* Bullet Lists & Prose */
  .bullet-list {
    line-height: 1.7;
    font-size: 0.96rem;
    color: var(--body-color);
  }
  .notes-list {
    color: var(--color-text-muted-light) !important;
  }
  .line-relaxed {
    line-height: 1.7;
    font-size: 0.96rem;
  }

  /* GitHub Action Button */
  .custom-github-btn {
    background-color: rgba(var(--card-bg-rgb), 0.6);
    border-color: var(--border-glass-subtle);
    color: var(--body-color);
    transition: all 0.2s ease-in-out;
  }
  .custom-github-btn:hover {
    background-color: rgba(var(--color-secondary-rgb), 0.12);
    border-color: var(--color-secondary);
    color: var(--color-secondary);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(var(--color-secondary-rgb), 0.2) !important;
  }

  @media (max-width: 768px) {
    .project-viewport-canvas {
      min-height: 240px;
      height: 300px;
      aspect-ratio: 16 / 10;
    }

    .thumbnail-nav-btn {
      width: 58px !important;
      height: 42px !important;
    }

    .project-headline h1 {
      font-size: 2rem !important;
    }
  }

  /* Markdown Rendered Content Styling */
  .markdown-content {
    line-height: 1.75;
    font-size: 0.98rem;
    color: var(--body-color);
  }

  .markdown-content h1,
  .markdown-content h2,
  .markdown-content h3,
  .markdown-content h4 {
    color: var(--body-color);
    font-weight: 700;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .markdown-content h1 { font-size: 1.6rem; border-bottom: 1px solid var(--card-border-color); padding-bottom: 0.4rem; }
  .markdown-content h2 { font-size: 1.35rem; border-bottom: 1px solid var(--card-border-color); padding-bottom: 0.3rem; }
  .markdown-content h3 { font-size: 1.15rem; color: var(--color-secondary); }
  .markdown-content h4 { font-size: 1rem; color: var(--color-text-muted-mid); }

  .markdown-content p {
    margin-bottom: 1rem;
    color: var(--color-text-muted-light);
  }

  .markdown-content ul,
  .markdown-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted-light);
  }

  .markdown-content li {
    margin-bottom: 0.35rem;
  }

  .markdown-content li::marker {
    color: var(--color-secondary);
  }

  .markdown-content blockquote {
    border-left: 3px solid var(--color-secondary);
    padding: 0.6rem 1rem;
    margin: 1.2rem 0;
    background: rgba(var(--color-secondary-rgb), 0.08);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-text-muted-light);
    font-style: italic;
  }

  .markdown-content code {
    font-family: var(--bs-font-monospace, monospace);
    font-size: 0.88em;
    background: rgba(var(--body-bg-rgb), 0.75);
    color: var(--color-primary);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    border: 1px solid rgba(var(--color-primary-rgb), 0.25);
  }

  .markdown-content pre {
    background: rgba(var(--body-bg-rgb), 0.92);
    border: 1px solid var(--card-border-color);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin: 1.2rem 0;
    overflow-x: auto;
  }

  .markdown-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--body-color);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .markdown-content table {
    width: 100%;
    margin: 1.2rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .markdown-content th,
  .markdown-content td {
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--card-border-color);
  }

  .markdown-content th {
    background: rgba(var(--body-bg-rgb), 0.75);
    color: var(--color-secondary);
    font-weight: 600;
  }

  .markdown-content a {
    color: var(--color-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .markdown-content a:hover {
    color: var(--color-primary);
  }

  .markdown-content hr {
    border-color: var(--card-border-color);
    opacity: 0.5;
    margin: 2rem 0;
  }

  /* GitHub Alert Cards in Markdown */
  .gfm-alert {
    background: rgba(var(--body-bg-rgb), 0.7);
    border-left: 4px solid var(--color-secondary);
    border-top: 1px solid var(--border-glass-card);
    border-right: 1px solid var(--border-glass-card);
    border-bottom: 1px solid var(--border-glass-card);
  }
  .gfm-alert-note {
