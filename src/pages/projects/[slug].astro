  /* Code Block Enhancements & Copy Button */
  .code-block-wrapper {
    position: relative;
    margin: 1.4rem 0;
  }
  .code-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(var(--card-bg-rgb), 0.85);
    border: 1px solid var(--card-border-color);
    color: var(--color-text-muted-mid);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--bs-font-monospace, monospace);
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 5;
  }
  .code-copy-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: var(--card-bg);
  }
  .code-copy-btn.copied {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  /* Next & Previous Project Navigation Footer */
  .project-nav-card {
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--border-glass-card) !important;
  }
  .project-nav-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-secondary) !important;
    box-shadow: 0 10px 24px rgba(var(--color-secondary-rgb), 0.15) !important;
  }
  .project-nav-card:hover .project-nav-title {
