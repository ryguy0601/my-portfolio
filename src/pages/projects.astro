---
// src/pages/projects.astro

import { createClient } from '@supabase/supabase-js';
import Layout from '../layouts/Layout.astro';
import '../styles/index.scss';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

let allProjects: any[] = [];
let dbError = false;

try {
  const { data, error } = await supabase
    .from('projects')
    .select('*')
    .order('id', { ascending: false });

  if (error) {
    console.error('Supabase error fetching projects:', error);
    dbError = true;
  } else {
    allProjects = data || [];
  }
} catch (err) {
  console.error('Unexpected error connecting to Supabase:', err);
  dbError = true;
}

// Helper map to match technology names to their corresponding Simple Icons slug
const techIconMap: Record<string, string> = {
  'c#': 'csharp',
  'csharp': 'csharp',
  'dotnet': 'dotnet',
  '.net': 'dotnet',
  'asp.net': 'dotnet',
  'blazor': 'blazor',
  'php': 'php',
  'mysql': 'mysql',
  'javascript': 'javascript',
  'js': 'javascript',
  'typescript': 'typescript',
  'ts': 'typescript',
  'html': 'html5',
  'html5': 'html5',
  'css': 'css3',
  'css3': 'css3',
  'bootstrap': 'bootstrap',
  'tailwind': 'tailwindcss',
  'tailwindcss': 'tailwindcss',
  'python': 'python',
  'supabase': 'supabase',
  'react': 'react',
  'astro': 'astro',
  'git': 'git',
  'github': 'github',
  'docker': 'docker',
  'linux': 'linux'
};

function getTechInfo(techName: string) {
  const clean = techName.trim().toLowerCase();
  const slug = techIconMap[clean];
  
  if (!slug) {
    return {
      name: techName.trim(),
      hasIcon: false,
      iconUrl: ''
    };
  }

  return {
    name: techName.trim(),
    hasIcon: true,
    iconUrl: `https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/${slug}.svg`
  };
}
---

<Layout title="Projects — Ryan Cuccurullo">

  <main class="projects-page">

    <!-- =========================================================
         INTRO SLIDE
    ========================================================== -->
    <section class="project-slide intro-slide">
      <div class="intro-background"></div>

      <div class="container position-relative z-2 px-3 px-md-4">
        <div class="row justify-content-center">
          <div class="col-12 col-lg-9 col-xl-8 text-center">

            <div class="intro-eyebrow mb-3 mb-md-4">
              <span class="eyebrow-line"></span>
              <span class="font-monospace">SELECTED WORK</span>
              <span class="eyebrow-line"></span>
            </div>

            <h1 class="fw-bold mb-3 mb-md-4 intro-main-title">
              Things I've
              <span class="text-gradient">Built.</span>
            </h1>

            <p class="lead text-secondary mx-auto intro-description mb-4 mb-md-5">
              A collection of applications, systems, and experiments I've
              designed and developed across different technologies.
            </p>

            <div class="d-flex flex-wrap justify-content-center align-items-center gap-3">

              <a href="/" class="btn btn-outline-secondary px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i>
                Back Home
              </a>

              {allProjects.length > 0 && (
                <div class="project-count font-monospace">
                  <span>{allProjects.length}</span>
                  {allProjects.length === 1 ? ' project' : ' projects'}
                </div>
              )}

            </div>

            <div class="scroll-hint mt-4 mt-md-5">
              <div class="scroll-hint-line"></div>
              <span class="font-monospace text-secondary">
                SCROLL TO EXPLORE
              </span>
              <i class="bi bi-chevron-down"></i>
            </div>

          </div>
        </div>
      </div>
    </section>


    <!-- =========================================================
         PROJECT SLIDES
    ========================================================== -->
    {dbError ? (
      <section class="project-slide empty-slide">
        <div class="container px-3">
          <div class="row justify-content-center">
            <div class="col-12 col-md-7 col-lg-5">
              <div class="empty-card text-center p-4 p-md-5">
                <div class="empty-icon mb-4">
                  <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h2 class="h3 fw-bold mb-3">Connection Error</h2>
                <p class="text-secondary mb-4">
                  Unable to retrieve projects from the database at the moment.
                </p>
                <a href="/admin" class="btn btn-primary">
                  Open Admin Dashboard
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : allProjects.length > 0 ? (

      allProjects.map((project, index) => {

        const images =
          project.image_filenames && project.image_filenames.length > 0
            ? project.image_filenames
            : project.image_url
              ? [project.image_url]
              : [];

        const carouselId = `project-carousel-${project.id}`;
        const projectNumber = String(index + 1).padStart(2, '0');
        const totalProjects = String(allProjects.length).padStart(2, '0');

        const techList = project.tech_stack
          ? project.tech_stack.split(',').map((t: string) => t.trim()).filter(Boolean)
          : [];

        return (
          <section
            class="project-slide project-section"
            aria-labelledby={`project-title-${project.id}`}
          >

            <!-- Background -->
            <div class="project-background">

              {images.length > 0 ? (

                <div
                  id={carouselId}
                  class="carousel slide carousel-fade project-carousel"
                  data-bs-ride="carousel"
                  data-bs-interval="5500"
                  data-bs-pause="hover"
                >

                  <div class="carousel-inner h-100">

                    {images.map((imgPath: string, imgIdx: number) => (

                      <div
                        class:list={[
                          'carousel-item',
                          'h-100',
                          { active: imgIdx === 0 }
                        ]}
                      >
                        <img
                          src={imgPath}
                          class="project-background-image"
                          alt={`${project.title} screenshot ${imgIdx + 1}`}
                          loading={imgIdx === 0 ? 'eager' : 'lazy'}
                        />
                      </div>

                    ))}

                  </div>

                  {images.length > 1 && (
                    <div class="project-carousel-controls">

                      <button
                        class="carousel-control-prev project-carousel-button"
                        type="button"
                        data-bs-target={`#${carouselId}`}
                        data-bs-slide="prev"
                        aria-label="Previous screenshot"
                      >
                        <span class="carousel-arrow">
                          <i class="bi bi-arrow-left"></i>
                        </span>
                      </button>

                      <button
                        class="carousel-control-next project-carousel-button"
                        type="button"
                        data-bs-target={`#${carouselId}`}
                        data-bs-slide="next"
                        aria-label="Next screenshot"
                      >
                        <span class="carousel-arrow">
                          <i class="bi bi-arrow-right"></i>
                        </span>
                      </button>

                    </div>
                  )}

                </div>

              ) : (

                <div class="project-background-empty">
                  <i class="bi bi-code-slash"></i>
                  <span>No project preview available</span>
                </div>

              )}

              <!-- Image treatment -->
              <div class="project-vignette"></div>
              <div class="project-gradient-transparent"></div>

            </div>


            <!-- Project Content -->
            <div class="container position-relative z-3 h-100 px-3 px-md-4">

              <div class="row align-items-center justify-content-center justify-content-lg-start h-100 py-5">

                <div class="col-12 col-lg-9 col-xl-7">

                  <article class="project-card project-glass-card mx-auto mx-lg-0">

                    <!-- Top metadata -->
                    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 mb-md-4">

                      <div class="d-flex align-items-center gap-2">

                        <span class="project-number font-monospace">
                          {projectNumber}
                        </span>

                        <span class="project-divider"></span>

                        <span class="project-total font-monospace">
                          {totalProjects}
                        </span>

                      </div>

                      {project.featured && (
                        <span class="featured-badge">
                          <i class="bi bi-star-fill me-1"></i>
                          Featured
                        </span>
                      )}

                    </div>


                    <!-- Title with Gradient Text -->
                    <h2
                      id={`project-title-${project.id}`}
                      class="fw-bold project-title mb-3 text-gradient"
                    >
                      {project.title}
                    </h2>


                    <!-- Description -->
                    {project.summary && (
                      <p class="project-summary text-secondary mb-3 mb-md-4">
                        {project.summary}
                      </p>
                    )}


                    <!-- Technology Boxes / Fallback Text Badges -->
                    {techList.length > 0 && (
                      <div class="mb-3 mb-md-4">
                        <div class="project-label font-monospace mb-2">
                          TECHNOLOGIES
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                          {techList.map((tech: string) => {
                            const techInfo = getTechInfo(tech);
                            return techInfo.hasIcon ? (
                              <div
                                class="tech-box d-flex align-items-center justify-content-center p-2 rounded border border-secondary border-opacity-25 bg-dark bg-opacity-50"
                                title={techInfo.name}
                                style="width: 42px; height: 42px;"
                              >
                                <img
                                  src={techInfo.iconUrl}
                                  alt={techInfo.name}
                                  class="tech-icon"
                                  style="width: 22px; height: 22px; filter: invert(1) brightness(1.2);"
                                  loading="lazy"
                                />
                              </div>
                            ) : (
                              <div
                                class="tech-text-badge d-flex align-items-center px-3 py-2 rounded border border-accent border-opacity-50 bg-dark bg-opacity-75 font-monospace small text-accent"
                              >
                                {techInfo.name}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    )}


                    <!-- Actions (GitHub Repo & Live Link) -->
                    <div class="d-flex flex-wrap align-items-center gap-3">

                      {project.github_url && (
                        <a
                          href={project.github_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn btn-light project-action d-inline-flex align-items-center"
                        >
                          <i class="bi bi-github me-2"></i>
                          View Repository
                          <i class="bi bi-arrow-up-right ms-2"></i>
                        </a>
                      )}

                      {project.live_url && (
                        <a
                          href={project.live_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn btn-primary project-action d-inline-flex align-items-center"
                        >
                          <i class="bi bi-globe me-2"></i>
                          Live Site
                          <i class="bi bi-arrow-up-right ms-2"></i>
                        </a>
                      )}

                    </div>

                  </article>

                </div>

              </div>

            </div>


            <!-- Slide footer -->
            <div class="project-slide-footer">

              {images.length > 1 && (
                <span class="font-monospace text-secondary d-none d-sm-inline">
                  {images.length} screenshots
                </span>
              )}

              <span class="slide-progress">
                {projectNumber} / {totalProjects}
              </span>

            </div>

          </section>
        );

      })

    ) : (

      <section class="project-slide empty-slide">
        <div class="container px-3">
          <div class="row justify-content-center">

            <div class="col-12 col-md-7 col-lg-5">

              <div class="empty-card text-center p-4 p-md-5">

                <div class="empty-icon mb-4">
                  <i class="bi bi-folder2-open"></i>
                </div>

                <h2 class="h3 fw-bold mb-3">
                  No Projects Yet
                </h2>

                <p class="text-secondary mb-4">
                  There aren't any projects in the database yet.
                </p>

                <a href="/admin" class="btn btn-primary">
                  Open Admin Dashboard
                </a>

              </div>

            </div>

          </div>
        </div>
      </section>

    )}

  </main>

</Layout>


<!-- =============================================================
     RESPONSIVE PAGE STYLES & FLUID UTILITIES
============================================================== -->
<style>
  .project-glass-card {
    background: rgba(12, 13, 16, 0.65) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .project-gradient-transparent {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(
      90deg,
      rgba(7, 8, 10, 0.8) 0%,
      rgba(7, 8, 10, 0.65) 40%,
      rgba(7, 8, 10, 0.3) 75%,
      rgba(7, 8, 10, 0.1) 100%
    );
  }

  .tech-box {
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .tech-box:hover {
    transform: translateY(-2px);
    border-color: var(--bs-primary) !important;
    background-color: rgba(230, 0, 115, 0.15) !important;
  }

  .tech-text-badge {
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    height: 42px;
  }

  .tech-text-badge:hover {
    transform: translateY(-2px);
    border-color: var(--bs-primary) !important;
    background-color: rgba(0, 240, 255, 0.15) !important;
  }

  /* Universal layout foundations */
  html,
  body {
    margin: 0;
    padding: 0;
    overflow-x: hidden;
    background: #0c0d0f;
  }

  .projects-page {
    width: 100%;
    height: 100svh;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior-y: contain;
    background: #0c0d0f;
  }

  .project-slide {
    position: relative;
    width: 100%;
    min-height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .intro-main-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
  }

  .project-title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .intro-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    background:
      radial-gradient(
        circle at 50% 40%,
        rgba(90, 100, 255, 0.10),
        transparent 42%
      ),
      #0c0d0f;
  }

  .intro-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.35;
    background-image:
      linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
    background-size: 45px 45px;
    mask-image: linear-gradient(to bottom, black, transparent);
  }

  .intro-eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--bs-primary);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
  }

  .eyebrow-line {
    width: 40px;
    height: 1px;
    background: currentColor;
    opacity: .5;
  }

  .intro-description {
    max-width: 650px;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.7;
  }

  .project-count {
    color: #8b8f98;
    font-size: .85rem;
  }

  .project-count span {
    color: #fff;
  }

  .scroll-hint {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-size: .65rem;
    letter-spacing: .12em;
  }

  .scroll-hint-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--bs-primary)
    );
  }

  .project-background,
  .project-carousel,
  .carousel-inner,
  .carousel-item {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project-background {
    z-index: 0;
    background: #111216;
  }

  .project-background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.8);
    transform: scale(1.015);
  }

  .project-background-empty {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #666a73;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: .75rem;
  }

  .project-background-empty i {
    font-size: 3rem;
    opacity: .4;
  }

  .project-card {
    position: relative;
    width: 100%;
    max-width: 660px;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    border-radius: 1.25rem;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.35), inset 0 1px rgba(255, 255, 255, 0.04);
  }

  .project-number,
  .project-total {
    font-size: .75rem;
    letter-spacing: .08em;
  }

  .project-number {
    color: var(--bs-primary);
  }

  .project-total {
    color: #70747e;
  }

  .project-divider {
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, .2);
  }

  .featured-badge {
    padding: .35rem .65rem;
    border: 1px solid rgba(255, 193, 7, .25);
    border-radius: 999px;
    background: rgba(255, 193, 7, .08);
    color: #ffc107;
    font-family: monospace;
    font-size: .7rem;
    letter-spacing: .04em;
  }

  .project-summary {
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    line-height: 1.7;
  }

  .project-label {
    color: #70747e;
    font-size: .65rem;
    letter-spacing: .12em;
  }

  .project-action {
    border-radius: .55rem;
    padding: .65rem 1rem;
    font-size: .85rem;
    font-weight: 600;
  }

  .project-carousel-controls {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 1rem;
  }

  .project-carousel-button {
    width: 48px;
    height: 48px;
    background: transparent;
    border: none;
    opacity: 1;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 50%;
    background: rgba(10, 11, 13, .55);
    backdrop-filter: blur(10px);
    color: white;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }

  .project-slide-footer {
    position: absolute;
    right: clamp(1rem, 3vw, 3rem);
    bottom: clamp(1rem, 3vw, 2rem);
    left: clamp(1rem, 3vw, 3rem);
    z-index: 5;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    font-size: .65rem;
    letter-spacing: .08em;
  }

  .empty-card {
    border: 1px solid rgba(255, 255, 255, .08);
    border-radius: 1rem;
    background: rgba(18, 18, 20, 0.75);
    backdrop-filter: blur(12px);
  }

  .empty-icon {
    color: #6c7079;
    font-size: 3rem;
  }

  @media (max-width: 991.98px) {
    .project-gradient-transparent {
      background: linear-gradient(
        180deg,
        rgba(7, 8, 10, 0.25) 0%,
        rgba(7, 8, 10, 0.7) 50%,
        rgba(7, 8, 10, 0.95) 100%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-page {
      scroll-behavior: auto;
    }
    .carousel-item {
      transition: none !important;
    }
  }
</style>


<!-- =============================================================
     BOOTSTRAP CAROUSEL INITIALIZATION
============================================================== -->
<script>
  import Carousel from 'bootstrap/js/dist/carousel';

  document.querySelectorAll<HTMLElement>('.project-carousel').forEach((element) => {
    Carousel.getOrCreateInstance(element, {
      interval: 5500,
      ride: 'carousel',
      pause: 'hover'
    });
  });
</script>