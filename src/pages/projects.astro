---
// src/pages/projects.astro
import Layout from '../layouts/Layout.astro';
import TechBadgeList from '../components/TechBadgeList.astro';
import NoImagePlaceholder from '../components/NoImagePlaceholder.astro';
import { supabase } from '../utils/supabase';
import { getBaseUrl, getAdminUrl } from '../utils/url';
import { getTechInfo } from '../utils/techIcons';
import { parseProjectImages } from '../utils/projects';
import { splitLines } from '../utils/text';
import { GitHubProjectsService, DEFAULT_GITHUB_CONFIG } from '../services/githubProjectsService';
import '../styles/main.scss';

const baseUrl = getBaseUrl();
const adminUrl = getAdminUrl();

let allProjects: any[] = [];
let githubConfig = DEFAULT_GITHUB_CONFIG;
let dbError = false;

try {
  const result = await GitHubProjectsService.getPortfolioProjects(supabase);
  allProjects = result.projects || [];
  githubConfig = result.config;
} catch (err) {
  console.error('Unexpected error loading projects:', err);
  dbError = true;
}

// Fetch all skills for filter chips and merge with any tech_stack items on projects
const { data: skillsData } = await supabase
  .from('skills')
  .select('name, category')
  .order('name', { ascending: true });

// Normalize skill key so "Tailwind CSS" and "TailwindCSS", "HTML" and "HTML5", "CSS" and "CSS3" don't duplicate
const normalizeSkillKey = (raw: string) => {
  const k = raw.trim().toLowerCase().replace(/\s+/g, '');
  if (k === 'html5' || k === 'html') return 'html';
  if (k === 'css3' || k === 'css') return 'css';
  if (k === 'node.js' || k === 'nodejs' || k === 'node') return 'node';
  return k;
};

const seenSkills = new Set<string>();
const mergedSkills: { name: string; iconUrl: string }[] = [];

for (const s of skillsData || []) {
  const clean = s.name?.trim();
  const key = clean ? normalizeSkillKey(clean) : '';
  if (clean && !seenSkills.has(key)) {
    seenSkills.add(key);
    mergedSkills.push({ name: clean, iconUrl: getTechInfo(clean).iconUrl });
  }
}

for (const p of allProjects || []) {
  const techs = (p.tech_stack || '').split(',').map((t: string) => t.trim()).filter(Boolean);
  for (const t of techs) {
    const key = normalizeSkillKey(t);
    if (!seenSkills.has(key)) {
      seenSkills.add(key);
      mergedSkills.push({ name: t, iconUrl: getTechInfo(t).iconUrl });
    }
  }
}

const skillList = mergedSkills;
---

<Layout hasHero={false} title="Projects — Ryan Cuccurullo">
  <div class="projects-grid-page min-vh-100 py-5">
    <div class="container py-2">

      <!-- Page Header (Left-aligned, clean engineering layout) -->
      <div class="mb-5 pb-4 border-bottom border-secondary">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <span class="font-monospace text-accent small" style="font-size: 0.78rem;">ARCHIVE // PROJECTS</span>
          {githubConfig.mode !== 'database' && (
            <a
              href={`https://github.com/${githubConfig.username}`}
              target="_blank"
              rel="noopener noreferrer"
              class="badge rounded-1 font-monospace text-decoration-none d-inline-flex align-items-center gap-1"
              style="font-size: 0.68rem; background: rgba(var(--color-primary-rgb), 0.14); color: var(--color-primary); border: 1px solid rgba(var(--color-primary-rgb), 0.35);"
            >
              <i class="bi bi-github"></i>
              <span>Synced with @{githubConfig.username} (Public Repos)</span>
            </a>
          )}
        </div>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
          <div>
            <h1 class="h2 fw-bold text-light mb-2">All Projects</h1>
            <p class="text-muted mb-0" style="max-width: 600px;">
              Production applications, developer tools, and automation pipelines. Click any technology below to filter.
            </p>
          </div>

          <!-- Search Input -->
          <div style="min-width: 280px;">
            <div class="input-group input-group-sm project-search-group">
              <span class="input-group-text project-search-addon">
                <i class="bi bi-search"></i>
              </span>
              <input 
                type="text" 
                id="projectSearchInput" 
                class="form-control project-search-input font-monospace" 
                placeholder="Filter by keyword..."
                autocomplete="off"
              />
              <button 
                class="btn btn-outline-secondary text-muted d-none" 
                type="button" 
                id="clearSearchBtn"
                title="Clear search"
              >
                <i class="bi bi-x"></i>
              </button>
            </div>
          </div>
        </div>

        <!-- Skill Filter Buttons -->
        {skillList.length > 0 && (
          <div class="d-flex flex-wrap align-items-center gap-2">
            <button 
              type="button" 
              class="btn btn-sm rounded-1 px-3 py-1 font-monospace skill-pill active" 
              data-skill=""
            >
              All ({allProjects.length})
            </button>
            {skillList.map((skill) => (
              <button 
                type="button" 
                class="btn btn-sm rounded-1 px-2 py-1 font-monospace skill-pill text-light d-inline-flex align-items-center gap-2" 
                data-skill={skill.name}
              >
                <img src={skill.iconUrl} alt={skill.name} class="skill-pill-icon" width="13" height="13" loading="lazy" />
                <span>{skill.name}</span>
              </button>
            ))}
          </div>
        )}

        <div id="filterStatus" class="small text-muted font-monospace mt-3" style="font-size: 0.78rem;">
          Showing <span id="visibleProjectsCount" class="text-light fw-semibold">{allProjects.length}</span> of {allProjects.length} projects
        </div>
      </div>

      <!-- Projects Grid -->
      {dbError ? (
        <div class="card p-4 border-danger bg-card text-light rounded-2">
          <h5 class="fw-bold text-danger">Database Connection Error</h5>
          <p class="text-muted small mb-3">Could not load projects from Supabase.</p>
          <div>
            <a href={adminUrl} class="btn btn-primary btn-sm rounded-1">Admin Dashboard</a>
          </div>
        </div>
      ) : allProjects.length > 0 ? (
        <div class="row g-4" id="projectsGrid">
          {allProjects.map((project) => {
            const images = parseProjectImages(project);
            const coverImage = images[0] || null;
            const summaryPoints = splitLines(project.summary);
            const detailUrl = `${baseUrl}projects/${project.id}`;

            return (
              <div 
                class="col-12 col-md-6 col-lg-4 project-grid-item"
                data-title={project.title.toLowerCase()}
                data-tech={(project.tech_stack || '').toLowerCase()}
                data-summary={(project.summary || '').toLowerCase()}
              >
                <article class="card h-100 bg-card border border-secondary rounded-2 overflow-hidden project-grid-card d-flex flex-column">
                  
                  <!-- Thumbnail -->
                  <a href={detailUrl} class="project-img-wrapper position-relative overflow-hidden bg-black border-bottom border-secondary d-block text-decoration-none">
                    {coverImage ? (
                      <img 
                        src={coverImage} 
                        alt={project.title} 
                        class="w-100 h-100 object-fit-cover project-img"
                        loading="lazy" 
                      />
                    ) : (
                      <NoImagePlaceholder title={project.title} size="sm" />
                    )}
                  </a>

                  <!-- Card Body -->
                  <div class="card-body p-4 d-flex flex-column flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                      <h2 class="h6 fw-bold mb-0">
                        <a href={detailUrl} class="text-light text-decoration-none project-title-hover">
                          {project.title}
                        </a>
                      </h2>
                      <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        {project.featured && (
                          <span class="font-monospace text-accent" style="font-size: 0.7rem;">
                            [featured]
                          </span>
                        )}
                        {project.is_github_live && !project.featured && (
                          <span class="font-monospace text-muted d-inline-flex align-items-center gap-1" style="font-size: 0.68rem;" title="Pulled live from public GitHub repository">
                            <i class="bi bi-github"></i>
                            <span>public</span>
                          </span>
                        )}
                      </div>
                    </div>

                    <p class="text-muted small mb-3 flex-grow-1 line-clamp-3" style="line-height: 1.55;">
                      {summaryPoints[0] || project.summary}
                    </p>

                    <!-- Tech Stack Badges -->
                    <div class="pt-2 mb-3 border-top border-secondary">
                      <TechBadgeList techStack={project.tech_stack} boxSize={28} iconSize={14} />
                    </div>

                    <!-- Footer Links -->
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary font-monospace small">
                      <a href={detailUrl} class="text-light text-decoration-none project-title-hover">
                        Read specs &rarr;
                      </a>
                      <div class="d-flex gap-3">
                        {project.live_url && (
                          <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none project-title-hover" title="Live Demo">
                            demo <i class="bi bi-arrow-up-right"></i>
                          </a>
                        )}
                        {project.github_url && (
                          <a href={project.github_url} target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none project-title-hover" title="Source Code">
                            code <i class="bi bi-github"></i>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>

                </article>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="py-5 text-muted font-monospace small">
          No projects found.
        </div>
      )}

      <!-- Empty Filter State -->
      <div id="noResultsAlert" class="py-5 d-none">
        <p class="text-muted font-monospace mb-3">No projects match the selected filter.</p>
        <button type="button" id="resetFiltersBtn" class="btn btn-outline-secondary btn-sm rounded-1 font-monospace">
          Reset filter
        </button>
      </div>

    </div>
  </div>
</Layout>

<style>
  .projects-grid-page {
    background-color: transparent;
  }

  .project-search-addon {
    background-color: var(--projects-control-bg, var(--card-bg)) !important;
    border-color: var(--card-border-color) !important;
    color: var(--color-text-muted-light) !important;
  }

  .project-search-input {
    background-color: var(--projects-control-bg, var(--card-bg)) !important;
    border-color: var(--card-border-color) !important;
    color: var(--body-color) !important;
    font-size: 0.8rem;

    &::placeholder {
      color: var(--color-text-muted-mid) !important;
      opacity: 1;
    }

    &:focus {
      background-color: var(--card-bg) !important;
      border-color: var(--color-primary) !important;
      color: var(--body-color) !important;
      box-shadow: 0 0 0 0.18rem rgba(var(--color-primary-rgb), 0.15) !important;
    }
  }

  .skill-pill {
    font-size: 0.76rem;
    border: 1px solid var(--card-border-color);
    background: var(--projects-control-bg, var(--card-bg));
    color: var(--color-text-muted-light);
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;

    &:hover {
      border-color: var(--color-secondary);
      color: var(--body-color);
    }

    &.active {
      background: var(--color-primary) !important;
      border-color: var(--color-primary) !important;
      color: var(--color-on-accent) !important;
      font-weight: 600;

      .skill-pill-icon {
        filter: brightness(0);
      }
    }
  }

  .skill-pill-icon {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .project-grid-card {
    background-color: rgba(var(--card-bg-rgb, 20, 22, 27), 0.58) !important;
    border-color: var(--projects-card-border, var(--card-border-color)) !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: border-color 0.15s ease, background-color 0.15s ease;

    &:hover {
      background-color: rgba(var(--card-bg-rgb, 20, 22, 27), 0.76) !important;
      border-color: var(--color-primary) !important;
    }
  }

  .project-img-wrapper {
    height: 200px;

    .project-img {
      opacity: 0.92;
      transition: opacity 0.2s ease;
    }

    &:hover .project-img {
      opacity: 1;
    }
  }

  .project-title-hover {
    transition: color 0.15s ease;

    &:hover {
      color: var(--color-primary) !important;
    }
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  function setupProjectsGridFilter() {
    const searchInput = document.getElementById('projectSearchInput') as HTMLInputElement;
    const clearSearchBtn = document.getElementById('clearSearchBtn');
    const skillPills = document.querySelectorAll<HTMLButtonElement>('.skill-pill');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-grid-item');
    const visibleCountEl = document.getElementById('visibleProjectsCount');
    const noResultsAlert = document.getElementById('noResultsAlert');
    const resetFiltersBtn = document.getElementById('resetFiltersBtn');

    let currentSkill = '';
    let currentSearch = '';

    function normalizeSkillName(raw: string): string {
      const k = raw.trim().toLowerCase().replace(/\s+/g, '');
      if (k === 'html5' || k === 'html') return 'html';
      if (k === 'css3' || k === 'css') return 'css';
      if (k === 'node.js' || k === 'nodejs' || k === 'node') return 'node';
      if (k === 'react.js' || k === 'reactjs' || k === 'react') return 'react';
      if (k === 'next.js' || k === 'nextjs' || k === 'next') return 'next';
      if (k === 'vue.js' || k === 'vuejs' || k === 'vue') return 'vue';
      if (k === 'c#' || k === 'csharp') return 'c#';
      if (k === '.net' || k === 'dotnet' || k === '.netcore' || k === 'dotnetcore') return '.net';
      return k;
    }

    function filterProjects() {
      let visibleCount = 0;
      const searchTerms = currentSearch.trim().toLowerCase();
      const targetSkillKey = currentSkill ? normalizeSkillName(currentSkill) : '';

      projectItems.forEach((item) => {
        const title = item.dataset.title || '';
        const tech = item.dataset.tech || '';
        const summary = item.dataset.summary || '';

        const matchesSearch = !searchTerms || 
          title.includes(searchTerms) || 
          tech.includes(searchTerms) || 
          summary.includes(searchTerms);

        const techKeys = tech
          .split(',')
          .map((t) => t.trim())
          .filter(Boolean)
          .map(normalizeSkillName);

        const matchesSkill = !targetSkillKey || techKeys.includes(targetSkillKey);

        if (matchesSearch && matchesSkill) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (visibleCountEl) {
        visibleCountEl.textContent = String(visibleCount);
      }

      if (noResultsAlert) {
        noResultsAlert.classList.toggle('d-none', visibleCount > 0);
      }

      if (clearSearchBtn) {
        clearSearchBtn.classList.toggle('d-none', !currentSearch);
      }
    }

    skillPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        skillPills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentSkill = pill.dataset.skill || '';

        const url = new URL(window.location.href);
        if (currentSkill) {
          url.searchParams.set('skill', currentSkill);
        } else {
          url.searchParams.delete('skill');
        }
        window.history.replaceState({}, '', url.toString());

        filterProjects();
      });
    });

    searchInput?.addEventListener('input', () => {
      currentSearch = searchInput.value;
      filterProjects();
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        currentSearch = '';
        filterProjects();
        searchInput.focus();
      }
    });

    resetFiltersBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentSearch = '';
      currentSkill = '';
      skillPills.forEach((p) => {
        p.classList.toggle('active', p.dataset.skill === '');
      });
      const url = new URL(window.location.href);
      url.searchParams.delete('skill');
      window.history.replaceState({}, '', url.toString());
      filterProjects();
    });

    const initialSkillParam = new URLSearchParams(window.location.search).get('skill');
    if (initialSkillParam) {
      const targetKey = normalizeSkillName(initialSkillParam);
      const matchingPill = Array.from(skillPills).find(
        (p) => p.dataset.skill && normalizeSkillName(p.dataset.skill) === targetKey
      );
      if (matchingPill) {
        skillPills.forEach((p) => p.classList.remove('active'));
        matchingPill.classList.add('active');
        currentSkill = matchingPill.dataset.skill || '';
      } else {
        currentSkill = initialSkillParam;
      }
      filterProjects();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupProjectsGridFilter);
  } else {
    setupProjectsGridFilter();
  }
</script>
