---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import TechBadgeList from '../components/TechBadgeList.astro';
import NoImagePlaceholder from '../components/NoImagePlaceholder.astro';
import { supabase } from '../utils/supabase';
import { getBaseUrl } from '../utils/url';
import { getTechInfo } from '../utils/techIcons';
import { parseProjectImages } from '../utils/projects';
import { splitLines } from '../utils/text';
import { GitHubProjectsService } from '../services/githubProjectsService';
import '../styles/index.scss';

// Fetch all projects according to the active GitHub/Database mode configured in Admin
const { projects: allProjectsData } = await GitHubProjectsService.getPortfolioProjects(supabase);

const featuredCandidates = (allProjectsData || []).filter((p: any) => p.featured);
const featuredProjects = featuredCandidates.length > 0 ? featuredCandidates : (allProjectsData || []).slice(0, 6);

const dbProjects = (allProjectsData || []).slice(0, 5);
const totalProjectsCount = (allProjectsData || []).length;

// Fetch all skills for the ticker
const { data: skillsData } = await supabase
  .from('skills')
  .select('*')
  .order('category', { ascending: true })
  .order('order_index', { ascending: true });

// Fetch work experience
const { data: experiencesData } = await supabase
  .from('work_experience')
  .select('*')
  .order('order_index', { ascending: true });

// Combine skills table with any additional tech_stack items used on projects so no skill is ever left out
const normalizeSkillKey = (raw: string) => {
  const k = raw.trim().toLowerCase().replace(/\s+/g, '');
  if (k === 'html5' || k === 'html') return 'html';
  if (k === 'css3' || k === 'css') return 'css';
  if (k === 'node.js' || k === 'nodejs' || k === 'node') return 'node';
  return k;
};

const seenSkillNames = new Set<string>();
const combinedSkillNames: string[] = [];

for (const s of skillsData || []) {
  const clean = s.name?.trim();
  const key = clean ? normalizeSkillKey(clean) : '';
  if (clean && !seenSkillNames.has(key)) {
    seenSkillNames.add(key);
    combinedSkillNames.push(clean);
  }
}

for (const p of allProjectsData || []) {
  const techs = (p.tech_stack || '').split(',').map((t: string) => t.trim()).filter(Boolean);
  for (const t of techs) {
    const key = normalizeSkillKey(t);
    if (!seenSkillNames.has(key)) {
      seenSkillNames.add(key);
      combinedSkillNames.push(t);
    }
  }
}

const allSkills = combinedSkillNames.map((name) => {
  const icon = getTechInfo(name);
  return {
    name,
    iconUrl: icon.iconUrl
  };
});

const safeProjectsJson = JSON.stringify(dbProjects || []);
const baseUrl = getBaseUrl();
---

<Layout hasHero={true} title="Ryan Cuccurullo — Software Engineer">
  <!-- Hero Section -->
  <section class="hero-section position-relative w-100 d-flex align-items-center border-bottom border-secondary" style="z-index: 1;">
    <div class="container py-5">
      <div class="row align-items-center justify-content-between g-5">
        
        <!-- Left Column: Direct Engineering Bio -->
        <div class="col-lg-6">
          <div class="d-inline-flex align-items-center gap-2 px-2 py-1 mb-3 border border-secondary rounded-1 bg-card font-monospace" style="font-size: 0.78rem; color: var(--color-text-muted-light);">
            <span class="status-dot"></span>
            <span>LONG ISLAND, NY &bull; FULL-STACK & AUTOMATION</span>
          </div>

          <h1 class="fw-bold mb-3 text-light tracking-tight" style="font-size: clamp(2.25rem, 4vw, 3.5rem); letter-spacing: -0.03em; line-height: 1.1;">
            Ryan Cuccurullo
          </h1>

          <p class="text-muted mb-4" style="font-size: 1.08rem; line-height: 1.65; max-width: 540px;">
            Software engineer building internal enterprise software, browser automation pipelines, and full-stack web applications. 
            B.S. in Computer Programming &amp; Information Systems from Farmingdale State College.
          </p>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <a href={`${baseUrl}projects`} class="btn btn-primary px-4 py-2 rounded-1 d-inline-flex align-items-center gap-2" style="font-size: 0.92rem;">
              <span>Browse Projects ({totalProjectsCount || 9})</span>
              <i class="bi bi-arrow-right"></i>
            </a>
            <a href={`${baseUrl}experience`} class="btn btn-outline-secondary px-3 py-2 rounded-1 text-light" style="font-size: 0.92rem;">
              Work Experience
            </a>
            <a href={`${baseUrl}resume`} class="btn btn-outline-secondary px-3 py-2 rounded-1 text-light" style="font-size: 0.92rem;">
              Resume
            </a>
          </div>

          <!-- Core Focus Areas -->
          <div class="row g-2 pt-3 border-top border-secondary" style="max-width: 520px;">
            <div class="col-4">
              <div class="font-monospace small text-muted" style="font-size: 0.72rem;">STACK</div>
              <div class="fw-semibold text-light small">.NET / Python / TS</div>
            </div>
            <div class="col-4 border-start border-secondary ps-3">
              <div class="font-monospace small text-muted" style="font-size: 0.72rem;">CURRENT</div>
              <div class="fw-semibold text-light small">American Regent</div>
            </div>
            <div class="col-4 border-start border-secondary ps-3">
              <div class="font-monospace small text-muted" style="font-size: 0.72rem;">EDUCATION</div>
              <div class="fw-semibold text-light small">B.S. CPIS (SUNY)</div>
            </div>
          </div>
        </div>

        <!-- Right Column: Terminal Workbench -->
        <div class="col-lg-6 d-flex justify-content-center justify-content-lg-end">
          <div class="card terminal-card border border-secondary rounded-2 w-100 shadow-sm" style="max-width: 560px; background: rgba(var(--body-bg-rgb), 0.68) !important; backdrop-filter: blur(4px);">
            <div class="card-header bg-transparent border-bottom border-secondary d-flex align-items-center justify-content-between py-2 px-3">
              <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background: var(--color-danger);"></span>
                <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background: var(--color-warning);"></span>
                <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background: var(--color-success);"></span>
                <small class="text-muted ms-2 font-monospace" style="font-size: 0.78rem;">~/work/projects.ts</small>
              </div>
              <span class="font-monospace text-muted" style="font-size: 0.72rem;">zsh</span>
            </div>
            <div class="card-body terminal-body font-monospace text-muted p-3">
              <pre 
                class="mb-0 m-0 p-0 terminal-pre" 
                id="terminal-container"
                data-projects={safeProjectsJson}
                style="background: transparent; font-family: inherit; white-space: pre-wrap; word-break: break-word; overflow-x: hidden;"
              ><span id="terminal-text"></span><span class="terminal-cursor">_</span></pre>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Skills Ticker Section (Click any skill to filter projects) -->
  <section class="skills-ticker-section py-2 border-bottom border-secondary overflow-hidden position-relative" style="z-index: 2; background: rgba(var(--card-bg-rgb), 0.58); backdrop-filter: blur(4px);">
    <div class="ticker-wrapper d-flex align-items-center">
      <div class="px-3 py-1 border-end border-secondary font-monospace small text-muted flex-shrink-0 d-none d-sm-flex align-items-center gap-2" style="font-size: 0.75rem;">
        <span>FILTER BY TECH</span>
        <span>&rarr;</span>
      </div>

      <div class="ticker-track-container overflow-hidden position-relative flex-grow-1">
        <div class="ticker-track d-flex align-items-center gap-2 py-1">
          {[...allSkills, ...allSkills].map((skill) => (
            <button 
              type="button" 
              class="ticker-item d-inline-flex align-items-center gap-2 px-3 py-1 rounded-1 bg-body border border-secondary flex-shrink-0 text-start text-decoration-none"
              data-skill-name={skill.name}
              title={`View projects built with ${skill.name}`}
            >
              {skill.iconUrl ? (
                <img src={skill.iconUrl} alt={skill.name} class="ticker-icon" width="14" height="14" loading="lazy" />
              ) : (
                <i class="bi bi-terminal text-muted" style="font-size: 0.8rem;"></i>
              )}
              <span class="ticker-name font-monospace text-light" style="font-size: 0.8rem;">{skill.name}</span>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Projects Section (Full-Bleed Image Carousel with Left-to-Right Gradient Fade) -->
  <section class="py-5 border-bottom border-secondary position-relative" style="z-index: 1;">
    <div class="container py-3">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
          <div class="font-monospace text-accent small mb-1" style="font-size: 0.78rem;">01 // SELECTED WORK</div>
          <h2 class="h3 fw-bold text-light mb-0">Featured Projects</h2>
        </div>

        <div class="d-flex align-items-center gap-3">
          {featuredProjects && featuredProjects.length > 1 && (
            <div class="d-flex align-items-center gap-2">
              <button
                class="btn btn-sm carousel-nav-btn d-inline-flex align-items-center justify-content-center"
                type="button"
                data-bs-target="#featuredProjectsCarousel"
                data-bs-slide="prev"
                aria-label="Previous project"
              >
                <i class="bi bi-chevron-left"></i>
              </button>
              <button
                class="btn btn-sm carousel-nav-btn d-inline-flex align-items-center justify-content-center"
                type="button"
                data-bs-target="#featuredProjectsCarousel"
                data-bs-slide="next"
                aria-label="Next project"
              >
                <i class="bi bi-chevron-right"></i>
              </button>
            </div>
          )}

          <a href={`${baseUrl}projects`} class="font-monospace text-light text-decoration-none small d-inline-flex align-items-center gap-2 hover-underline">
            <span>View all {totalProjectsCount || 9} projects</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      {featuredProjects && featuredProjects.length > 0 ? (
        <div
          id="featuredProjectsCarousel"
          class="carousel slide carousel-fade featured-showcase-carousel rounded-2 overflow-hidden border border-secondary shadow-lg"
          data-bs-ride="carousel"
          data-bs-interval="6500"
        >
          <!-- Slide Indicators -->
          {featuredProjects.length > 1 && (
            <div class="carousel-indicators featured-carousel-indicators mb-3">
              {featuredProjects.map((_: any, idx: number) => (
                <button
                  type="button"
                  data-bs-target="#featuredProjectsCarousel"
                  data-bs-slide-to={idx}
                  class={idx === 0 ? "active" : ""}
                  aria-current={idx === 0 ? "true" : undefined}
                  aria-label={`Slide ${idx + 1}`}
                ></button>
              ))}
            </div>
          )}

          <div class="carousel-inner">
            {featuredProjects.map((project: any, idx: number) => {
              const images = parseProjectImages(project);
              const coverImage = images[0] || null;
              const summaryPoints = splitLines(project.summary);
              const detailUrl = `${baseUrl}projects/${project.id}`;

              return (
                <div class={`carousel-item ${idx === 0 ? "active" : ""}`}>
                  <article
                    class="featured-slide-frame position-relative w-100 overflow-hidden d-flex align-items-center"
                    data-project-slide
                    data-images={JSON.stringify(images)}
                  >
                    
                    <!-- Full-Section Background Project Image -->
                    <div class="featured-slide-bg position-absolute top-0 start-0 w-100 h-100">
                      {coverImage ? (
                        <img
                          src={coverImage}
                          alt={project.title}
                          class="w-100 h-100 object-fit-cover featured-slide-img"
                          data-slide-main-img
                          loading={idx === 0 ? "eager" : "lazy"}
                        />
                      ) : (
                        <NoImagePlaceholder title={project.title} size="lg" />
                      )}
                    </div>

                    <!-- Multi-Photo Switcher Controls (Bottom Right over Image) -->
                    {images.length > 1 && (
                      <div class="photo-switcher-bar position-absolute bottom-0 end-0 m-3 m-md-4 px-2 py-1 rounded-1 d-flex align-items-center gap-2 font-monospace">
                        <button
                          type="button"
                          class="btn btn-sm p-0 photo-step-btn d-inline-flex align-items-center justify-content-center"
                          data-photo-prev
                          title="Previous screenshot"
                          aria-label="Previous screenshot"
                        >
                          <i class="bi bi-chevron-left"></i>
                        </button>
                        <div class="d-flex align-items-center gap-1 px-1">
                          {images.map((imgUrl: string, imgIdx: number) => (
                            <button
                              type="button"
                              class={`photo-dot-btn ${imgIdx === 0 ? "active" : ""}`}
                              data-photo-index={imgIdx}
                              data-photo-src={imgUrl}
                              title={`Screenshot ${imgIdx + 1} of ${images.length}`}
                              aria-label={`View screenshot ${imgIdx + 1}`}
                            ></button>
                          ))}
                        </div>
                        <span class="photo-counter-label text-muted px-1" data-photo-counter>
                          1/{images.length}
                        </span>
                        <button
                          type="button"
                          class="btn btn-sm p-0 photo-step-btn d-inline-flex align-items-center justify-content-center"
                          data-photo-next
                          title="Next screenshot"
                          aria-label="Next screenshot"
                        >
                          <i class="bi bi-chevron-right"></i>
                        </button>
                      </div>
                    )}

                    <!-- Left-to-Right Gradient Overlay (Compact on Left -> Rapidly Transparent Towards Picture on Right) -->
                    <div class="featured-slide-gradient position-absolute top-0 start-0 w-100 h-100 pointer-events-none"></div>

                    <!-- Narrower Left-Hand Content Panel -->
                    <div class="featured-slide-content position-relative p-4 p-md-5">
                      <div class="d-inline-flex align-items-center gap-2 font-monospace small text-accent mb-2" style="font-size: 0.74rem;">
                        <span>PROJECT 0{idx + 1} / 0{featuredProjects.length}</span>
                        {images.length > 1 && (
                          <>
                            <span>&bull;</span>
                            <span>{images.length} PHOTOS</span>
                          </>
                        )}
                      </div>

                      <h3 class="h3 fw-bold text-light mb-3 tracking-tight">
                        <a href={detailUrl} class="text-light text-decoration-none stretched-link-title">
                          {project.title}
                        </a>
                      </h3>

                      {summaryPoints.length > 1 ? (
                        <ul class="text-muted small ps-3 mb-4 d-flex flex-column gap-1" style="line-height: 1.55;">
                          {summaryPoints.slice(0, 3).map((point: string) => (
                            <li>{point}</li>
                          ))}
                        </ul>
                      ) : (
                        <p class="text-muted mb-4" style="font-size: 0.92rem; line-height: 1.6;">
                          {summaryPoints[0] || project.summary}
                        </p>
                      )}

                      <div class="mb-4">
                        <TechBadgeList techStack={project.tech_stack} boxSize={32} iconSize={17} />
                      </div>

                      <div class="d-flex flex-wrap align-items-center gap-2 pt-1">
                        <a href={detailUrl} class="btn btn-primary btn-sm px-3 py-2 rounded-1 font-monospace d-inline-flex align-items-center gap-2">
                          <span>Inspect Project</span>
                          <i class="bi bi-arrow-right"></i>
                        </a>
                        {project.live_url && (
                          <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-1 font-monospace text-light d-inline-flex align-items-center gap-2">
                            <span>Live Demo</span>
                            <i class="bi bi-box-arrow-up-right"></i>
                          </a>
                        )}
                        {project.github_url && (
                          <a href={project.github_url} target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary btn-sm px-3 py-2 rounded-1 font-monospace text-light d-inline-flex align-items-center gap-2">
                            <i class="bi bi-github"></i>
                            <span>Source</span>
                          </a>
                        )}
                      </div>
                    </div>

                  </article>
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <div class="card p-4 bg-card border border-secondary text-muted font-monospace small">
          No featured projects configured.
        </div>
      )}
    </div>
  </section>

  <!-- Work Experience Section -->
  {experiencesData && experiencesData.length > 0 && (
    <section class="py-5 border-bottom border-secondary position-relative" style="z-index: 1;">
      <div class="container py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
          <div>
            <div class="font-monospace text-accent small mb-1" style="font-size: 0.78rem;">02 // EXPERIENCE</div>
            <h2 class="h3 fw-bold text-light mb-0">Where I've Worked</h2>
          </div>
          <a href={`${baseUrl}experience`} class="font-monospace text-light text-decoration-none small d-inline-flex align-items-center gap-2 hover-underline">
            <span>Full work history</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="d-flex flex-column gap-3">
          {experiencesData.map((exp: any) => {
            const bullets = splitLines(exp.description);
            return (
              <div class="card p-4 bg-card border border-secondary rounded-2">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-1 mb-3 pb-2 border-bottom border-secondary">
                  <div>
                    <span class="fw-bold text-light">{exp.role}</span>
                    <span class="text-muted mx-2">&middot;</span>
                    <span class="font-monospace text-accent small">{exp.company}</span>
                  </div>
                  <div class="font-monospace text-muted small">
                    {exp.start_date} — {exp.end_date || 'Present'}
                  </div>
                </div>

                <ul class="text-muted small ps-3 mb-0 d-flex flex-column gap-2" style="line-height: 1.6;">
                  {bullets.map((bullet: string) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Footer / Contact -->
  <footer class="py-5 position-relative" style="z-index: 1;">
    <div class="container py-2">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4">
        <div>
          <div class="font-monospace text-light fw-semibold mb-1">Ryan Cuccurullo</div>
          <p class="text-muted small mb-0">
            Software Engineer based in Long Island, NY.
          </p>
        </div>

        <div class="d-flex flex-wrap gap-3 font-monospace small">
          <a href="mailto:ryan.cuccu@gmail.com" class="text-muted text-decoration-none hover-light">
            ryan.cuccu@gmail.com
          </a>
          <span class="text-secondary">&middot;</span>
          <a href="https://github.com/ryguy0601" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none hover-light">
            GitHub
          </a>
          <span class="text-secondary">&middot;</span>
          <a href="https://www.linkedin.com/in/ryan-cuccurullo-48b242261/" target="_blank" rel="noopener noreferrer" class="text-muted text-decoration-none hover-light">
            LinkedIn
          </a>
          <span class="text-secondary">&middot;</span>
          <a href={`${baseUrl}resume`} class="text-muted text-decoration-none hover-light">
            Resume
          </a>
        </div>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .blueprint-bg {
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .hero-section {
    min-height: 78vh;
    padding-top: 84px;
    padding-bottom: 2.5rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
    display: inline-block;
  }

  /* Ticker */
  .ticker-track-container {
    mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
  }

  .ticker-track {
    width: max-content;
    animation: tickerScroll 95s linear infinite;
  }

  .ticker-track:hover {
    animation-play-state: paused;
  }

  @keyframes tickerScroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .ticker-item {
    transition: border-color 0.15s ease, background-color 0.15s ease;
    cursor: pointer;
    outline: none;
    background-color: rgba(var(--body-bg-rgb), 0.7) !important;

    &:hover {
      border-color: var(--color-primary) !important;
      background-color: var(--tech-symbol-bg) !important;
    }
  }

  .ticker-icon {
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  /* Featured Projects Full-Bleed Carousel */
  .featured-showcase-carousel {
    background-color: rgba(var(--card-bg-rgb, 20, 22, 27), 0.65);
    border-color: var(--projects-card-border, var(--card-border-color)) !important;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .featured-slide-frame {
    min-height: 580px;
  }

  .featured-slide-bg {
    z-index: 0;
  }

  .featured-slide-img {
    object-position: right center;
    transition: transform 0.6s ease, opacity 0.2s ease;
  }

  .featured-showcase-carousel:hover .featured-slide-img {
    transform: scale(1.015);
  }

  /* Compact left-to-right gradient: covers narrow text column on the left and quickly opens up to the full image */
  .featured-slide-gradient {
    z-index: 1;
    background: linear-gradient(
      90deg,
      rgba(var(--body-bg-rgb, 12, 13, 16), 0.96) 0%,
      rgba(var(--body-bg-rgb, 12, 13, 16), 0.9) 24%,
      rgba(var(--body-bg-rgb, 12, 13, 16), 0.55) 42%,
      rgba(var(--body-bg-rgb, 12, 13, 16), 0.12) 58%,
      rgba(var(--body-bg-rgb, 12, 13, 16), 0) 72%
    );
  }

  .featured-slide-content {
    z-index: 2;
    width: 100%;
    max-width: 440px;
  }

  /* Multi-photo switcher pill on bottom-right of slide */
  .photo-switcher-bar {
    z-index: 4;
    background-color: rgba(var(--body-bg-rgb, 12, 13, 16), 0.84);
    border: 1px solid var(--card-border-color);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-size: 0.74rem;
  }

  .photo-step-btn {
    width: 24px;
    height: 24px;
    color: var(--color-text-muted-light);
    border-radius: 3px;
    transition: color 0.15s ease, background-color 0.15s ease;

    &:hover {
      color: var(--color-primary);
      background-color: rgba(var(--card-bg-rgb), 0.9);
    }
  }

  .photo-dot-btn {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: var(--color-text-muted-mid);
    opacity: 0.5;
    transition: all 0.15s ease;

    &:hover {
      opacity: 0.9;
    }

    &.active {
      width: 16px;
      border-radius: 4px;
      background-color: var(--color-primary);
      opacity: 1;
    }
  }

  .photo-counter-label {
    font-size: 0.72rem;
  }

  .carousel-nav-btn {
    width: 34px;
    height: 34px;
    border: 1px solid var(--card-border-color);
    background-color: rgba(var(--card-bg-rgb), 0.75);
    color: var(--body-color);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;

    &:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
      background-color: var(--card-bg);
    }
  }

  .featured-carousel-indicators {
    z-index: 3;
    justify-content: flex-start;
    margin-left: 3rem;
    margin-right: auto;
  }

  .featured-carousel-indicators [data-bs-target] {
    width: 24px;
    height: 3px;
    border-radius: 2px;
    background-color: var(--color-text-muted-mid);
    opacity: 0.45;
    border: none;
    transition: all 0.2s ease;
  }

  .featured-carousel-indicators .active {
    width: 36px;
    background-color: var(--color-primary);
    opacity: 1;
  }

  @media (max-width: 767.98px) {
    .featured-slide-frame {
      min-height: 440px;
    }

    .featured-slide-gradient {
      background: linear-gradient(
        90deg,
        rgba(var(--body-bg-rgb, 12, 13, 16), 0.96) 0%,
        rgba(var(--body-bg-rgb, 12, 13, 16), 0.88) 60%,
        rgba(var(--body-bg-rgb, 12, 13, 16), 0.55) 100%
      );
    }

    .featured-carousel-indicators {
      margin-left: 1.5rem;
    }
  }

  .stretched-link-title:hover {
    color: var(--color-primary) !important;
  }

  .hover-light:hover {
    color: var(--body-color) !important;
  }

  .hover-underline:hover {
    text-decoration: underline !important;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const terminal = document.getElementById("terminal-text");
    const container = document.getElementById("terminal-container");
    if (!terminal || !container) return;

    type Step = string | { delete: number };

    let liveDbProjects: { title: string; tech_stack: string; live_url?: string; github_url?: string }[] = [];
    try {
      liveDbProjects = JSON.parse(container.getAttribute("data-projects") || "[]");
    } catch (e) {
      liveDbProjects = [];
    }

    const dbProjectVariations: Step[][] = liveDbProjects.map((p) => {
      const formattedStack = p.tech_stack
        ? p.tech_stack.split(',').map((t) => `'${t.trim()}'`).join(', ')
        : "'TypeScript', 'Astro'";

      const targetLink = p.live_url?.trim() || p.github_url?.trim() || 'local';

      return [
        "export const project = {\n",
        `  name: '${p.title}',\n`,
        `  stack: [${formattedStack}],\n`,
        `  url: '${targetLink}',\n`,
        "  status: 'production'\n",
        "};"
      ];
    });

    const terminalVariations: Step[][] = dbProjectVariations.length > 0 ? dbProjectVariations : [
      [
        "export const engineer = {\n",
        "  name: 'Ryan Cuccurullo',\n",
        "  location: 'Long Island, NY',\n",
        "  stack: ['C#', '.NET', 'Python', 'TypeScript'],\n",
        "};"
      ]
    ];

    const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    function highlightCode(code: string) {
      let safe = code
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");

      safe = safe.replace(/\b(export|const|true|false)\b/g, '<span class="tok-keyword">$1</span>');
      safe = safe.replace(/(\b[a-zA-Z_$][a-zA-Z0-9_$]*)(?=\s*:\s*)/g, '<span class="tok-property">$1</span>');
      safe = safe.replace(/('[^'\n]*('|$))/g, '<span class="tok-string">$1</span>');

      return safe;
    }

    async function runTerminal() {
      let idx = 0;
      while (true) {
        const currentSteps = terminalVariations[idx % terminalVariations.length];
        idx++;

        let currentText = "";
        terminal!.innerHTML = "";
        await wait(400);

        for (let step of currentSteps) {
          if (typeof step === "string") {
            for (let char of step) {
              currentText += char;
              terminal!.innerHTML = highlightCode(currentText);
              await wait(18);
            }
          }
        }
        await wait(4000);
      }
    }
    runTerminal();

    // Clickable Skill Ticker -> Navigate to /projects?skill=...
    document.querySelectorAll<HTMLElement>('.ticker-item').forEach((item) => {
      item.addEventListener('click', () => {
        const skill = item.getAttribute('data-skill-name');
        if (!skill) return;

        const targetUrl = new URL(`${window.location.origin}/projects`);
        targetUrl.searchParams.set('skill', skill);
        window.location.href = targetUrl.toString();
      });
    });

    // Multi-Photo Switcher inside Featured Project Carousel Slides
    document.querySelectorAll<HTMLElement>('[data-project-slide]').forEach((slide) => {
      let images: string[] = [];
      try {
        images = JSON.parse(slide.getAttribute('data-images') || '[]');
      } catch {
        images = [];
      }
      if (images.length <= 1) return;

      const mainImg = slide.querySelector<HTMLImageElement>('[data-slide-main-img]');
      const prevBtn = slide.querySelector<HTMLButtonElement>('[data-photo-prev]');
      const nextBtn = slide.querySelector<HTMLButtonElement>('[data-photo-next]');
      const dots = slide.querySelectorAll<HTMLButtonElement>('[data-photo-index]');
      const counter = slide.querySelector<HTMLElement>('[data-photo-counter]');
      let currentIdx = 0;

      const setPhoto = (newIdx: number) => {
        currentIdx = (newIdx + images.length) % images.length;
        if (mainImg) {
          mainImg.style.opacity = '0.35';
          setTimeout(() => {
            mainImg.src = images[currentIdx];
            mainImg.style.opacity = '1';
          }, 110);
        }
        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === currentIdx);
        });
        if (counter) {
          counter.textContent = `${currentIdx + 1}/${images.length}`;
        }
      };

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        setPhoto(currentIdx - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        setPhoto(currentIdx + 1);
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(dot.getAttribute('data-photo-index') || '0', 10);
          setPhoto(idx);
        });
      });
    });
  });
</script>
