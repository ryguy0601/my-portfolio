---
// src/pages/admin/index.astro
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../layouts/AdminLayout.astro';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL,
  import.meta.env.SUPABASE_SERVICE_ROLE_KEY
);

let errorMessage = '';
let successMessage = '';

const url = new URL(Astro.request.url);
const editProjectId = url.searchParams.get('edit_project');

// 1. HANDLE PROJECT CRUD SUBMISSIONS
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const actionType = formData.get('action_type')?.toString();

  try {
    if (actionType === 'save_project') {
      const projectId = formData.get('project_id')?.toString();
      const title = formData.get('title')?.toString();
      const summary = formData.get('summary')?.toString();
      const content = formData.get('content')?.toString();
      const live_url = formData.get('live_url')?.toString();
      const github_url = formData.get('github_url')?.toString();
      const featured = formData.get('featured') === 'on';

      const techEntries = formData.getAll('tech_stack[]').map(t => t.toString().trim()).filter(Boolean);
      const tech_stack = techEntries.join(', ');

      const image_folder = formData.get('image_folder')?.toString() || '';
      const imageFilenamesArray = formData.getAll('image_filenames[]').map(f => f.toString().trim()).filter(Boolean);
      const formattedImagePaths = imageFilenamesArray.map(file => {
        if (!image_folder) return file;
        const cleanFolder = image_folder.endsWith('/') ? image_folder : `${image_folder}/`;
        return `${cleanFolder}${file}`;
      });

      if (!title || !summary || !tech_stack) {
        errorMessage = 'Title, Summary, and at least one Technology are required.';
      } else {
        const payload = {
          title,
          slug: title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''),
          summary,
          content: content || null,
          tech_stack,
          live_url: live_url || null,
          github_url: github_url || null,
          featured,
          image_url: formattedImagePaths.length > 0 ? formattedImagePaths[0] : null,
          image_filenames: formattedImagePaths.length > 0 ? formattedImagePaths : null
        };

        if (projectId) {
          const { error } = await supabase.from('projects').update(payload).eq('id', projectId);
          if (error) throw error;
          return Astro.redirect('/admin');
        } else {
          const { error } = await supabase.from('projects').insert([payload]);
          if (error) throw error;
          successMessage = 'Project saved successfully!';
        }
      }
    } else if (actionType === 'delete_project') {
      const id = formData.get('id')?.toString();
      await supabase.from('project_experience').delete().eq('project_id', id);
      const { error } = await supabase.from('projects').delete().eq('id', id);
      if (error) throw error;
      return Astro.redirect('/admin');
    }
  } catch (err: any) {
    errorMessage = err.message || 'An unexpected database error occurred.';
  }
}

// 2. FETCH PROJECTS & COUNTS FOR TAB BADGES
const [{ data: projects }, { count: expCount }, { count: linksCount }] = await Promise.all([
  supabase.from('projects').select('*').order('id', { ascending: false }),
  supabase.from('work_experience').select('*', { count: 'exact', head: true }),
  supabase.from('project_experience').select('*', { count: 'exact', head: true })
]);

let editProject = editProjectId ? projects?.find(p => String(p.id) === String(editProjectId)) : null;

let existingFolder = '';
let existingFilenamesList: string[] = [''];
let existingTechList: string[] = [''];

if (editProject) {
  if (editProject.tech_stack) {
    const items = editProject.tech_stack.split(',').map((t: string) => t.trim()).filter(Boolean);
    if (items.length > 0) existingTechList = items;
  }
  if (Array.isArray(editProject.image_filenames) && editProject.image_filenames.length > 0) {
    const firstFile = editProject.image_filenames[0] || '';
    const lastSlashIndex = firstFile.lastIndexOf('/');
    if (lastSlashIndex !== -1) {
      existingFolder = firstFile.substring(0, lastSlashIndex);
      existingFilenamesList = editProject.image_filenames.map((p: string) => p.substring(lastSlashIndex + 1));
    } else {
      existingFilenamesList = [...editProject.image_filenames];
    }
  }
}
---

<AdminLayout 
  activePage="projects"
  title="Manage Projects"
  errorMessage={errorMessage}
  successMessage={successMessage}
  counts={{ projects: projects?.length || 0, experience: expCount || 0, links: linksCount || 0 }}
>
  <div class="d-flex flex-column gap-4">
    <!-- Project Form Card -->
    <div class="card bg-card border border-secondary p-4 rounded-4 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-gradient h5 mb-0 fw-bold">{editProject ? `Editing: ${editProject.title}` : 'Add New Project'}</h3>
        {editProject && <a href="/admin" class="btn btn-outline-secondary btn-sm">Cancel Edit</a>}
      </div>

      <form method="POST">
        <input type="hidden" name="action_type" value="save_project" />
        {editProject && <input type="hidden" name="project_id" value={editProject.id} />}

        <div class="row g-3">
          <div class="col-lg-4">
            <label class="form-label text-light small">Project Title *</label>
            <input type="text" name="title" value={editProject?.title || ''} class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Project Name" required />
          </div>
          <div class="col-lg-4">
            <label class="form-label text-light small">Live Demo URL</label>
            <input type="url" name="live_url" value={editProject?.live_url || ''} class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://..." />
          </div>
          <div class="col-lg-4">
            <label class="form-label text-light small">GitHub URL</label>
            <input type="url" name="github_url" value={editProject?.github_url || ''} class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://github.com/..." />
          </div>

          <div class="col-lg-6">
            <label class="form-label text-light small">Summary Description (Enter lines for bullets) *</label>
            <textarea name="summary" class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" placeholder="Key bullet points..." required>{editProject?.summary || ''}</textarea>
          </div>
          <div class="col-lg-6">
            <label class="form-label text-light small">Full Content (Enter lines for bullets)</label>
            <textarea name="content" class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" placeholder="Technical architecture & case study...">{editProject?.content || ''}</textarea>
          </div>

          <!-- Technologies Input Repeater -->
          <div class="col-lg-6">
            <div class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label text-accent small fw-bold mb-0">Technologies *</label>
                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" id="add-tech-btn">+ Add Tech</button>
              </div>
              <div id="tech-inputs-container" class="d-flex flex-column gap-2">
                {existingTechList.map((tech) => (
                  <div class="input-group input-group-sm">
                    <input type="text" name="tech_stack[]" value={tech} class="form-control bg-dark text-light border-secondary" placeholder="e.g., C#, React" required />
                    <button type="button" class="btn btn-outline-danger remove-input-btn">&times;</button>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Screenshots Input Repeater -->
          <div class="col-lg-6">
            <div class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label text-accent small fw-bold mb-0">Image Assets</label>
                <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" id="add-image-btn">+ Add Picture</button>
              </div>
              <input type="text" name="image_folder" value={existingFolder} class="form-control form-control-sm bg-dark text-light border-secondary mb-2" placeholder="Folder path e.g. /images/projects/demo" />
              <div id="image-inputs-container" class="d-flex flex-column gap-2">
                {existingFilenamesList.map((file) => (
                  <div class="input-group input-group-sm">
                    <input type="text" name="image_filenames[]" value={file} class="form-control bg-dark text-light border-secondary" placeholder="screen1.png" />
                    <button type="button" class="btn btn-outline-danger remove-input-btn">&times;</button>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="col-12 d-flex align-items-center justify-content-between pt-2">
            <div class="form-check">
              <input type="checkbox" name="featured" class="form-check-input bg-dark border-secondary" id="featuredCheck" checked={editProject?.featured} />
              <label class="form-check-label text-light small" for="featuredCheck">Feature on Homepage</label>
            </div>
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
              {editProject ? 'Update Project' : 'Save Project to Database'}
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Active Projects Grid -->
    <div>
      <h4 class="text-light h6 mb-3 fw-bold">Active Portfolio Projects ({projects?.length || 0})</h4>
      <div class="scroll-grid-container p-2 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          {projects && projects.map((project) => (
            <div class="col">
              <div class={`card bg-card border ${editProjectId == project.id ? 'border-primary' : 'border-secondary'} p-3 rounded-3 h-100 d-flex flex-column justify-content-between`}>
                <div>
                  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <h6 class="text-primary fw-bold mb-0 text-truncate">{project.title}</h6>
                    {project.featured && <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small">Featured</span>}
                  </div>
                  <p class="text-muted small line-clamp-2 mb-2">{project.summary}</p>
                  <div class="font-monospace text-accent small text-truncate mb-3">{project.tech_stack}</div>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                  <a href={`/admin?edit_project=${project.id}`} class="btn btn-outline-primary btn-sm py-0 px-2">Edit</a>
                  <form method="POST" onsubmit="return confirm('Delete this project?');" class="m-0">
                    <input type="hidden" name="action_type" value="delete_project" />
                    <input type="hidden" name="id" value={project.id} />
                    <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function updateRemoveButtons(container: HTMLElement | null) {
      if (!container) return;
      const rows = container.querySelectorAll<HTMLElement>('.input-group');
      const showButtons = rows.length > 1;
      rows.forEach((row) => {
        const btn = row.querySelector<HTMLElement>('.remove-input-btn');
        if (btn) btn.style.display = showButtons ? 'block' : 'none';
      });
    }

    function createInputRow(name: string, placeholder: string, isRequired = false) {
      const row = document.createElement('div');
      row.className = 'input-group input-group-sm';
      const input = document.createElement('input');
      input.type = 'text';
      input.name = name;
      input.className = 'form-control bg-dark text-light border-secondary';
      input.placeholder = placeholder;
      if (isRequired) input.required = true;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'btn btn-outline-danger remove-input-btn';
      button.title = 'Remove item';
      button.innerHTML = '&times;';

      button.addEventListener('click', () => {
        const container = row.parentElement as HTMLElement;
        row.remove();
        updateRemoveButtons(container);
      });

      row.appendChild(input);
      row.appendChild(button);
      return row;
    }

    document.querySelectorAll('.remove-input-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const row = target.closest('.input-group');
        const container = row?.parentElement as HTMLElement;
        row?.remove();
        updateRemoveButtons(container);
      });
    });

    const techContainer = document.getElementById('tech-inputs-container');
    const imageContainer = document.getElementById('image-inputs-container');

    updateRemoveButtons(techContainer);
    updateRemoveButtons(imageContainer);

    document.getElementById('add-tech-btn')?.addEventListener('click', () => {
      if (!techContainer) return;
      const newRow = createInputRow('tech_stack[]', 'e.g., Supabase', true);
      techContainer.appendChild(newRow);
      updateRemoveButtons(techContainer);
      newRow.querySelector('input')?.focus();
    });

    document.getElementById('add-image-btn')?.addEventListener('click', () => {
      if (!imageContainer) return;
      const newRow = createInputRow('image_filenames[]', 'screenshot.png', false);
      imageContainer.appendChild(newRow);
      updateRemoveButtons(imageContainer);
      newRow.querySelector('input')?.focus();
    });
  });
</script>