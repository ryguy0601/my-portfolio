    margin-bottom: 0.65rem;
    letter-spacing: -0.02em;
  }

  .markdown-content h1 {
    font-size: 1.55rem;
    border-bottom: 1px solid rgba(var(--color-secondary-rgb, 155, 93, 229), 0.3);
