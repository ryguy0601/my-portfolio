    ) !important;
    box-shadow: 0 0 10px rgba(var(--color-secondary-rgb, 155, 93, 229), 0.4);
    transform: translateY(-1px);
  }

  .md-view-btn.active {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-secondary) 100%
    ) !important;
