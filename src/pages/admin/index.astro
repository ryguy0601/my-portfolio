---
// src/pages/admin/index.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase, getAdminCounts } from "../../utils/supabase";
import {
  getTechInfo,
  parseTechStack,
  techIconMap,
} from "../../utils/techIcons";
import { slugify, splitCommaList } from "../../utils/text";
import {
  formatImagePaths,
  extractFolderAndFilenames,
} from "../../utils/projects";
import { extractUniqueCategories } from "../../utils/skills";
import { GitHubProjectsService } from "../../services/githubProjectsService";

let errorMessage = "";
let successMessage = "";

const url = new URL(Astro.request.url);
const editProjectId = url.searchParams.get("edit_project");

// 1. HANDLE CRUD & AJAX SUBMISSIONS
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const actionType = formData.get("action_type")?.toString();

  try {
    // Background inline skill creation via fetch()
    if (actionType === "create_skill_ajax") {
      const name = formData.get("name")?.toString()?.trim();
      const category = formData.get("category")?.toString()?.trim();

      if (!name || !category) {
        return new Response(
          JSON.stringify({ success: false, error: "Missing name or category" }),
          {
            status: 400,
            headers: { "Content-Type": "application/json" },
          },
        );
      }

      const { data, error } = await supabase
        .from("skills")
        .insert([{ name, category, order_index: 0 }])
        .select();
      if (error) {
        return new Response(
          JSON.stringify({ success: false, error: error.message }),
          {
            status: 500,
            headers: { "Content-Type": "application/json" },
          },
        );
      }

      return new Response(JSON.stringify({ success: true, skill: data?.[0] }), {
        status: 200,
        headers: { "Content-Type": "application/json" },
      });
    }

    if (actionType === "fetch_github_repo_languages_ajax") {
      const repoUrl = formData.get("github_url")?.toString()?.trim() || "";
      if (!repoUrl) {
        return new Response(JSON.stringify({ success: false, languages: [] }), {
          status: 400,
          headers: { "Content-Type": "application/json" },
        });
      }

      let fullName = "";
      const match = repoUrl.match(/github\.com\/([^\/]+\/[^\/#?]+)/i);
      if (match) {
        fullName = match[1].replace(/\.git$/i, "");
      } else if (repoUrl.includes("/")) {
        fullName = repoUrl.replace(/\.git$/i, "");
      } else {
        fullName = `ryguy0601/${repoUrl}`;
      }

      const languages = await GitHubProjectsService.fetchRepoLanguages(fullName);
      return new Response(JSON.stringify({ success: true, fullName, languages }), {
        status: 200,
        headers: { "Content-Type": "application/json" },
      });
    }

    if (actionType === "save_project") {
      const projectId = formData.get("project_id")?.toString();
      const title = formData.get("title")?.toString();
      const summary = formData.get("summary")?.toString();
      const content = formData.get("content")?.toString();
      const live_url = formData.get("live_url")?.toString();
      const github_url = formData.get("github_url")?.toString();
      const featured = formData.get("featured") === "on";

      const techEntries = formData
        .getAll("tech_stack[]")
        .map((t) => t.toString().trim())
        .filter(Boolean);
      const tech_stack = techEntries.join(", ");

      const image_folder = formData.get("image_folder")?.toString() || "";
      const imageFilenamesArray = formData
        .getAll("image_filenames[]")
        .map((f) => f.toString().trim())
        .filter(Boolean);
      const formattedImagePaths = formatImagePaths(
        image_folder,
        imageFilenamesArray,
      );

      if (!title || !summary || !tech_stack) {
        errorMessage =
          "Title, Summary, and at least one Technology are required.";
      } else {
        const payload = {
          title,
          slug: slugify(title),
          summary,
          content: content || null,
          tech_stack,
          live_url: live_url || null,
          github_url: github_url || null,
          featured,
          image_url:
            formattedImagePaths.length > 0 ? formattedImagePaths[0] : null,
          image_filenames:
            formattedImagePaths.length > 0 ? formattedImagePaths : null,
        };

        if (projectId) {
          const { error } = await supabase
            .from("projects")
            .update(payload)
            .eq("id", projectId);
          if (error) throw error;
          return Astro.redirect("/admin");
        } else {
          const { error } = await supabase.from("projects").insert([payload]);
          if (error) throw error;
          successMessage = "Project saved successfully!";
        }
      }
    } else if (actionType === "delete_project") {
      const id = formData.get("id")?.toString();
      await supabase.from("project_experience").delete().eq("project_id", id);
      const { error } = await supabase.from("projects").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/admin");
    } else if (actionType === "save_github_config") {
      const mode = (formData.get("github_mode")?.toString() || "database") as
        | "database"
        | "hybrid"
        | "github";
      const username =
        formData.get("github_username")?.toString()?.trim() || "ryguy0601";
      const hideForks = formData.get("hide_forks") === "on";
      const hideProfileReadme = formData.get("hide_profile_readme") === "on";

      // If checkboxes were submitted from the repo visibility list, compute excludedRepos from unchecked repos
      const allRepoNames = formData
        .getAll("all_repo_names[]")
        .map((r) => r.toString().trim())
        .filter(Boolean);
      const visibleRepoNames = new Set(
        formData
          .getAll("visible_repos[]")
          .map((r) => r.toString().trim().toLowerCase())
          .filter(Boolean)
      );

      const featuredRepoNames = formData
        .getAll("featured_repos[]")
        .map((r) => r.toString().trim())
        .filter(Boolean);

      let excludedRepos: string[] = [];
      if (allRepoNames.length > 0) {
        excludedRepos = allRepoNames.filter(
          (name) => !visibleRepoNames.has(name.toLowerCase())
        );
      } else {
        const excludedRaw = formData.get("excluded_repos")?.toString() || "";
        excludedRepos = splitCommaList(excludedRaw);
      }

      // Check for any custom languages overrides submitted
      const currentConfig = await GitHubProjectsService.getConfig(supabase);
      const updatedCustomLanguages: Record<string, string[]> = {
        ...(currentConfig.customLanguages || {}),
      };

      for (const name of allRepoNames) {
        const rawLangs = formData.get(`custom_langs_${name}`)?.toString();
        if (rawLangs !== undefined) {
          const split = splitCommaList(rawLangs);
          if (split.length > 0) {
            updatedCustomLanguages[name] = split;
          } else {
            delete updatedCustomLanguages[name];
            delete updatedCustomLanguages[name.toLowerCase()];
          }
        }
      }

      const { error } = await GitHubProjectsService.saveConfig(supabase, {
        mode,
        username,
        hideForks,
        hideProfileReadme,
        excludedRepos,
        featuredRepos: featuredRepoNames,
        customLanguages: updatedCustomLanguages,
      });
      if (error) throw error;
      successMessage = `Saved GitHub settings (${mode.toUpperCase()} mode, ${allRepoNames.length - excludedRepos.length} visible, ${featuredRepoNames.length} featured).`;
    } else if (actionType === "toggle_github_repo_ajax") {
      const repoName = formData.get("repo_name")?.toString()?.trim() || "";
      const visible = formData.get("visible") === "true";
      const currentCfg = await GitHubProjectsService.getConfig(supabase);
      const excluded = new Set(
        (currentCfg.excludedRepos || []).map((r) => r.toLowerCase())
      );

      if (visible) {
        excluded.delete(repoName.toLowerCase());
      } else {
        excluded.add(repoName.toLowerCase());
      }

      const updatedExcluded = Array.from(excluded);
      const { error } = await GitHubProjectsService.saveConfig(supabase, {
        excludedRepos: updatedExcluded,
      });
      GitHubProjectsService.clearCache();

      return new Response(
        JSON.stringify({
          success: !error,
          excludedRepos: updatedExcluded,
        }),
        { status: error ? 500 : 200, headers: { "Content-Type": "application/json" } }
      );
    } else if (actionType === "toggle_github_featured_ajax") {
      const repoName = formData.get("repo_name")?.toString()?.trim() || "";
      const featured = formData.get("featured") === "true";
      const currentCfg = await GitHubProjectsService.getConfig(supabase);
      const featuredSet = new Set(
        (currentCfg.featuredRepos || []).map((r) => r.toLowerCase())
      );

      if (featured) {
        featuredSet.add(repoName.toLowerCase());
      } else {
        featuredSet.delete(repoName.toLowerCase());
      }

      const updatedFeatured = Array.from(featuredSet);
      const { error } = await GitHubProjectsService.saveConfig(supabase, {
        featuredRepos: updatedFeatured,
      });
      GitHubProjectsService.clearCache();

      return new Response(
        JSON.stringify({
          success: !error,
          featuredRepos: updatedFeatured,
        }),
        { status: error ? 500 : 200, headers: { "Content-Type": "application/json" } }
      );
    } else if (actionType === "save_github_repo_languages_ajax") {
      const repoName = formData.get("repo_name")?.toString()?.trim() || "";
      const rawLangs = formData.get("languages")?.toString() || "";
      const currentCfg = await GitHubProjectsService.getConfig(supabase);
      const updatedCustomLangs = { ...(currentCfg.customLanguages || {}) };

      const splitLangs = splitCommaList(rawLangs);
      if (splitLangs.length > 0) {
        updatedCustomLangs[repoName] = splitLangs;
      } else {
        delete updatedCustomLangs[repoName];
        delete updatedCustomLangs[repoName.toLowerCase()];
      }

      const { error } = await GitHubProjectsService.saveConfig(supabase, {
        customLanguages: updatedCustomLangs,
      });
      GitHubProjectsService.clearCache();

      return new Response(
        JSON.stringify({
          success: !error,
          customLanguages: updatedCustomLangs,
        }),
        { status: error ? 500 : 200, headers: { "Content-Type": "application/json" } }
      );
    } else if (actionType === "add_custom_github_repo") {
      const repoInput = formData.get("custom_repo_url")?.toString()?.trim() || "";
      if (repoInput) {
        let repoIdentifier = repoInput;
        const match = repoInput.match(/github\.com\/([^\/]+\/[^\/#?]+)/i);
        if (match) {
          repoIdentifier = match[1].replace(/\.git$/i, '');
        }

        const currentCfg = await GitHubProjectsService.getConfig(supabase);
        const customRepos = Array.isArray(currentCfg.customRepos) ? [...currentCfg.customRepos] : [];

        if (!customRepos.some((r) => r.toLowerCase() === repoIdentifier.toLowerCase())) {
          customRepos.push(repoIdentifier);
          const { error } = await GitHubProjectsService.saveConfig(supabase, {
            customRepos,
          });
          if (error) throw error;
          GitHubProjectsService.clearCache();
          successMessage = `Successfully added collaborated repository "${repoIdentifier}"!`;
        } else {
          successMessage = `Repository "${repoIdentifier}" is already linked.`;
        }
      }
    } else if (actionType === "remove_custom_github_repo") {
      const repoIdentifier = formData.get("repo_name")?.toString()?.trim() || "";
      if (repoIdentifier) {
        const currentCfg = await GitHubProjectsService.getConfig(supabase);
        const customRepos = (currentCfg.customRepos || []).filter(
          (r) => r.toLowerCase() !== repoIdentifier.toLowerCase()
        );
        const { error } = await GitHubProjectsService.saveConfig(supabase, {
          customRepos,
        });
        if (error) throw error;
        GitHubProjectsService.clearCache();
        successMessage = `Removed collaborated repository "${repoIdentifier}".`;
      }
    } else if (actionType === "import_github_repo") {
      const repoName = formData.get("repo_name")?.toString()?.trim() || "";
      const repoUrl = formData.get("repo_url")?.toString()?.trim() || "";
      const repoDesc = formData.get("repo_desc")?.toString()?.trim() || "";
      let repoLang = formData.get("repo_lang")?.toString()?.trim() || "GitHub";
      const repoHomepage =
        formData.get("repo_homepage")?.toString()?.trim() || null;
      const defaultBranch =
        formData.get("default_branch")?.toString()?.trim() || "main";
      const fullName = formData.get("full_name")?.toString()?.trim() || "";

      if (repoName && repoUrl) {
        // Fetch all languages from GitHub for rich tech stack tags
        const allRepoLangs = await GitHubProjectsService.fetchRepoLanguages(fullName || `ryguy0601/${repoName}`);
        if (allRepoLangs.length > 0) {
          const combined = [repoLang, ...allRepoLangs].filter(Boolean);
          const uniqueLangs: string[] = [];
          for (const l of combined) {
            for (const item of splitCommaList(l)) {
              if (item && !uniqueLangs.some((u) => u.toLowerCase() === item.toLowerCase())) {
                uniqueLangs.push(item);
              }
            }
          }
          if (uniqueLangs.length > 0) repoLang = uniqueLangs.join(", ");
        }

        const demoImages = await GitHubProjectsService.resolveRepoDemoImages({
          id: 0,
          name: repoName,
          full_name: fullName || `ryguy0601/${repoName}`,
          private: false,
          fork: false,
          archived: false,
          html_url: repoUrl,
          description: repoDesc,
          homepage: repoHomepage,
          language: repoLang,
          topics: [],
          stargazers_count: 0,
          forks_count: 0,
          default_branch: defaultBranch,
          updated_at: "",
          pushed_at: "",
        });
        const payload = {
          title: repoName
            .replace(/[-_]+/g, " ")
            .replace(/([a-z])([A-Z])/g, "$1 $2")
            .replace(/\b\w/g, (c) => c.toUpperCase()),
          slug: slugify(repoName),
          summary:
            repoDesc ||
            `Public ${repoLang} repository imported from GitHub (${fullName || repoName}).`,
          content: `${repoUrl}/blob/${defaultBranch}/README.md`,
          tech_stack: repoLang,
          live_url: repoHomepage || null,
          github_url: repoUrl,
          featured: false,
          image_url: demoImages[0] || null,
          image_filenames: demoImages.length > 0 ? demoImages : null,
        };
        const { error } = await supabase.from("projects").insert([payload]);
        if (error) throw error;
        successMessage = `Imported "${repoName}" from GitHub with all languages (${repoLang})!`;
      }
    }
  } catch (err: any) {
    errorMessage = err.message || "An unexpected database error occurred.";
  }
}

// 2. FETCH PROJECTS, SKILLS, GITHUB CONFIG & REPOS, AND COUNTS DIRECTLY FROM DB
const [
  { data: projects },
  { data: skillsData },
  adminCounts,
  githubConfig,
] = await Promise.all([
  supabase.from("projects").select("*").order("id", { ascending: false }),
  supabase
    .from("skills")
    .select("name, category")
    .order("category", { ascending: true })
    .order("name", { ascending: true }),
  getAdminCounts(),
  GitHubProjectsService.getConfig(supabase),
]);

const publicGithubRepos = await GitHubProjectsService.fetchPublicRepos(
  githubConfig.username,
);

// Merge any manually added collaborated repositories (e.g. from GitHub URL)
const customReposList = Array.isArray(githubConfig.customRepos) ? githubConfig.customRepos : [];
if (customReposList.length > 0) {
  const existingNames = new Set(publicGithubRepos.map((r) => r.name.toLowerCase()));
  const customSummaries = await Promise.all(
    customReposList.map((entry) => GitHubProjectsService.fetchSingleRepo(entry))
  );
  for (const cs of customSummaries) {
    if (cs && !existingNames.has(cs.name.toLowerCase())) {
      publicGithubRepos.push(cs);
      existingNames.add(cs.name.toLowerCase());
    }
  }
}

// Fetch all languages in parallel for each public repository
await Promise.all(
  publicGithubRepos.map(async (repo) => {
    if (!repo.languages) {
      repo.languages = await GitHubProjectsService.fetchRepoLanguages(repo.full_name);
    }
  })
);

const linkedGithubUrls = new Set(
  (projects || [])
    .map((p) =>
      (p.github_url || "")
        .trim()
        .toLowerCase()
        .replace(/\/+$/, "")
        .replace(/\.git$/, ""),
    )
    .filter(Boolean),
);

const existingSkills = skillsData || [];
const dbCategories = extractUniqueCategories(existingSkills);

let editProject = editProjectId
  ? projects?.find((p) => String(p.id) === String(editProjectId))
  : null;

let existingFolder = "";
let existingFilenamesList: string[] = [""];
let existingTechList: string[] = [""];

if (editProject) {
  if (editProject.tech_stack) {
    const items = splitCommaList(editProject.tech_stack);
    if (items.length > 0) existingTechList = items;
  }
  const extracted = extractFolderAndFilenames(editProject.image_filenames);
  existingFolder = extracted.folder;
  existingFilenamesList = extracted.filenames;
}
---

<AdminLayout
  activePage="projects"
  title="Manage Projects"
  errorMessage={errorMessage}
  successMessage={successMessage}
  counts={adminCounts}
>
  <div class="d-flex flex-column gap-4">
    <!-- JSON Payloads for Client Scripts -->
    <script
      type="application/json"
      id="admin-skills-data"
      set:html={JSON.stringify(existingSkills)}
    />
    <script
      type="application/json"
      id="admin-categories-data"
      set:html={JSON.stringify(dbCategories)}
    />
    <script
      type="application/json"
      id="admin-icon-map"
      set:html={JSON.stringify(techIconMap)}
    />

    <!-- GitHub Public Repository Sync & Per-Repo Toggle Control Panel -->
    <div class="card bg-card border border-secondary p-4 rounded-4 shadow-sm">
      <form method="POST" id="github-config-form">
        <input type="hidden" name="action_type" value="save_github_config" />

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
          <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center justify-content-center rounded-3 border border-secondary px-3 py-2" style="background: rgba(var(--color-primary-rgb), 0.1);">
              <i class="bi bi-github fs-4 text-accent"></i>
            </div>
            <div>
              <div class="d-flex flex-wrap align-items-center gap-2">
                <h3 class="h5 mb-0 fw-bold text-light">GitHub Public Repository Integration</h3>
                <span class="badge rounded-pill font-monospace small" style="background: rgba(var(--color-primary-rgb), 0.15); color: var(--color-primary); border: 1px solid rgba(var(--color-primary-rgb), 0.35);">
                  Mode: {githubConfig.mode.toUpperCase()}
                </span>
                <span class="badge rounded-pill bg-dark border border-secondary text-muted font-monospace small">
                  <i class="bi bi-folder2-open me-1 text-accent"></i>Screenshots: /demoPics
                </span>
              </div>
              <p class="text-muted small mb-0 mt-1">
                Pulls strictly <strong>public</strong> repositories and automatically loads screenshots from each repo's <code>/demoPics</code> folder (or local <code>/public/demoPics/&lt;repo&gt;</code>). Toggle individual repositories below to control which ones appear on your portfolio.
              </p>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-sm px-3 py-2 fw-semibold font-monospace">
            <i class="bi bi-floppy me-1"></i>Save GitHub Settings
          </button>
        </div>

        <div class="row g-3 align-items-center mb-3">
          <div class="col-md-5">
            <label class="form-label text-light small fw-semibold">Portfolio Project Source Mode</label>
            <select name="github_mode" class="form-select form-select-sm bg-dark text-light border-secondary font-monospace">
              <option value="database" selected={githubConfig.mode === "database"}>
                Database Only (Curated Portfolio Projects)
              </option>
              <option value="hybrid" selected={githubConfig.mode === "hybrid"}>
                Hybrid (Database Projects + Checked Public GitHub Repos)
              </option>
              <option value="github" selected={githubConfig.mode === "github"}>
                GitHub Live Mode (Pull All Checked Public GitHub Repos)
              </option>
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label text-light small fw-semibold">GitHub Username</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-dark border-secondary text-muted">@</span>
              <input
                type="text"
                name="github_username"
                value={githubConfig.username}
                class="form-control bg-dark text-light border-secondary font-monospace"
                placeholder="ryguy0601"
                required
              />
            </div>
          </div>

          <div class="col-md-4 d-flex flex-wrap gap-3 pt-md-4">
            <div class="form-check mb-0">
              <input
                class="form-check-input bg-dark border-secondary"
                type="checkbox"
                name="hide_forks"
                id="hideForksCheck"
                checked={githubConfig.hideForks}
              />
              <label class="form-check-label text-light small" for="hideForksCheck">
                Hide Forked Repos
              </label>
            </div>

            <div class="form-check mb-0">
              <input
                class="form-check-input bg-dark border-secondary"
                type="checkbox"
                name="hide_profile_readme"
                id="hideProfileCheck"
                checked={githubConfig.hideProfileReadme}
              />
              <label class="form-check-label text-light small" for="hideProfileCheck">
                Hide Profile Repo ({githubConfig.username})
              </label>
            </div>
          </div>
        </div>

        <!-- Direct Link / Collaborated Repository Adder -->
        <div class="p-3 mb-3 rounded-3 border border-secondary border-opacity-50" style="background: rgba(var(--body-bg-rgb), 0.7);">
          <div class="d-flex align-items-center gap-2 mb-2">
            <i class="bi bi-link-45deg text-accent fs-5"></i>
            <span class="fw-semibold text-light small font-monospace">ADD COLLABORATED / EXTERNAL GITHUB REPOSITORY</span>
          </div>
          <p class="text-muted small mb-2" style="font-size: 0.75rem;">
            Contributed to a group project or partnered on someone else's repo? Paste the GitHub link or <code>owner/repo</code> below to link it into your portfolio, resume builder, and AI optimizer.
          </p>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-dark border-secondary text-muted font-monospace" style="font-size: 0.75rem;">
              https://github.com/
            </span>
            <input
              type="text"
              id="custom-collab-repo-input"
              class="form-control bg-dark text-light border-secondary font-monospace"
              placeholder="e.g. JderenthalCS/Corpo or https://github.com/owner/project"
              style="font-size: 0.78rem;"
            />
            <button
              type="button"
              class="btn btn-outline-primary btn-sm px-3 font-monospace"
              id="add-collab-repo-btn"
            >
              <i class="bi bi-plus-circle me-1"></i>Add to Projects
            </button>
          </div>
        </div>

        <!-- All Pulled Public GitHub Repositories with Per-Repo Show/Hide Toggle Switches -->
        <div class="pt-3 border-top border-secondary border-opacity-25">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
              <span class="font-monospace small text-accent fw-bold">
                PULLED PUBLIC GITHUB REPOSITORIES ({publicGithubRepos.length})
              </span>
              <span id="gh-toggle-save-status" class="badge bg-dark border border-secondary text-muted font-monospace d-none" style="font-size: 0.68rem;">
                Saved
              </span>
            </div>

            <div class="d-flex align-items-center gap-2">
              <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace" id="gh-check-all-btn" style="font-size: 0.72rem;">
                Check All
              </button>
              <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace" id="gh-uncheck-all-btn" style="font-size: 0.72rem;">
                Uncheck All
              </button>
            </div>
          </div>

          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-2" style="max-height: 480px; overflow-y: auto; padding-right: 4px;">
            {publicGithubRepos.map((repo) => {
              const cleanRepoUrl = repo.html_url.trim().toLowerCase().replace(/\/+$/, "");
              const isLinked = linkedGithubUrls.has(cleanRepoUrl);
              const isExcluded = (githubConfig.excludedRepos || []).some(
                (ex) => ex.toLowerCase() === repo.name.toLowerCase()
              );
              const isVisible = !isExcluded;
              const isFeatured = (githubConfig.featuredRepos || []).some(
                (f) => f.toLowerCase() === repo.name.toLowerCase()
              );

              // Gather all detected languages from GitHub + topics
              const detectedLangsList = repo.languages && repo.languages.length > 0
                ? repo.languages
                : (repo.language ? [repo.language] : []);
              
              // Custom languages override if configured
              const customLangsConfig = (githubConfig.customLanguages && (githubConfig.customLanguages[repo.name] || githubConfig.customLanguages[repo.name.toLowerCase()])) || [];
              const customLangsStr = customLangsConfig.join(", ");
              const allEffectiveLangs = customLangsConfig.length > 0 ? customLangsConfig : detectedLangsList;
              const effectiveLangsStr = allEffectiveLangs.join(", ") || "GitHub";

              const isCustomLinked = (githubConfig.customRepos || []).some(
                (cr) => cr.toLowerCase() === repo.full_name.toLowerCase() || cr.toLowerCase() === repo.name.toLowerCase()
              );

              return (
                <div class="col">
                  <div
                    class={`p-2 px-3 rounded-3 border d-flex flex-column gap-2 gh-repo-toggle-card ${isVisible ? "border-secondary" : "border-secondary border-opacity-25 opacity-50"}`}
                    style="background: rgba(var(--body-bg-rgb), 0.55);"
                    data-repo-card={repo.name}
                  >
                    <input type="hidden" name="all_repo_names[]" value={repo.name} />

                    <div class="d-flex justify-content-between align-items-center gap-2">
                      <div class="d-flex align-items-center gap-2 text-truncate">
                        <!-- Show / Hide Visibility Switch -->
                        <div class="form-check form-switch mb-0 flex-shrink-0">
                          <input
                            class="form-check-input gh-repo-visibility-switch"
                            type="checkbox"
                            role="switch"
                            name="visible_repos[]"
                            value={repo.name}
                            id={`gh-repo-switch-${repo.name}`}
                            data-repo-name={repo.name}
                            checked={isVisible}
                            title="Toggle whether this GitHub repository is shown on the portfolio"
                            style="cursor: pointer;"
                          />
                        </div>

                        <div class="text-truncate">
                          <div class="d-flex align-items-center gap-2">
                            <label
                              for={`gh-repo-switch-${repo.name}`}
                              class="fw-semibold text-light small text-truncate mb-0"
                              style="cursor: pointer;"
                            >
                              {repo.name}
                            </label>
                            {isCustomLinked && (
                              <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 font-monospace" style="font-size: 0.6rem;">
                                Collab
                              </span>
                            )}
                            {repo.fork && (
                              <span class="badge bg-dark border border-secondary text-muted font-monospace" style="font-size: 0.6rem;">
                                fork
                              </span>
                            )}
                          </div>
                        </div>
                      </div>

                      <div class="d-flex align-items-center gap-1 flex-shrink-0">
                        {isCustomLinked && (
                          <button
                            type="button"
                            class="btn btn-outline-danger btn-sm py-0 px-1 gh-remove-collab-btn"
                            style="font-size: 0.65rem;"
                            data-repo-name={repo.full_name || repo.name}
                            title="Remove this collaborated repository link"
                          >
                            <i class="bi bi-trash"></i>
                          </button>
                        )}
                        <!-- Featured Checkbox Badge -->
                        <button
                          type="button"
                          class={`btn btn-sm py-0 px-2 d-inline-flex align-items-center gap-1 rounded-pill gh-featured-btn font-monospace ${isFeatured ? "btn-warning text-dark border-warning" : "btn-outline-secondary text-muted"}`}
                          style="font-size: 0.68rem; line-height: 1.5;"
                          data-repo-name={repo.name}
                          data-featured={isFeatured ? "true" : "false"}
                          title="Toggle featured showcase on home page"
                        >
                          <input
                            type="checkbox"
                            class="gh-featured-checkbox d-none"
                            name="featured_repos[]"
                            value={repo.name}
                            checked={isFeatured}
                            data-repo-name={repo.name}
                            tabindex="-1"
                          />
                          <i class={`bi ${isFeatured ? "bi-star-fill text-dark" : "bi-star text-muted"}`}></i>
                          <span class="gh-featured-text fw-semibold">{isFeatured ? "Featured" : "Feature"}</span>
                        </button>

                        {isLinked ? (
                          <span
                            class="badge rounded-pill font-monospace"
                            style="font-size: 0.65rem; background: rgba(var(--color-primary-rgb), 0.15); color: var(--color-primary); border: 1px solid rgba(var(--color-primary-rgb), 0.35);"
                            title="Already in your Supabase projects table"
                          >
                            In DB
                          </span>
                        ) : (
                          <button
                            type="button"
                            class="btn btn-outline-secondary btn-sm py-0 px-2 font-monospace gh-quick-import-btn"
                            style="font-size: 0.66rem;"
                            data-repo-name={repo.name}
                            data-full-name={repo.full_name}
                            data-repo-url={repo.html_url}
                            data-repo-desc={repo.description || ""}
                            data-repo-lang={effectiveLangsStr}
                            data-repo-homepage={repo.homepage || ""}
                            data-default-branch={repo.default_branch}
                            title="Copy into Supabase Projects table for custom editing"
                          >
                            + DB
                          </button>
                        )}
                        <a
                          href={repo.html_url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn btn-outline-secondary btn-sm py-0 px-1 text-muted"
                          style="font-size: 0.68rem;"
                          title="Open on GitHub"
                        >
                          <i class="bi bi-box-arrow-up-right"></i>
                        </a>
                      </div>
                    </div>

                    <!-- Languages Tags and Manual Customization Trigger -->
                    <div class="d-flex flex-column gap-1 pt-1 border-top border-secondary border-opacity-25">
                      <div class="d-flex flex-wrap align-items-center justify-content-between gap-1">
                        <div class="d-flex flex-wrap align-items-center gap-1 text-truncate" style="font-size: 0.68rem;">
                          <span class="text-muted font-monospace"><i class="bi bi-code-slash me-1"></i>Langs:</span>
                          {allEffectiveLangs.slice(0, 4).map((lang) => (
                            <span class="badge bg-dark border border-secondary text-accent font-monospace" style="font-size: 0.62rem;">
                              {lang}
                            </span>
                          ))}
                          {allEffectiveLangs.length > 4 && (
                            <span class="badge bg-dark border border-secondary text-muted font-monospace" style="font-size: 0.62rem;">
                              +{allEffectiveLangs.length - 4} more
                            </span>
                          )}
                        </div>

                        <button
                          type="button"
                          class="btn btn-link btn-sm p-0 text-decoration-none text-muted font-monospace gh-edit-langs-btn"
                          style="font-size: 0.65rem;"
                          data-repo-name={repo.name}
                          data-langs={effectiveLangsStr}
                          title="Manually edit or add languages for this repo"
                        >
                          <i class="bi bi-pencil-square me-1"></i>Edit
                        </button>
                      </div>

                      <!-- Inline Quick-Edit Languages Box (Toggleable via button) -->
                      <div class="gh-langs-editor-box d-none pt-1" id={`langs-box-${repo.name}`}>
                        <div class="input-group input-group-sm">
                          <input
                            type="text"
                            name={`custom_langs_${repo.name}`}
                            class="form-control form-control-sm bg-dark text-light border-secondary font-monospace gh-custom-langs-input"
                            style="font-size: 0.72rem;"
                            value={customLangsStr || detectedLangsList.join(", ")}
                            placeholder="e.g. TypeScript, React, Python"
                            data-repo-name={repo.name}
                          />
                          <button
                            type="button"
                            class="btn btn-outline-primary btn-sm font-monospace gh-save-langs-btn"
                            style="font-size: 0.68rem;"
                            data-repo-name={repo.name}
                          >
                            Save
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </form>

      <!-- Hidden form for 1-click "+ DB" import button -->
      <form method="POST" id="gh-single-import-form" class="d-none">
        <input type="hidden" name="action_type" value="import_github_repo" />
        <input type="hidden" name="repo_name" id="imp-repo-name" />
        <input type="hidden" name="full_name" id="imp-full-name" />
        <input type="hidden" name="repo_url" id="imp-repo-url" />
        <input type="hidden" name="repo_desc" id="imp-repo-desc" />
        <input type="hidden" name="repo_lang" id="imp-repo-lang" />
        <input type="hidden" name="repo_homepage" id="imp-repo-homepage" />
        <input type="hidden" name="default_branch" id="imp-default-branch" />
      </form>
    </div>

    <!-- Project Form Card -->
    <div class="card bg-card border border-secondary p-4 rounded-4 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-gradient h5 mb-0 fw-bold">
          {editProject ? `Editing: ${editProject.title}` : "Add New Project"}
        </h3>
        {
          editProject && (
            <a href="/admin" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-x-circle me-1"></i>Cancel Edit
            </a>
          )
        }
      </div>

      <form method="POST">
        <input type="hidden" name="action_type" value="save_project" />
        {
          editProject && (
            <input type="hidden" name="project_id" value={editProject.id} />
          )
        }

        <div class="row g-3">
          <div class="col-lg-4">
            <label class="form-label text-light small">Project Title *</label>
            <input
              type="text"
              name="title"
              value={editProject?.title || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="Project Name"
              required
            />
          </div>
          <div class="col-lg-4">
            <label class="form-label text-light small">Live Demo URL</label>
            <input
              type="url"
              name="live_url"
              value={editProject?.live_url || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="https://..."
            />
          </div>
          <div class="col-lg-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label text-light small mb-0">GitHub URL</label>
              <button
                type="button"
                id="fetch-github-langs-btn"
                class="btn btn-link btn-sm p-0 text-decoration-none text-accent font-monospace"
                style="font-size: 0.68rem;"
                title="Automatically fetch and populate all repository languages from GitHub"
              >
                <i class="bi bi-arrow-repeat me-1"></i>Fetch Languages
              </button>
            </div>
            <input
              type="url"
              name="github_url"
              value={editProject?.github_url || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="https://github.com/..."
            />
            <div id="github-url-status" class="small mt-1 text-muted d-none" style="font-size: 0.72rem;"></div>
          </div>

          <div class="col-12">
            <label class="form-label text-light small"
              >Summary Description (Enter lines for bullets) *</label
            >
            <textarea
              name="summary"
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              rows="2"
              placeholder="Key bullet points (e.g. Architected microservices, integrated Supabase auth)..."
              required>{editProject?.summary || ""}</textarea
            >
          </div>

          <!-- Markdown Content Editor -->
          <div class="col-12">
            <div
              id="md-editor-main-container"
              class="md-editor-container rounded-3 border border-secondary border-opacity-50 overflow-hidden bg-black bg-opacity-40 shadow-sm"
            >
              <!-- Top Bar: Title & View Switcher -->
              <div
                class="md-editor-header d-flex flex-wrap justify-content-between align-items-center p-2 px-3 border-bottom border-secondary border-opacity-50 bg-dark bg-opacity-75 gap-2"
              >
                <div class="d-flex align-items-center gap-2">
                  <label
                    for="markdown-editor-textarea"
                    class="form-label text-light small fw-bold mb-0 d-flex align-items-center gap-2"
                  >
                    <i class="bi bi-file-earmark-code text-accent"></i>
                    <span>Full Content / Architecture Notes</span>
                  </label>
                  <span
                    class="badge rounded-pill bg-black border border-secondary text-secondary font-monospace"
                    style="font-size: 0.65rem;"
                  >
                    Markdown Supported
                  </span>
                  <span
                    id="md-readme-active-badge"
                    class="badge rounded-pill bg-dark border border-info text-info font-monospace d-none"
                    style="font-size: 0.65rem;"
                  >
                    <i class="bi bi-link-45deg me-1"></i>README URL Active
                  </span>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <span
                    id="md-char-count"
                    class="text-muted font-monospace small d-none d-sm-inline"
                    style="font-size: 0.7rem;">0 words • 0 chars</span
                  >

                  <div
                    class="btn-group btn-group-sm"
                    role="group"
                    aria-label="Editor View"
                  >
                    <button
                      type="button"
                      class="btn btn-sm active py-0 px-2 md-view-btn"
                      id="md-view-write"
                      title="Write Mode"
                    >
                      <i class="bi bi-pencil me-1"></i>Write
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm py-0 px-2 md-view-btn"
                      id="md-view-preview"
                      title="Preview Mode"
                    >
                      <i class="bi bi-eye me-1"></i>Preview
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm py-0 px-2 d-none d-md-inline-block md-view-btn"
                      id="md-view-split"
                      title="Split Screen Mode"
                    >
                      <i class="bi bi-columns-gap me-1"></i>Split
                    </button>
                  </div>

                  <button
                    type="button"
                    class="btn btn-sm py-0 px-2 ms-1 md-btn-fullscreen"
                    id="md-btn-fullscreen"
                    title="Toggle Fullscreen Focus Mode"
                  >
                    <i class="bi bi-arrows-fullscreen" id="md-fullscreen-icon"
                    ></i>
                  </button>
                </div>
              </div>

              <!-- Format Action Toolbar -->
              <div
                id="md-action-toolbar"
                class="md-editor-toolbar d-flex flex-wrap align-items-center justify-content-between gap-1 p-1 px-2 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-40"
              >
                <div class="d-flex flex-wrap align-items-center gap-1">
                  <!-- Text Styling -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="bold"
                      title="Bold (**text**)"
                    >
                      <i class="bi bi-type-bold"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="italic"
                      title="Italic (*text*)"
                    >
                      <i class="bi bi-type-italic"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="strike"
                      title="Strikethrough (~~text~~)"
                    >
                      <i class="bi bi-type-strikethrough"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Headings -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h1"
                      title="Heading 1 (# Heading)"
                    >
                      <i class="bi bi-type-h1"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h2"
                      title="Heading 2 (## Heading)"
                    >
                      <i class="bi bi-type-h2"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h3"
                      title="Heading 3 (### Heading)"
                    >
                      <i class="bi bi-type-h3"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Lists & Blocks -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="bullet"
                      title="Bullet List (- item)"
                    >
                      <i class="bi bi-list-ul"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="numbered"
                      title="Numbered List (1. item)"
                    >
                      <i class="bi bi-list-ol"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="task"
                      title="Task List (- [ ] item)"
                    >
                      <i class="bi bi-check2-square"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="quote"
                      title="Quote (> quote)"
                    >
                      <i class="bi bi-quote"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Code & Insertions -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="inline-code"
                      title="Inline Code (`code`)"
                    >
                      <i class="bi bi-code"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="code-block"
                      title="Code Block (```)"
                    >
                      <i class="bi bi-code-square"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="link"
                      title="Link ([title](url))"
                    >
                      <i class="bi bi-link-45deg"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="image"
                      title="Image (![alt](url))"
                    >
                      <i class="bi bi-image"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="table"
                      title="Table"
                    >
                      <i class="bi bi-table"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="hr"
                      title="Horizontal Line (---)"
                    >
                      <i class="bi bi-hr"></i>
                    </button>
                  </div>
                </div>

                <!-- Special README & Action Tools -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                  <button
                    type="button"
                    class="btn btn-sm md-btn-readme px-2 py-1 d-inline-flex align-items-center gap-1"
                    id="md-toggle-readme-btn"
                    title="Fetch or link GitHub README"
                  >
                    <i class="bi bi-github"></i>
                    <span>Import README</span>
                  </button>
                  <button
                    type="button"
                    class="btn btn-sm md-btn"
                    id="md-btn-clear"
                    title="Clear content"
                  >
                    <i class="bi bi-trash3"></i>
                  </button>
                </div>
              </div>

              <!-- Collapsible README Import / Sync Drawer -->
              <div
                id="md-readme-drawer"
                class="p-3 border-bottom border-secondary border-opacity-50 bg-black bg-opacity-70 d-none"
              >
                <div
                  class="d-flex align-items-center justify-content-between mb-2"
                >
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-github text-accent fs-5"></i>
                    <span class="text-light small fw-bold"
                      >Load README from GitHub or URL</span
                    >
                  </div>
                  <button
                    type="button"
                    class="btn-close btn-close-white small"
                    id="md-readme-close-btn"
                    aria-label="Close"></button>
                </div>

                <div class="input-group input-group-sm mb-2">
                  <span
                    class="input-group-text bg-dark border-secondary text-muted font-monospace"
                    style="font-size: 0.72rem;">URL</span
                  >
                  <input
                    type="url"
                    id="md-readme-url-input"
                    class="form-control bg-dark text-light border-secondary muted-placeholder font-monospace"
                    placeholder="https://github.com/owner/repo or raw.githubusercontent.com/.../README.md"
                  />
                  <button
                    type="button"
                    class="btn btn-sm md-drawer-btn"
                    id="md-use-project-github-btn"
                    title="Fill from project GitHub URL above"
                  >
                    <i class="bi bi-arrow-down-left me-1"></i>From Project
                  </button>
                  <button
                    type="button"
                    class="btn btn-primary px-3"
                    id="md-fetch-readme-btn"
                  >
                    <span
                      id="md-fetch-spinner"
                      class="spinner-border spinner-border-sm me-1 d-none"
                      role="status"></span>
                    <i class="bi bi-cloud-arrow-down me-1" id="md-fetch-icon"
                    ></i>Fetch &amp; Insert
                  </button>
                </div>

                <div
                  class="d-flex justify-content-between align-items-center flex-wrap gap-2"
                >
                  <div class="text-muted small" style="font-size: 0.73rem;">
                    <i class="bi bi-info-circle me-1 text-accent"></i>Tip: You
                    can also just paste the README link directly into the text
                    box below.
                  </div>
                  <div
                    class="form-check form-check-inline mb-0"
                    style="font-size: 0.75rem;"
                  >
                    <input
                      class="form-check-input"
                      type="checkbox"
                      id="md-readme-append-check"
                    />
                    <label
                      class="form-check-label text-muted"
                      for="md-readme-append-check"
                      >Append (keep existing text)</label
                    >
                  </div>
                </div>

                <div
                  id="md-readme-status"
                  class="small mt-2 p-2 rounded-2 d-none"
                >
                </div>
              </div>

              <!-- Main Editor Workspace (Write Pane & Preview Pane) -->
              <div
                class="md-editor-workspace d-flex position-relative"
                id="md-workspace"
              >
                <div class="md-pane-write flex-grow-1 w-100" id="md-pane-write">
                  <textarea
                    id="markdown-editor-textarea"
                    name="content"
                    class="form-control bg-transparent text-light border-0 font-monospace md-textarea p-3 muted-placeholder"
                    rows="9"
                    placeholder="### Architectural Highlights

Detailed write-up of engineering decisions, technical trade-offs, and outcomes...

- High-throughput event processing
- Relational database modeling with PostgreSQL

(Or paste a README.md link directly here)"
                    >{editProject?.content || ""}</textarea
                  >
                </div>
                <div
                  class="md-pane-preview flex-grow-1 w-100 d-none p-3 overflow-auto markdown-content"
                  id="md-pane-preview"
                  style="min-height: 240px; max-height: 500px;"
                >
                  <span class="text-muted fst-italic small"
                    >Nothing to preview yet. Start typing markdown or paste a
                    README link!</span
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- Technologies Input Repeater -->
          <div class="col-lg-6">
            <div
              class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100"
            >
              <div
                class="d-flex justify-content-between align-items-center mb-2"
              >
                <div>
                  <label class="form-label text-accent small fw-bold mb-0"
                    >Technologies *</label
                  >
                  <span class="text-muted d-block" style="font-size: 0.72rem;"
                    >Autocompletes skills; prompts modal if missing in DB</span
                  >
                </div>
                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm py-0 px-2"
                  id="add-tech-btn"
                ><i class="bi bi-plus-circle me-1"></i>Add Tech</button>
              </div>

              <!-- Quick Skill Picks (Matching skills.astro 1-Click Pickers) -->
              {
                existingSkills.length > 0 && (
                  <div class="mb-2 p-2 rounded-3 border border-secondary border-opacity-50 bg-black bg-opacity-30">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span
                        class="text-muted small font-monospace"
                        style="font-size: 0.7rem;"
                      >
                        Quick Picks from Skills:
                      </span>
                      <span
                        id="quick-picks-filter-hint"
                        class="text-muted small"
                        style="font-size: 0.65rem;"
                      >
                        Click to add • filters as you type
                      </span>
                    </div>
                    <div
                      id="quick-picks-container"
                      class="d-flex flex-wrap gap-1 align-items-center quick-picks-container"
                      style="max-height: 84px; overflow-y: auto;"
                    >
                      {existingSkills.map((s) => {
                        const tInfo = getTechInfo(s.name);
                        return (
                          <button
                            type="button"
                            class="skill-quick-chip badge rounded-pill bg-dark border border-secondary text-secondary d-inline-flex align-items-center gap-1 py-1 px-2"
                            data-skill-name={s.name}
                            data-tech-tooltip={s.name}
                            title={s.name}
                          >
                            <span
                              class="skill-icon-wrap d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                              style="width: 14px; height: 14px; border: none; background: transparent;"
                            >
                              {tInfo.hasIcon ? (
                                <img
                                  src={tInfo.iconUrl}
                                  alt={s.name}
                                  class="tech-icon-img"
                                  style="width: 11px; height: 11px;"
                                  loading="lazy"
                                />
                              ) : (
                                <span style="font-size: 0.55rem;">●</span>
                              )}
                            </span>
                            <span style="font-size: 0.72rem;">{s.name}</span>
                          </button>
                        );
                      })}
                      <div
                        id="no-quick-picks-msg"
                        class="text-muted small fst-italic d-none p-1"
                        style="font-size: 0.72rem;"
                      >
                        No matching skills found in database.
                      </div>
                    </div>
                  </div>
                )
              }

              <div id="tech-inputs-container" class="d-flex flex-column gap-2">
                {
                  existingTechList.map((tech) => {
                    const techInfo = getTechInfo(tech);
                    return (
                      <div class="tech-row position-relative">
                        <div class="d-flex align-items-center gap-2">
                          <div
                            class="skill-icon-wrap position-relative d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                            data-tech-tooltip={tech || ""}
                            title={tech || ""}
                          >
                            {techInfo.hasIcon ? (
                              <img
                                src={techInfo.iconUrl}
                                alt={tech}
                                class="tech-icon-img"
                                loading="lazy"
                              />
                            ) : (
                              <span
                                class="text-muted font-monospace small"
                                style="font-size: 0.65rem;"
                              >
                                txt
                              </span>
                            )}
                          </div>
                          <div class="input-group input-group-sm flex-grow-1">
                            <input
                              type="text"
                              name="tech_stack[]"
                              value={tech}
                              class="form-control bg-dark text-light border-secondary muted-placeholder tech-stack-input"
                              placeholder="e.g., C#, React"
                              autocomplete="off"
                              required
                            />
                            <button
                              type="button"
                              class="btn btn-outline-danger remove-input-btn"
                              title="Remove item"
                            >
                              <i class="bi bi-trash3"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>

          <!-- Screenshots Input Repeater -->
          <div class="col-lg-6">
            <div
              class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100"
            >
              <div
                class="d-flex justify-content-between align-items-center mb-2"
              >
                <label class="form-label text-accent small fw-bold mb-0"
                  >Image Assets</label
                >
                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm py-0 px-2"
                  id="add-image-btn"
                ><i class="bi bi-plus-circle me-1"></i>Add Picture</button>
              </div>
              <input
                type="text"
                name="image_folder"
                value={existingFolder}
                class="form-control form-control-sm bg-dark text-light border-secondary mb-2 muted-placeholder"
                placeholder="Folder path e.g. /demoPics/my-repo"
              />
              <div id="image-inputs-container" class="d-flex flex-column gap-2">
                {
                  existingFilenamesList.map((file) => (
                    <div class="input-group input-group-sm">
                      <input
                        type="text"
                        name="image_filenames[]"
                        value={file}
                        class="form-control bg-dark text-light border-secondary muted-placeholder"
                        placeholder="screen1.png"
                      />
                      <button
                        type="button"
                        class="btn btn-outline-danger remove-input-btn"
                        title="Remove item"
                      >
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            class="col-12 d-flex align-items-center justify-content-between pt-2"
          >
            <div class="form-check">
              <input
                type="checkbox"
                name="featured"
                class="form-check-input bg-dark border-secondary"
                id="featuredCheck"
                checked={editProject?.featured}
              />
              <label
                class="form-check-label text-light small"
                for="featuredCheck">Feature on Homepage</label
              >
            </div>
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
              <i class="bi bi-floppy me-2"></i>{editProject ? "Update Project" : "Save Project to Database"}
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Active Projects Grid -->
    <div>
      <h4 class="text-light h6 mb-3 fw-bold">
        Curated Supabase Projects ({projects?.length || 0})
      </h4>
      <div
        class="scroll-grid-container p-2 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25"
      >
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          {
            projects &&
              projects.map((project) => (
                <div class="col">
                  <div
                    class={`card bg-card border ${editProjectId == project.id ? "border-primary" : "border-secondary"} p-3 rounded-3 h-100 d-flex flex-column justify-content-between`}
                  >
                    <div>
                      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h6 class="text-primary fw-bold mb-0 text-truncate">
                          {project.title}
                        </h6>
                        {project.featured && (
                          <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small">
                            Featured
                          </span>
                        )}
                      </div>
                      <p class="text-muted small line-clamp-2 mb-2">
                        {project.summary}
                      </p>
                      <div class="d-flex flex-wrap gap-1 align-items-center mb-3">
                        {project.tech_stack &&
                          parseTechStack(project.tech_stack).map((tech) => (
                            <div
                              class="skill-icon-wrap position-relative d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                              title={tech.name}
                              data-tech-tooltip={tech.name}
                            >
                              {tech.hasIcon ? (
                                <img
                                  src={tech.iconUrl}
                                  alt={tech.name}
                                  class="tech-icon-img"
                                  loading="lazy"
                                />
                              ) : (
                                <span
                                  class="text-muted font-monospace small"
                                  style="font-size: 0.65rem;"
                                >
                                  txt
                                </span>
                              )}
                            </div>
                          ))}
                        <span
                          class="font-monospace text-accent small ms-1 text-truncate"
                          style="max-width: 140px;"
                          title={project.tech_stack}
                        >
                          {project.tech_stack}
                        </span>
                      </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                      <a
                        href={`/admin?edit_project=${project.id}`}
                        class="btn btn-outline-primary btn-sm py-0 px-2"
                      >
                        <i class="bi bi-pencil me-1"></i>Edit
                      </a>
                      <form
                        method="POST"
                        onsubmit="return confirm('Delete this project?');"
                        class="m-0"
                      >
                        <input
                          type="hidden"
                          name="action_type"
                          value="delete_project"
                        />
                        <input type="hidden" name="id" value={project.id} />
                        <button
                          type="submit"
                          class="btn btn-outline-danger btn-sm py-0 px-2"
                        >
                          <i class="bi bi-trash3 me-1"></i>Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- New Skill Category Modal -->
  <div
    class="modal fade"
    id="addSkillModal"
    tabindex="-1"
    aria-labelledby="addSkillModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div
        class="modal-content glass-modal border border-secondary text-light rounded-4 shadow-lg"
      >
        <div class="modal-header border-secondary border-opacity-50 pb-2">
          <div class="d-flex align-items-center gap-2">
            <span
              class="badge rounded-circle p-2 bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50"
              >+</span
            >
            <h5 class="modal-title h6 mb-0 fw-bold" id="addSkillModalLabel">
              Add New Skill to Database
            </h5>
          </div>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
        </div>
        <div class="modal-body py-3">
          <p class="small text-muted mb-3">
            <strong class="text-light" id="modal-skill-name-display"
              >Skill</strong
            > was not found in your database. Pick one of your existing database categories
            or create a new one.
          </p>

          <div class="mb-3" id="modal-category-select-group">
            <label class="form-label text-accent small fw-semibold"
              >Database Category</label
            >
            <select
              class="form-select form-select-sm bg-dark text-light border-secondary"
              id="modal-category-select"
            >
              <!-- Strictly filled from DB categories -->
            </select>
          </div>

          <div id="modal-new-category-wrap" class="d-none">
            <label class="form-label text-accent small fw-semibold"
              >New Category Name *</label
            >
            <input
              type="text"
              id="modal-new-category-input"
              class="form-control form-control-sm bg-dark text-light border-secondary"
              placeholder="e.g. Mobile Development"
            />
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-50 pt-2">
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-bs-dismiss="modal"
          ><i class="bi bi-x-circle me-1"></i>Cancel</button>
          <button
            type="button"
            class="btn btn-primary btn-sm px-3"
            id="modal-save-skill-btn"
          ><i class="bi bi-plus-circle me-1"></i>Save to Skills</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .skill-icon-wrap {
    width: 28px;
    height: 28px;
    background: var(--border-glass-minimal);
    border: 1px solid var(--border-glass-subtle);
    position: relative;
  }

  .tech-icon-img {
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
    opacity: 0.9;
    vertical-align: middle;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  /* Floating Monospace Capsule Tooltip (matching TechBadgeList design) */
  .skill-icon-wrap[data-tech-tooltip]::before,
  .skill-quick-chip[data-tech-tooltip]::before {
    content: attr(data-tech-tooltip);
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%) translateY(4px) scale(0.92);
    transform-origin: bottom center;
    background: linear-gradient(
      135deg,
      rgba(var(--card-bg-rgb, 26, 13, 36), 0.96),
      rgba(var(--overlay-dark-rgb, 10, 5, 4), 0.98)
    );
    color: var(--body-color, #fff5fc);
    border: 1px solid rgba(var(--color-secondary-rgb, 155, 93, 229), 0.45);
    border-radius: var(--radius-pill, 9999px);
    padding: var(--badge-tooltip-padding, 3px 10px);
    font-size: 0.72rem;
    font-weight: 500;
    font-family: var(--bs-font-monospace, monospace);
    white-space: nowrap;
    letter-spacing: 0.03em;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0.2s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-tooltip, 0 8px 24px rgba(0, 0, 0, 0.8));
    z-index: 1070;
  }

  /* Micro Arrow Pointing Down to Icon */
  .skill-icon-wrap[data-tech-tooltip]::after,
  .skill-quick-chip[data-tech-tooltip]::after {
    content: "";
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    border-width: 5px 4.5px 0 4.5px;
    border-style: solid;
    border-color: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.45)
      transparent transparent transparent;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0.2s ease;
    z-index: 1070;
  }

  .skill-icon-wrap[data-tech-tooltip]:hover::before,
  .skill-icon-wrap[data-tech-tooltip]:hover::after,
  .skill-quick-chip[data-tech-tooltip]:hover::before,
  .skill-quick-chip[data-tech-tooltip]:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .skill-icon-wrap[data-tech-tooltip=""]::before,
  .skill-icon-wrap[data-tech-tooltip=""]::after {
    display: none !important;
  }

  .quick-picks-container {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.3)
      transparent;
  }

  .skill-quick-chip {
    cursor: pointer;
    transition: all 0.15s ease;
    background: rgba(var(--card-bg-rgb, 26, 13, 36), 0.7) !important;
    border-color: var(--border-glass-subtle) !important;
  }

  .skill-quick-chip:hover {
    color: var(--color-secondary) !important;
    border-color: var(--color-secondary) !important;
    background: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.18) !important;
    transform: translateY(-1px);
  }

  .glass-modal {
    background: rgba(18, 20, 28, 0.94) !important;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  /* Markdown Editor Styles - Refined Dark Glassmorphism */
  .md-editor-container {
    background: rgba(14, 16, 24, 0.78) !important;
    border: 1px solid rgba(var(--color-secondary-rgb, 155, 93, 229), 0.35) !important;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .md-editor-container:focus-within {
    border-color: rgba(
      var(--color-secondary-rgb, 155, 93, 229),
      0.7
    ) !important;
    box-shadow: 0 0 20px rgba(var(--color-secondary-rgb, 155, 93, 229), 0.22);
  }

  /* Fullscreen Immersive Focus Mode */
  .md-editor-container.is-fullscreen {
    position: fixed !important;
    top: 20px !important;
    left: 20px !important;
    right: 20px !important;
    bottom: 20px !important;
    z-index: 1090 !important;
    max-height: calc(100vh - 40px) !important;
    height: calc(100vh - 40px) !important;
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.95),
