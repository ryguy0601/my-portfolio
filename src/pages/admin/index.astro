---
// src/pages/admin/index.astro
import AdminLayout from "../../layouts/AdminLayout.astro";
import { supabase, getAdminCounts } from "../../utils/supabase";
import {
  getTechInfo,
  parseTechStack,
  techIconMap,
} from "../../utils/techIcons";
import { slugify, splitCommaList } from "../../utils/text";
import {
  formatImagePaths,
  extractFolderAndFilenames,
} from "../../utils/projects";
import { extractUniqueCategories } from "../../utils/skills";

let errorMessage = "";
let successMessage = "";

const url = new URL(Astro.request.url);
const editProjectId = url.searchParams.get("edit_project");

// 1. HANDLE CRUD & AJAX SUBMISSIONS
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const actionType = formData.get("action_type")?.toString();

  try {
    // Background inline skill creation via fetch()
    if (actionType === "create_skill_ajax") {
      const name = formData.get("name")?.toString()?.trim();
      const category = formData.get("category")?.toString()?.trim();

      if (!name || !category) {
        return new Response(
          JSON.stringify({ success: false, error: "Missing name or category" }),
          {
            status: 400,
            headers: { "Content-Type": "application/json" },
          },
        );
      }

      const { data, error } = await supabase
        .from("skills")
        .insert([{ name, category, order_index: 0 }])
        .select();
      if (error) {
        return new Response(
          JSON.stringify({ success: false, error: error.message }),
          {
            status: 500,
            headers: { "Content-Type": "application/json" },
          },
        );
      }

      return new Response(JSON.stringify({ success: true, skill: data?.[0] }), {
        status: 200,
        headers: { "Content-Type": "application/json" },
      });
    }

    if (actionType === "save_project") {
      const projectId = formData.get("project_id")?.toString();
      const title = formData.get("title")?.toString();
      const summary = formData.get("summary")?.toString();
      const content = formData.get("content")?.toString();
      const live_url = formData.get("live_url")?.toString();
      const github_url = formData.get("github_url")?.toString();
      const featured = formData.get("featured") === "on";

      const techEntries = formData
        .getAll("tech_stack[]")
        .map((t) => t.toString().trim())
        .filter(Boolean);
      const tech_stack = techEntries.join(", ");

      const image_folder = formData.get("image_folder")?.toString() || "";
      const imageFilenamesArray = formData
        .getAll("image_filenames[]")
        .map((f) => f.toString().trim())
        .filter(Boolean);
      const formattedImagePaths = formatImagePaths(
        image_folder,
        imageFilenamesArray,
      );

      if (!title || !summary || !tech_stack) {
        errorMessage =
          "Title, Summary, and at least one Technology are required.";
      } else {
        const payload = {
          title,
          slug: slugify(title),
          summary,
          content: content || null,
          tech_stack,
          live_url: live_url || null,
          github_url: github_url || null,
          featured,
          image_url:
            formattedImagePaths.length > 0 ? formattedImagePaths[0] : null,
          image_filenames:
            formattedImagePaths.length > 0 ? formattedImagePaths : null,
        };

        if (projectId) {
          const { error } = await supabase
            .from("projects")
            .update(payload)
            .eq("id", projectId);
          if (error) throw error;
          return Astro.redirect("/admin");
        } else {
          const { error } = await supabase.from("projects").insert([payload]);
          if (error) throw error;
          successMessage = "Project saved successfully!";
        }
      }
    } else if (actionType === "delete_project") {
      const id = formData.get("id")?.toString();
      await supabase.from("project_experience").delete().eq("project_id", id);
      const { error } = await supabase.from("projects").delete().eq("id", id);
      if (error) throw error;
      return Astro.redirect("/admin");
    }
  } catch (err: any) {
    errorMessage = err.message || "An unexpected database error occurred.";
  }
}

// 2. FETCH PROJECTS, SKILLS, AND COUNTS DIRECTLY FROM DB
const [{ data: projects }, { data: skillsData }, adminCounts] =
  await Promise.all([
    supabase.from("projects").select("*").order("id", { ascending: false }),
    supabase
      .from("skills")
      .select("name, category")
      .order("category", { ascending: true })
      .order("name", { ascending: true }),
    getAdminCounts(),
  ]);

const existingSkills = skillsData || [];
const dbCategories = extractUniqueCategories(existingSkills);

let editProject = editProjectId
  ? projects?.find((p) => String(p.id) === String(editProjectId))
  : null;

let existingFolder = "";
let existingFilenamesList: string[] = [""];
let existingTechList: string[] = [""];

if (editProject) {
  if (editProject.tech_stack) {
    const items = splitCommaList(editProject.tech_stack);
    if (items.length > 0) existingTechList = items;
  }
  const extracted = extractFolderAndFilenames(editProject.image_filenames);
  existingFolder = extracted.folder;
  existingFilenamesList = extracted.filenames;
}
---

<AdminLayout
  activePage="projects"
  title="Manage Projects"
  errorMessage={errorMessage}
  successMessage={successMessage}
  counts={adminCounts}
>
  <div class="d-flex flex-column gap-4">
    <!-- JSON Payloads for Client Scripts -->
    <script
      type="application/json"
      id="admin-skills-data"
      set:html={JSON.stringify(existingSkills)}
    />
    <script
      type="application/json"
      id="admin-categories-data"
      set:html={JSON.stringify(dbCategories)}
    />
    <script
      type="application/json"
      id="admin-icon-map"
      set:html={JSON.stringify(techIconMap)}
    />

    <!-- Project Form Card -->
    <div class="card bg-card border border-secondary p-4 rounded-4 shadow-sm">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-gradient h5 mb-0 fw-bold">
          {editProject ? `Editing: ${editProject.title}` : "Add New Project"}
        </h3>
        {
          editProject && (
            <a href="/admin" class="btn btn-outline-secondary btn-sm">
              <i class="bi bi-x-circle me-1"></i>Cancel Edit
            </a>
          )
        }
      </div>

      <form method="POST">
        <input type="hidden" name="action_type" value="save_project" />
        {
          editProject && (
            <input type="hidden" name="project_id" value={editProject.id} />
          )
        }

        <div class="row g-3">
          <div class="col-lg-4">
            <label class="form-label text-light small">Project Title *</label>
            <input
              type="text"
              name="title"
              value={editProject?.title || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="Project Name"
              required
            />
          </div>
          <div class="col-lg-4">
            <label class="form-label text-light small">Live Demo URL</label>
            <input
              type="url"
              name="live_url"
              value={editProject?.live_url || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="https://..."
            />
          </div>
          <div class="col-lg-4">
            <label class="form-label text-light small">GitHub URL</label>
            <input
              type="url"
              name="github_url"
              value={editProject?.github_url || ""}
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              placeholder="https://github.com/..."
            />
          </div>

          <div class="col-12">
            <label class="form-label text-light small"
              >Summary Description (Enter lines for bullets) *</label
            >
            <textarea
              name="summary"
              class="form-control form-control-sm bg-dark text-light border-secondary muted-placeholder"
              rows="2"
              placeholder="Key bullet points (e.g. Architected microservices, integrated Supabase auth)..."
              required>{editProject?.summary || ""}</textarea
            >
          </div>

          <!-- Markdown Content Editor -->
          <div class="col-12">
            <div
              id="md-editor-main-container"
              class="md-editor-container rounded-3 border border-secondary border-opacity-50 overflow-hidden bg-black bg-opacity-40 shadow-sm"
            >
              <!-- Top Bar: Title & View Switcher -->
              <div
                class="md-editor-header d-flex flex-wrap justify-content-between align-items-center p-2 px-3 border-bottom border-secondary border-opacity-50 bg-dark bg-opacity-75 gap-2"
              >
                <div class="d-flex align-items-center gap-2">
                  <label
                    for="markdown-editor-textarea"
                    class="form-label text-light small fw-bold mb-0 d-flex align-items-center gap-2"
                  >
                    <i class="bi bi-file-earmark-code text-accent"></i>
                    <span>Full Content / Architecture Notes</span>
                  </label>
                  <span
                    class="badge rounded-pill bg-black border border-secondary text-secondary font-monospace"
                    style="font-size: 0.65rem;"
                  >
                    Markdown Supported
                  </span>
                  <span
                    id="md-readme-active-badge"
                    class="badge rounded-pill bg-dark border border-info text-info font-monospace d-none"
                    style="font-size: 0.65rem;"
                  >
                    <i class="bi bi-link-45deg me-1"></i>README URL Active
                  </span>
                </div>

                <div class="d-flex align-items-center gap-2">
                  <span
                    id="md-char-count"
                    class="text-muted font-monospace small d-none d-sm-inline"
                    style="font-size: 0.7rem;">0 words • 0 chars</span
                  >

                  <div
                    class="btn-group btn-group-sm"
                    role="group"
                    aria-label="Editor View"
                  >
                    <button
                      type="button"
                      class="btn btn-sm active py-0 px-2 md-view-btn"
                      id="md-view-write"
                      title="Write Mode"
                    >
                      <i class="bi bi-pencil me-1"></i>Write
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm py-0 px-2 md-view-btn"
                      id="md-view-preview"
                      title="Preview Mode"
                    >
                      <i class="bi bi-eye me-1"></i>Preview
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm py-0 px-2 d-none d-md-inline-block md-view-btn"
                      id="md-view-split"
                      title="Split Screen Mode"
                    >
                      <i class="bi bi-columns-gap me-1"></i>Split
                    </button>
                  </div>

                  <button
                    type="button"
                    class="btn btn-sm py-0 px-2 ms-1 md-btn-fullscreen"
                    id="md-btn-fullscreen"
                    title="Toggle Fullscreen Focus Mode"
                  >
                    <i class="bi bi-arrows-fullscreen" id="md-fullscreen-icon"
                    ></i>
                  </button>
                </div>
              </div>

              <!-- Format Action Toolbar -->
              <div
                id="md-action-toolbar"
                class="md-editor-toolbar d-flex flex-wrap align-items-center justify-content-between gap-1 p-1 px-2 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-40"
              >
                <div class="d-flex flex-wrap align-items-center gap-1">
                  <!-- Text Styling -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="bold"
                      title="Bold (**text**)"
                    >
                      <i class="bi bi-type-bold"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="italic"
                      title="Italic (*text*)"
                    >
                      <i class="bi bi-type-italic"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="strike"
                      title="Strikethrough (~~text~~)"
                    >
                      <i class="bi bi-type-strikethrough"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Headings -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h1"
                      title="Heading 1 (# Heading)"
                    >
                      <i class="bi bi-type-h1"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h2"
                      title="Heading 2 (## Heading)"
                    >
                      <i class="bi bi-type-h2"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="h3"
                      title="Heading 3 (### Heading)"
                    >
                      <i class="bi bi-type-h3"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Lists & Blocks -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="bullet"
                      title="Bullet List (- item)"
                    >
                      <i class="bi bi-list-ul"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="numbered"
                      title="Numbered List (1. item)"
                    >
                      <i class="bi bi-list-ol"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="task"
                      title="Task List (- [ ] item)"
                    >
                      <i class="bi bi-check2-square"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="quote"
                      title="Quote (> quote)"
                    >
                      <i class="bi bi-quote"></i>
                    </button>
                  </div>

                  <span
                    class="vr mx-1 bg-secondary opacity-50"
                    style="height: 16px;"></span>

                  <!-- Code & Insertions -->
                  <div class="btn-group btn-group-sm">
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="inline-code"
                      title="Inline Code (`code`)"
                    >
                      <i class="bi bi-code"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="code-block"
                      title="Code Block (```)"
                    >
                      <i class="bi bi-code-square"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="link"
                      title="Link ([title](url))"
                    >
                      <i class="bi bi-link-45deg"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="image"
                      title="Image (![alt](url))"
                    >
                      <i class="bi bi-image"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="table"
                      title="Table"
                    >
                      <i class="bi bi-table"></i>
                    </button>
                    <button
                      type="button"
                      class="btn btn-sm md-btn"
                      data-action="hr"
                      title="Horizontal Line (---)"
                    >
                      <i class="bi bi-hr"></i>
                    </button>
                  </div>
                </div>

                <!-- Special README & Action Tools -->
                <div class="d-flex align-items-center gap-1 ms-auto">
                  <button
                    type="button"
                    class="btn btn-sm md-btn-readme px-2 py-1 d-inline-flex align-items-center gap-1"
                    id="md-toggle-readme-btn"
                    title="Fetch or link GitHub README"
                  >
                    <i class="bi bi-github"></i>
                    <span>Import README</span>
                  </button>
                  <button
                    type="button"
                    class="btn btn-sm md-btn"
                    id="md-btn-clear"
                    title="Clear content"
                  >
                    <i class="bi bi-trash3"></i>
                  </button>
                </div>
              </div>

              <!-- Collapsible README Import / Sync Drawer -->
              <div
                id="md-readme-drawer"
                class="p-3 border-bottom border-secondary border-opacity-50 bg-black bg-opacity-70 d-none"
              >
                <div
                  class="d-flex align-items-center justify-content-between mb-2"
                >
                  <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-github text-accent fs-5"></i>
                    <span class="text-light small fw-bold"
                      >Load README from GitHub or URL</span
                    >
                  </div>
                  <button
                    type="button"
                    class="btn-close btn-close-white small"
                    id="md-readme-close-btn"
                    aria-label="Close"></button>
                </div>

                <div class="input-group input-group-sm mb-2">
                  <span
                    class="input-group-text bg-dark border-secondary text-muted font-monospace"
                    style="font-size: 0.72rem;">URL</span
                  >
                  <input
                    type="url"
                    id="md-readme-url-input"
                    class="form-control bg-dark text-light border-secondary muted-placeholder font-monospace"
                    placeholder="https://github.com/owner/repo or raw.githubusercontent.com/.../README.md"
                  />
                  <button
                    type="button"
                    class="btn btn-sm md-drawer-btn"
                    id="md-use-project-github-btn"
                    title="Fill from project GitHub URL above"
                  >
                    <i class="bi bi-arrow-down-left me-1"></i>From Project
                  </button>
                  <button
                    type="button"
                    class="btn btn-primary px-3"
                    id="md-fetch-readme-btn"
                  >
                    <span
                      id="md-fetch-spinner"
                      class="spinner-border spinner-border-sm me-1 d-none"
                      role="status"></span>
                    <i class="bi bi-cloud-arrow-down me-1" id="md-fetch-icon"
                    ></i>Fetch &amp; Insert
                  </button>
                </div>

                <div
                  class="d-flex justify-content-between align-items-center flex-wrap gap-2"
                >
                  <div class="text-muted small" style="font-size: 0.73rem;">
                    <i class="bi bi-info-circle me-1 text-accent"></i>Tip: You
                    can also just paste the README link directly into the text
                    box below.
                  </div>
                  <div
                    class="form-check form-check-inline mb-0"
                    style="font-size: 0.75rem;"
                  >
                    <input
                      class="form-check-input"
                      type="checkbox"
                      id="md-readme-append-check"
                    />
                    <label
                      class="form-check-label text-muted"
                      for="md-readme-append-check"
                      >Append (keep existing text)</label
                    >
                  </div>
                </div>

                <div
                  id="md-readme-status"
                  class="small mt-2 p-2 rounded-2 d-none"
                >
                </div>
              </div>

              <!-- Main Editor Workspace (Write Pane & Preview Pane) -->
              <div
                class="md-editor-workspace d-flex position-relative"
                id="md-workspace"
              >
                <div class="md-pane-write flex-grow-1 w-100" id="md-pane-write">
                  <textarea
                    id="markdown-editor-textarea"
                    name="content"
                    class="form-control bg-transparent text-light border-0 font-monospace md-textarea p-3 muted-placeholder"
                    rows="9"
                    placeholder="### Architectural Highlights

Detailed write-up of engineering decisions, technical trade-offs, and outcomes...

- High-throughput event processing
- Relational database modeling with PostgreSQL

(Or paste a README.md link directly here)"
                    >{editProject?.content || ""}</textarea
                  >
                </div>
                <div
                  class="md-pane-preview flex-grow-1 w-100 d-none p-3 overflow-auto markdown-content"
                  id="md-pane-preview"
                  style="min-height: 240px; max-height: 500px;"
                >
                  <span class="text-muted fst-italic small"
                    >Nothing to preview yet. Start typing markdown or paste a
                    README link!</span
                  >
                </div>
              </div>
            </div>
          </div>

          <!-- Technologies Input Repeater -->
          <div class="col-lg-6">
            <div
              class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100"
            >
              <div
                class="d-flex justify-content-between align-items-center mb-2"
              >
                <div>
                  <label class="form-label text-accent small fw-bold mb-0"
                    >Technologies *</label
                  >
                  <span class="text-muted d-block" style="font-size: 0.72rem;"
                    >Autocompletes skills; prompts modal if missing in DB</span
                  >
                </div>
                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm py-0 px-2"
                  id="add-tech-btn"
                ><i class="bi bi-plus-circle me-1"></i>Add Tech</button>
              </div>

              <!-- Quick Skill Picks (Matching skills.astro 1-Click Pickers) -->
              {
                existingSkills.length > 0 && (
                  <div class="mb-2 p-2 rounded-3 border border-secondary border-opacity-50 bg-black bg-opacity-30">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span
                        class="text-muted small font-monospace"
                        style="font-size: 0.7rem;"
                      >
                        Quick Picks from Skills:
                      </span>
                      <span
                        id="quick-picks-filter-hint"
                        class="text-muted small"
                        style="font-size: 0.65rem;"
                      >
                        Click to add • filters as you type
                      </span>
                    </div>
                    <div
                      id="quick-picks-container"
                      class="d-flex flex-wrap gap-1 align-items-center quick-picks-container"
                      style="max-height: 84px; overflow-y: auto;"
                    >
                      {existingSkills.map((s) => {
                        const tInfo = getTechInfo(s.name);
                        return (
                          <button
                            type="button"
                            class="skill-quick-chip badge rounded-pill bg-dark border border-secondary text-secondary d-inline-flex align-items-center gap-1 py-1 px-2"
                            data-skill-name={s.name}
                            data-tech-tooltip={s.name}
                            title={s.name}
                          >
                            <span
                              class="skill-icon-wrap d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                              style="width: 14px; height: 14px; border: none; background: transparent;"
                            >
                              {tInfo.hasIcon ? (
                                <img
                                  src={tInfo.iconUrl}
                                  alt={s.name}
                                  class="tech-icon-img"
                                  style="width: 11px; height: 11px;"
                                  loading="lazy"
                                />
                              ) : (
                                <span style="font-size: 0.55rem;">●</span>
                              )}
                            </span>
                            <span style="font-size: 0.72rem;">{s.name}</span>
                          </button>
                        );
                      })}
                      <div
                        id="no-quick-picks-msg"
                        class="text-muted small fst-italic d-none p-1"
                        style="font-size: 0.72rem;"
                      >
                        No matching skills found in database.
                      </div>
                    </div>
                  </div>
                )
              }

              <div id="tech-inputs-container" class="d-flex flex-column gap-2">
                {
                  existingTechList.map((tech) => {
                    const techInfo = getTechInfo(tech);
                    return (
                      <div class="tech-row position-relative">
                        <div class="d-flex align-items-center gap-2">
                          <div
                            class="skill-icon-wrap position-relative d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                            data-tech-tooltip={tech || ""}
                            title={tech || ""}
                          >
                            {techInfo.hasIcon ? (
                              <img
                                src={techInfo.iconUrl}
                                alt={tech}
                                class="tech-icon-img"
                                loading="lazy"
                              />
                            ) : (
                              <span
                                class="text-muted font-monospace small"
                                style="font-size: 0.65rem;"
                              >
                                txt
                              </span>
                            )}
                          </div>
                          <div class="input-group input-group-sm flex-grow-1">
                            <input
                              type="text"
                              name="tech_stack[]"
                              value={tech}
                              class="form-control bg-dark text-light border-secondary muted-placeholder tech-stack-input"
                              placeholder="e.g., C#, React"
                              autocomplete="off"
                              required
                            />
                            <button
                              type="button"
                              class="btn btn-outline-danger remove-input-btn"
                              title="Remove item"
                            >
                              <i class="bi bi-trash3"></i>
                            </button>
                          </div>
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>

          <!-- Screenshots Input Repeater -->
          <div class="col-lg-6">
            <div
              class="p-3 bg-dark bg-opacity-50 border border-secondary rounded-3 h-100"
            >
              <div
                class="d-flex justify-content-between align-items-center mb-2"
              >
                <label class="form-label text-accent small fw-bold mb-0"
                  >Image Assets</label
                >
                <button
                  type="button"
                  class="btn btn-outline-primary btn-sm py-0 px-2"
                  id="add-image-btn"
                ><i class="bi bi-plus-circle me-1"></i>Add Picture</button>
              </div>
              <input
                type="text"
                name="image_folder"
                value={existingFolder}
                class="form-control form-control-sm bg-dark text-light border-secondary mb-2 muted-placeholder"
                placeholder="Folder path e.g. /images/projects/demo"
              />
              <div id="image-inputs-container" class="d-flex flex-column gap-2">
                {
                  existingFilenamesList.map((file) => (
                    <div class="input-group input-group-sm">
                      <input
                        type="text"
                        name="image_filenames[]"
                        value={file}
                        class="form-control bg-dark text-light border-secondary muted-placeholder"
                        placeholder="screen1.png"
                      />
                      <button
                        type="button"
                        class="btn btn-outline-danger remove-input-btn"
                        title="Remove item"
                      >
                        <i class="bi bi-trash3"></i>
                      </button>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            class="col-12 d-flex align-items-center justify-content-between pt-2"
          >
            <div class="form-check">
              <input
                type="checkbox"
                name="featured"
                class="form-check-input bg-dark border-secondary"
                id="featuredCheck"
                checked={editProject?.featured}
              />
              <label
                class="form-check-label text-light small"
                for="featuredCheck">Feature on Homepage</label
              >
            </div>
            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">
              <i class="bi bi-floppy me-2"></i>{editProject ? "Update Project" : "Save Project to Database"}
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Active Projects Grid -->
    <div>
      <h4 class="text-light h6 mb-3 fw-bold">
        Active Portfolio Projects ({projects?.length || 0})
      </h4>
      <div
        class="scroll-grid-container p-2 border border-secondary border-opacity-25 rounded-4 bg-dark bg-opacity-25"
      >
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          {
            projects &&
              projects.map((project) => (
                <div class="col">
                  <div
                    class={`card bg-card border ${editProjectId == project.id ? "border-primary" : "border-secondary"} p-3 rounded-3 h-100 d-flex flex-column justify-content-between`}
                  >
                    <div>
                      <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h6 class="text-primary fw-bold mb-0 text-truncate">
                          {project.title}
                        </h6>
                        {project.featured && (
                          <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small">
                            Featured
                          </span>
                        )}
                      </div>
                      <p class="text-muted small line-clamp-2 mb-2">
                        {project.summary}
                      </p>
                      <div class="d-flex flex-wrap gap-1 align-items-center mb-3">
                        {project.tech_stack &&
                          parseTechStack(project.tech_stack).map((tech) => (
                            <div
                              class="skill-icon-wrap position-relative d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                              title={tech.name}
                              data-tech-tooltip={tech.name}
                            >
                              {tech.hasIcon ? (
                                <img
                                  src={tech.iconUrl}
                                  alt={tech.name}
                                  class="tech-icon-img"
                                  loading="lazy"
                                />
                              ) : (
                                <span
                                  class="text-muted font-monospace small"
                                  style="font-size: 0.65rem;"
                                >
                                  txt
                                </span>
                              )}
                            </div>
                          ))}
                        <span
                          class="font-monospace text-accent small ms-1 text-truncate"
                          style="max-width: 140px;"
                          title={project.tech_stack}
                        >
                          {project.tech_stack}
                        </span>
                      </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
                      <a
                        href={`/admin?edit_project=${project.id}`}
                        class="btn btn-outline-primary btn-sm py-0 px-2"
                      >
                        <i class="bi bi-pencil me-1"></i>Edit
                      </a>
                      <form
                        method="POST"
                        onsubmit="return confirm('Delete this project?');"
                        class="m-0"
                      >
                        <input
                          type="hidden"
                          name="action_type"
                          value="delete_project"
                        />
                        <input type="hidden" name="id" value={project.id} />
                        <button
                          type="submit"
                          class="btn btn-outline-danger btn-sm py-0 px-2"
                        >
                          <i class="bi bi-trash3 me-1"></i>Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- New Skill Category Modal -->
  <div
    class="modal fade"
    id="addSkillModal"
    tabindex="-1"
    aria-labelledby="addSkillModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div
        class="modal-content glass-modal border border-secondary text-light rounded-4 shadow-lg"
      >
        <div class="modal-header border-secondary border-opacity-50 pb-2">
          <div class="d-flex align-items-center gap-2">
            <span
              class="badge rounded-circle p-2 bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50"
              >+</span
            >
            <h5 class="modal-title h6 mb-0 fw-bold" id="addSkillModalLabel">
              Add New Skill to Database
            </h5>
          </div>
          <button
            type="button"
            class="btn-close btn-close-white"
            data-bs-dismiss="modal"
            aria-label="Close"></button>
        </div>
        <div class="modal-body py-3">
          <p class="small text-muted mb-3">
            <strong class="text-light" id="modal-skill-name-display"
              >Skill</strong
            > was not found in your database. Pick one of your existing database categories
            or create a new one.
          </p>

          <div class="mb-3" id="modal-category-select-group">
            <label class="form-label text-accent small fw-semibold"
              >Database Category</label
            >
            <select
              class="form-select form-select-sm bg-dark text-light border-secondary"
              id="modal-category-select"
            >
              <!-- Strictly filled from DB categories -->
            </select>
          </div>

          <div id="modal-new-category-wrap" class="d-none">
            <label class="form-label text-accent small fw-semibold"
              >New Category Name *</label
            >
            <input
              type="text"
              id="modal-new-category-input"
              class="form-control form-control-sm bg-dark text-light border-secondary"
              placeholder="e.g. Mobile Development"
            />
          </div>
        </div>
        <div class="modal-footer border-secondary border-opacity-50 pt-2">
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm"
            data-bs-dismiss="modal"
          ><i class="bi bi-x-circle me-1"></i>Cancel</button>
          <button
            type="button"
            class="btn btn-primary btn-sm px-3"
            id="modal-save-skill-btn"
          ><i class="bi bi-plus-circle me-1"></i>Save to Skills</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .skill-icon-wrap {
    width: 28px;
    height: 28px;
    background: var(--border-glass-minimal);
    border: 1px solid var(--border-glass-subtle);
    position: relative;
  }

  .tech-icon-img {
    width: 16px;
    height: 16px;
    filter: brightness(0) invert(1);
    opacity: 0.9;
    vertical-align: middle;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  /* Floating Monospace Capsule Tooltip (matching TechBadgeList design) */
  .skill-icon-wrap[data-tech-tooltip]::before,
  .skill-quick-chip[data-tech-tooltip]::before {
    content: attr(data-tech-tooltip);
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%) translateY(4px) scale(0.92);
    transform-origin: bottom center;
    background: linear-gradient(
      135deg,
      rgba(var(--card-bg-rgb, 26, 13, 36), 0.96),
      rgba(var(--overlay-dark-rgb, 10, 5, 4), 0.98)
    );
    color: var(--body-color, #fff5fc);
    border: 1px solid rgba(var(--color-secondary-rgb, 155, 93, 229), 0.45);
    border-radius: var(--radius-pill, 9999px);
    padding: var(--badge-tooltip-padding, 3px 10px);
    font-size: 0.72rem;
    font-weight: 500;
    font-family: var(--bs-font-monospace, monospace);
    white-space: nowrap;
    letter-spacing: 0.03em;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0.2s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow-tooltip, 0 8px 24px rgba(0, 0, 0, 0.8));
    z-index: 1070;
  }

  /* Micro Arrow Pointing Down to Icon */
  .skill-icon-wrap[data-tech-tooltip]::after,
  .skill-quick-chip[data-tech-tooltip]::after {
    content: "";
    position: absolute;
    bottom: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    border-width: 5px 4.5px 0 4.5px;
    border-style: solid;
    border-color: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.45)
      transparent transparent transparent;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1),
      visibility 0.2s ease;
    z-index: 1070;
  }

  .skill-icon-wrap[data-tech-tooltip]:hover::before,
  .skill-icon-wrap[data-tech-tooltip]:hover::after,
  .skill-quick-chip[data-tech-tooltip]:hover::before,
  .skill-quick-chip[data-tech-tooltip]:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0) scale(1);
  }

  .skill-icon-wrap[data-tech-tooltip=""]::before,
  .skill-icon-wrap[data-tech-tooltip=""]::after {
    display: none !important;
  }

  .quick-picks-container {
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.3)
      transparent;
  }

  .skill-quick-chip {
    cursor: pointer;
    transition: all 0.15s ease;
    background: rgba(var(--card-bg-rgb, 26, 13, 36), 0.7) !important;
    border-color: var(--border-glass-subtle) !important;
  }

  .skill-quick-chip:hover {
    color: var(--color-secondary) !important;
    border-color: var(--color-secondary) !important;
    background: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.18) !important;
