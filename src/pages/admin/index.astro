  }

  .markdown-content th {
    background: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.18);
    color: #ffffff;
    font-weight: 600;
  }

  .markdown-content a {
    color: var(--color-primary-light, #ff79c6);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .markdown-content a:hover {
    color: #ffffff;
  }

  .markdown-content hr {
    border-color: rgba(var(--color-secondary-rgb, 155, 93, 229), 0.3);
    margin: 1.8rem 0;
    opacity: 0.6;
  }
</style>

<script>
  import { marked } from "marked";
  import { ReadmeService, isReadmeUrl } from "../../services/readmeService";
  import { SmartEditorService } from "../../services/smartEditorService";
  declare const bootstrap: any;

  document.addEventListener("DOMContentLoaded", () => {
    const skillsScript = document.getElementById("admin-skills-data");
    const categoriesScript = document.getElementById("admin-categories-data");
    const iconMapScript = document.getElementById("admin-icon-map");

    let skillsList: Array<{ name: string; category: string }> = JSON.parse(
      skillsScript ? skillsScript.textContent || "[]" : "[]",
    );
    let dbCategories: string[] = JSON.parse(
      categoriesScript ? categoriesScript.textContent || "[]" : "[]",
    );
    const iconMap: Record<string, string> = JSON.parse(
      iconMapScript ? iconMapScript.textContent || "{}" : "{}",
    );

    let pendingSkillName = "";
    let pendingInputEl: HTMLInputElement | null = null;

    // Modal elements
    const modalEl = document.getElementById("addSkillModal");
    const modalInstance =
      modalEl && typeof bootstrap !== "undefined"
        ? new bootstrap.Modal(modalEl)
        : null;
    const modalSkillNameDisplay = document.getElementById(
      "modal-skill-name-display",
    );
    const modalCatSelect = document.getElementById(
      "modal-category-select",
    ) as HTMLSelectElement | null;
    const modalNewCatWrap = document.getElementById("modal-new-category-wrap");
    const modalNewCatInput = document.getElementById(
      "modal-new-category-input",
    ) as HTMLInputElement | null;
    const modalSaveBtn = document.getElementById("modal-save-skill-btn");

    function resolveIconUrl(name: string): { hasIcon: boolean; url: string } {
      const clean = name.trim().toLowerCase();
      const entry = iconMap[clean];
      if (!entry) return { hasIcon: false, url: "" };

      if (entry.startsWith("data:")) {
        return { hasIcon: true, url: entry };
      }
      if (entry.startsWith("bi:")) {
        return {
          hasIcon: true,
          url: `https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/${entry.replace("bi:", "")}.svg`,
        };
      }
      if (entry.startsWith("devicon:")) {
        return {
          hasIcon: true,
          url: `https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${entry.replace("devicon:", "")}.svg`,
        };
      }
      return {
        hasIcon: true,
        url: `https://cdn.jsdelivr.net/npm/simple-icons@v11/icons/${entry.replace("si:", "")}.svg`,
      };
    }

    function updateRowIcon(row: HTMLElement, value: string) {
      const iconWrap = row.querySelector(".skill-icon-wrap");
      if (!iconWrap) return;
      const { hasIcon, url } = resolveIconUrl(value);
      if (hasIcon) {
        iconWrap.innerHTML = `<img src="${url}" alt="${value}" class="tech-icon-img" loading="lazy" />`;
        iconWrap.setAttribute("data-tech-tooltip", value);
        iconWrap.setAttribute("title", value);
      } else {
        iconWrap.innerHTML = `<span class="text-muted font-monospace small" style="font-size: 0.65rem;">txt</span>`;
        if (value.trim()) {
          iconWrap.setAttribute("data-tech-tooltip", value);
          iconWrap.setAttribute("title", value);
        } else {
          iconWrap.removeAttribute("data-tech-tooltip");
          iconWrap.removeAttribute("title");
        }
      }
    }

    function updateRemoveButtons(container: HTMLElement | null) {
      if (!container) return;
      const rows = container.querySelectorAll(".input-group");
      const showButtons = rows.length > 1;
      rows.forEach((row) => {
        const btn = row.querySelector(
          ".remove-input-btn",
        ) as HTMLElement | null;
        if (btn) btn.style.display = showButtons ? "block" : "none";
      });
    }

    function populateModalCategories() {
      if (!modalCatSelect) return;
      modalCatSelect.innerHTML = "";

      if (dbCategories.length === 0) {
        // No existing categories in DB yet -> force new category entry
        const opt = document.createElement("option");
        opt.value = "__new__";
        opt.textContent = "+ Create First Category...";
        modalCatSelect.appendChild(opt);
        modalNewCatWrap?.classList.remove("d-none");
        modalNewCatInput?.focus();
        return;
      }

      // Add actual categories from database
      dbCategories.forEach((cat) => {
        const opt = document.createElement("option");
        opt.value = cat;
        opt.textContent = cat;
        modalCatSelect.appendChild(opt);
      });

      const newOpt = document.createElement("option");
      newOpt.value = "__new__";
      newOpt.textContent = "+ Add New Category...";
      modalCatSelect.appendChild(newOpt);
    }

    if (modalCatSelect) {
      modalCatSelect.addEventListener("change", () => {
        if (modalCatSelect.value === "__new__") {
          modalNewCatWrap?.classList.remove("d-none");
          modalNewCatInput?.focus();
        } else {
          modalNewCatWrap?.classList.add("d-none");
        }
      });
    }

    function openSkillModal(skillName: string, inputEl: HTMLInputElement) {
      pendingSkillName = skillName.trim();
      pendingInputEl = inputEl;
      if (!pendingSkillName) return;

      if (modalSkillNameDisplay)
        modalSkillNameDisplay.textContent = pendingSkillName;
      populateModalCategories();

      if (dbCategories.length > 0) {
        modalNewCatWrap?.classList.add("d-none");
      }
      if (modalNewCatInput) modalNewCatInput.value = "";

      if (modalInstance) {
        modalInstance.show();
      }
    }

    modalSaveBtn?.addEventListener("click", async () => {
      if (!pendingSkillName) return;

      let chosenCategory = modalCatSelect?.value;
      if (chosenCategory === "__new__" || !chosenCategory) {
        chosenCategory = modalNewCatInput?.value?.trim() || "";
      }

      if (!chosenCategory) {
        modalNewCatInput?.focus();
        return;
      }

      try {
        const formData = new FormData();
        formData.append("action_type", "create_skill_ajax");
        formData.append("name", pendingSkillName);
        formData.append("category", chosenCategory);

        const res = await fetch("/admin", {
          method: "POST",
          body: formData,
        });

        const result = await res.json();
        if (result.success) {
          skillsList.push({ name: pendingSkillName, category: chosenCategory });
          if (!dbCategories.includes(chosenCategory)) {
            dbCategories.push(chosenCategory);
            dbCategories.sort();
          }
          if (pendingInputEl) {
            const row = pendingInputEl.closest(
              ".tech-row",
            ) as HTMLElement | null;
            if (row) updateRowIcon(row, pendingSkillName);
          }

          // Add newly registered skill to Quick Picks
          const quickContainer = document.getElementById(
            "quick-picks-container",
          );
          if (quickContainer) {
            const { hasIcon, url } = resolveIconUrl(pendingSkillName);
            const newChip = document.createElement("button");
            newChip.type = "button";
            newChip.className =
              "skill-quick-chip badge rounded-pill bg-dark border border-secondary text-secondary d-inline-flex align-items-center gap-1 py-1 px-2";
            newChip.setAttribute("data-skill-name", pendingSkillName);
            newChip.setAttribute("data-tech-tooltip", pendingSkillName);
            newChip.title = pendingSkillName;
            newChip.innerHTML = `
              <span class="skill-icon-wrap d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 14px; height: 14px; border: none; background: transparent;">
                ${
                  hasIcon
                    ? `<img src="${url}" alt="${pendingSkillName}" class="tech-icon-img" style="width: 11px; height: 11px;" loading="lazy" />`
                    : `<span style="font-size: 0.55rem;">●</span>`
                }
              </span>
              <span style="font-size: 0.72rem;">${pendingSkillName}</span>
            `;
            bindQuickChip(newChip);
            const noMatchEl = document.getElementById("no-quick-picks-msg");
            if (noMatchEl) {
              quickContainer.insertBefore(newChip, noMatchEl);
            } else {
              quickContainer.appendChild(newChip);
            }
          }
          filterQuickPicks("");

          if (modalInstance) modalInstance.hide();
        }
      } catch (err) {
        console.error("Failed to auto-save skill:", err);
      }
    });

    let activeTechInput: HTMLInputElement | null = null;

    function filterQuickPicks(filterText: string) {
      const query = filterText.trim().toLowerCase();
      const chips = document.querySelectorAll<HTMLElement>(".skill-quick-chip");
      let visibleCount = 0;

      chips.forEach((chip) => {
        const skillName = chip.getAttribute("data-skill-name") || "";
        const match = !query || skillName.toLowerCase().includes(query);
        if (match) {
          chip.classList.remove("d-none");
          visibleCount++;
        } else {
          chip.classList.add("d-none");
        }
      });

      const noMatchEl = document.getElementById("no-quick-picks-msg");
      const hintEl = document.getElementById("quick-picks-filter-hint");

      if (hintEl) {
        if (query) {
          hintEl.textContent = `Filtering: "${filterText.trim()}" (${visibleCount} match${visibleCount === 1 ? "" : "es"})`;
        } else {
          hintEl.textContent = "Click to add • filters as you type";
        }
      }

      if (noMatchEl) {
        if (visibleCount === 0 && query.length > 0) {
          noMatchEl.textContent = `No saved skills match "${filterText.trim()}". Press Enter or Tab to register it.`;
          noMatchEl.classList.remove("d-none");
        } else {
          noMatchEl.classList.add("d-none");
        }
      }
    }

    function setupTechInputRow(row: HTMLElement) {
      const inputEl = row.querySelector(
        ".tech-stack-input",
      ) as HTMLInputElement | null;
      if (!inputEl) return;
      const input: HTMLInputElement = inputEl;

      input.addEventListener("input", () => {
        activeTechInput = input;
        updateRowIcon(row, input.value);
        filterQuickPicks(input.value);
      });

      input.addEventListener("focus", () => {
        activeTechInput = input;
        filterQuickPicks(input.value);
      });

      input.addEventListener("blur", () => {
        setTimeout(() => {
          if (
            document.activeElement &&
            !document.activeElement.classList.contains("tech-stack-input")
          ) {
            filterQuickPicks("");
          }

          const trimmed = input.value.trim();
          if (!trimmed) return;

          const exists = skillsList.some(
            (s) => s.name.toLowerCase() === trimmed.toLowerCase(),
          );
          if (!exists) {
            openSkillModal(trimmed, input);
          }
        }, 200);
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          const trimmed = input.value.trim();
          if (trimmed) {
            const exists = skillsList.some(
              (s) => s.name.toLowerCase() === trimmed.toLowerCase(),
            );
            if (!exists) {
              openSkillModal(trimmed, input);
            }
          }
        }
      });
    }

    function createInputRow(
      name: string,
      placeholder: string,
      isRequired = false,
      isTech = false,
    ) {
      if (isTech) {
        const row = document.createElement("div");
        row.className = "tech-row position-relative";
        row.innerHTML = `
          <div class="d-flex align-items-center gap-2">
            <div class="skill-icon-wrap position-relative d-flex align-items-center justify-content-center rounded-2 flex-shrink-0">
              <span class="text-muted font-monospace small" style="font-size: 0.65rem;">txt</span>
            </div>
            <div class="input-group input-group-sm flex-grow-1">
              <input 
                type="text" 
                name="${name}" 
                class="form-control bg-dark text-light border-secondary muted-placeholder tech-stack-input" 
                placeholder="${placeholder}" 
                autocomplete="off"
                ${isRequired ? "required" : ""} 
              />
              <button type="button" class="btn btn-outline-danger remove-input-btn" title="Remove item"><i class="bi bi-trash3"></i></button>
            </div>
          </div>
        `;

        const removeBtn = row.querySelector(".remove-input-btn");
        removeBtn?.addEventListener("click", () => {
          const container = row.parentElement;
          row.remove();
          updateRemoveButtons(container);
        });

        setupTechInputRow(row);
        return row;
      } else {
        const row = document.createElement("div");
        row.className = "input-group input-group-sm";
        const input = document.createElement("input");
        input.type = "text";
        input.name = name;
        input.className =
          "form-control bg-dark text-light border-secondary muted-placeholder";
        input.placeholder = placeholder;
        if (isRequired) input.required = true;

        const button = document.createElement("button");
        button.type = "button";
        button.className = "btn btn-outline-danger remove-input-btn";
        button.title = "Remove item";
        button.innerHTML = '<i class="bi bi-trash3"></i>';

        button.addEventListener("click", () => {
          const container = row.parentElement;
          row.remove();
          updateRemoveButtons(container);
        });

        row.appendChild(input);
        row.appendChild(button);
        return row;
      }
    }

    // Initialize existing tech rows
    document
      .querySelectorAll<HTMLElement>(".tech-row")
      .forEach(setupTechInputRow);

    // Initial remove buttons state
    const techContainer = document.getElementById("tech-inputs-container");
    const imageContainer = document.getElementById("image-inputs-container");

    document.querySelectorAll(".remove-input-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const row =
          target.closest(".tech-row") || target.closest(".input-group");
        const container = row?.parentElement as HTMLElement | null;
        row?.remove();
        updateRemoveButtons(container);
      });
    });

    updateRemoveButtons(techContainer);
    updateRemoveButtons(imageContainer);

    function bindQuickChip(btn: HTMLElement) {
      btn.addEventListener("mousedown", (e) => {
        e.preventDefault();
      });

      btn.addEventListener("click", () => {
        const skillName = btn.getAttribute("data-skill-name");
        if (!skillName || !techContainer) return;

        const inputs = Array.from(
          techContainer.querySelectorAll<HTMLInputElement>(".tech-stack-input"),
        );
        let targetInput: HTMLInputElement | null = null;

        if (activeTechInput && activeTechInput.isConnected) {
          const currentVal = activeTechInput.value.trim().toLowerCase();
          const isCompleteSkill = skillsList.some(
            (s) => s.name.toLowerCase() === currentVal,
          );
          if (!currentVal || !isCompleteSkill) {
            targetInput = activeTechInput;
          }
        }

        if (!targetInput) {
          const emptyInput = inputs.find((i) => !i.value.trim());
          if (emptyInput) {
            targetInput = emptyInput;
          } else {
            const alreadyAdded = inputs.some(
              (i) => i.value.trim().toLowerCase() === skillName.toLowerCase(),
            );
            if (alreadyAdded) {
              filterQuickPicks("");
              return;
            }
            const newRow = createInputRow(
              "tech_stack[]",
              "e.g., C#, React",
              true,
              true,
            );
            techContainer.appendChild(newRow);
            updateRemoveButtons(techContainer);
            targetInput =
              newRow.querySelector<HTMLInputElement>(".tech-stack-input");
          }
        }

        if (targetInput) {
          targetInput.value = skillName;
          const row = targetInput.closest(".tech-row") as HTMLElement | null;
          if (row) updateRowIcon(row, skillName);
          targetInput.focus();
          activeTechInput = targetInput;
        }

        filterQuickPicks("");
      });
    }

    // Quick tech chips 1-click addition
    document
      .querySelectorAll<HTMLElement>(".skill-quick-chip")
      .forEach(bindQuickChip);

    document.getElementById("add-tech-btn")?.addEventListener("click", () => {
      if (!techContainer) return;
      const newRow = createInputRow(
        "tech_stack[]",
        "e.g., Supabase",
        true,
        true,
      );
      techContainer.appendChild(newRow);
      updateRemoveButtons(techContainer);
      const input = newRow.querySelector("input");
      if (input) input.focus();
    });

    document.getElementById("add-image-btn")?.addEventListener("click", () => {
      if (!imageContainer) return;
      const newRow = createInputRow(
        "image_filenames[]",
        "screenshot.png",
        false,
        false,
      );
      imageContainer.appendChild(newRow);
      updateRemoveButtons(imageContainer);
      const input = newRow.querySelector("input");
      if (input) input.focus();
    });

    // --- Interactive Markdown Editor ---
    const mdContainer = document.getElementById("md-editor-main-container");
    const mdTextarea = document.getElementById(
      "markdown-editor-textarea",
    ) as HTMLTextAreaElement | null;
    const mdPreview = document.getElementById("md-pane-preview");
    const mdPaneWrite = document.getElementById("md-pane-write");
    const mdViewWrite = document.getElementById("md-view-write");
    const mdViewPreview = document.getElementById("md-view-preview");
    const mdViewSplit = document.getElementById("md-view-split");
    const mdCharCount = document.getElementById("md-char-count");
    const mdToolbar = document.getElementById("md-action-toolbar");
    const mdReadmeBadge = document.getElementById("md-readme-active-badge");
    const mdFullscreenBtn = document.getElementById("md-btn-fullscreen");
    const mdFullscreenIcon = document.getElementById("md-fullscreen-icon");

    // README Drawer Elements
    const mdToggleReadmeBtn = document.getElementById("md-toggle-readme-btn");
    const mdReadmeDrawer = document.getElementById("md-readme-drawer");
    const mdReadmeCloseBtn = document.getElementById("md-readme-close-btn");
    const mdReadmeUrlInput = document.getElementById(
      "md-readme-url-input",
    ) as HTMLInputElement | null;
    const mdUseProjectGithubBtn = document.getElementById(
      "md-use-project-github-btn",
    );
    const mdFetchReadmeBtn = document.getElementById("md-fetch-readme-btn");
    const mdFetchSpinner = document.getElementById("md-fetch-spinner");
    const mdFetchIcon = document.getElementById("md-fetch-icon");
    const mdReadmeAppendCheck = document.getElementById(
      "md-readme-append-check",
    ) as HTMLInputElement | null;
    const mdReadmeStatus = document.getElementById("md-readme-status");
    const mdClearBtn = document.getElementById("md-btn-clear");
    const projectGithubInput = document.querySelector<HTMLInputElement>(
      'input[name="github_url"]',
    );

    let mdCurrentMode: "write" | "preview" | "split" = "write";
    let isFullscreen = false;

    function updateMdCharCount() {
      if (!mdTextarea || !mdCharCount) return;
      const text = mdTextarea.value;
      const chars = text.length;
      const words = text.trim() ? text.trim().split(/\s+/).length : 0;
      mdCharCount.textContent = `${words} word${words === 1 ? "" : "s"} • ${chars} chars`;

      if (mdReadmeBadge) {
        if (isReadmeUrl(text.trim())) {
          mdReadmeBadge.classList.remove("d-none");
        } else {
          mdReadmeBadge.classList.add("d-none");
        }
      }
    }

    let previewDebounceTimer: any = null;

    async function renderMdPreview() {
      if (!mdTextarea || !mdPreview) return;
      const raw = mdTextarea.value.trim();
      if (!raw) {
        mdPreview.innerHTML =
          '<span class="text-muted fst-italic small">Nothing to preview yet. Start typing markdown or paste a README link!</span>';
        return;
      }

      // Check if user entered a README link directly
      if (isReadmeUrl(raw)) {
        mdPreview.innerHTML = `
          <div class="d-flex align-items-center gap-2 text-info small py-3">
            <span class="spinner-border spinner-border-sm" role="status"></span>
            <span>Fetching live README from <code>${raw}</code>...</span>
          </div>
        `;
        const { markdown: text, error } = await ReadmeService.fetchReadme(raw);
        if (text) {
          const html = marked.parse(text, {
            gfm: true,
            breaks: true,
          }) as string;
          mdPreview.innerHTML = `
            <div class="p-2 mb-3 rounded-3 border border-secondary border-opacity-50 bg-black bg-opacity-40 d-flex align-items-center justify-content-between flex-wrap gap-2">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-github text-accent"></i>
                <span class="small text-light font-monospace" style="font-size: 0.75rem;">Live README Linked (${raw})</span>
              </div>
              <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2" id="md-expand-linked-btn" style="font-size: 0.72rem;">
                <i class="bi bi-file-earmark-arrow-down me-1"></i>Load Raw Markdown into Text Box
              </button>
            </div>
            ${html}
          `;
          mdPreview
            .querySelector("#md-expand-linked-btn")
            ?.addEventListener("click", () => {
              if (mdTextarea) {
                mdTextarea.value = text;
                updateMdCharCount();
                renderMdPreview();
              }
            });
        } else {
          mdPreview.innerHTML = `
            <div class="p-3 text-warning small border border-warning border-opacity-25 rounded-3 bg-dark">
              <i class="bi bi-exclamation-triangle me-1"></i>Could not load README from URL: ${error || "Unknown error"}
            </div>
          `;
        }
        return;
      }

      try {
        const html = marked.parse(raw, { gfm: true, breaks: true }) as string;
        mdPreview.innerHTML = html;
      } catch (err) {
        mdPreview.innerHTML = `<div class="text-danger small">Markdown render error: ${err}</div>`;
      }
    }

    function schedulePreviewRender() {
      if (mdCurrentMode === "write") return;
      clearTimeout(previewDebounceTimer);
      previewDebounceTimer = setTimeout(renderMdPreview, 150);
    }

    function setMdMode(mode: "write" | "preview" | "split") {
      mdCurrentMode = mode;
      mdViewWrite?.classList.toggle("active", mode === "write");
      mdViewPreview?.classList.toggle("active", mode === "preview");
      mdViewSplit?.classList.toggle("active", mode === "split");

      if (mode === "write") {
        mdPaneWrite?.classList.remove("d-none", "w-50");
        mdPaneWrite?.classList.add("w-100");
        mdPreview?.classList.add("d-none");
        mdPreview?.classList.remove(
          "w-50",
          "border-start",
          "border-secondary",
          "border-opacity-50",
        );
      } else if (mode === "preview") {
        renderMdPreview();
        mdPaneWrite?.classList.add("d-none");
        mdPaneWrite?.classList.remove("w-50", "w-100");
        mdPreview?.classList.remove("d-none", "w-50");
        mdPreview?.classList.add("w-100");
        mdPreview?.classList.remove(
          "border-start",
          "border-secondary",
          "border-opacity-50",
        );
      } else if (mode === "split") {
        renderMdPreview();
        mdPaneWrite?.classList.remove("d-none", "w-100");
        mdPaneWrite?.classList.add("w-50");
        mdPreview?.classList.remove("d-none", "w-100");
        mdPreview?.classList.add(
          "w-50",
          "border-start",
          "border-secondary",
          "border-opacity-50",
        );
      }
    }

    function toggleFullscreen() {
      isFullscreen = !isFullscreen;
      if (mdContainer) {
        mdContainer.classList.toggle("is-fullscreen", isFullscreen);
      }
      if (mdFullscreenIcon) {
        mdFullscreenIcon.className = isFullscreen
          ? "bi bi-fullscreen-exit"
          : "bi bi-arrows-fullscreen";
      }
    }

    function insertMarkdown(before: string, after = "", defaultText = "") {
      if (!mdTextarea) return;
      SmartEditorService.insertFormatting(
        mdTextarea,
        before,
        after,
        defaultText,
        () => {
          updateMdCharCount();
          schedulePreviewRender();
        }
      );
    }

    if (mdTextarea) {
      updateMdCharCount();

      mdTextarea.addEventListener("input", () => {
        updateMdCharCount();
        schedulePreviewRender();
      });

      // Attach smart list continuation, pair auto-closing, selection wrapping, and tab indentation
      SmartEditorService.attach(mdTextarea, {
        enableAutoList: true,
        enablePairs: true,
        enableSelectionWrap: true,
        enableSmartTab: true,
        enableShortcuts: true,
        indentSize: 2,
        onUpdate: () => {
          updateMdCharCount();
          schedulePreviewRender();
        },
      });

      mdTextarea.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isFullscreen) {
          toggleFullscreen();
        }
      });
    }

    // Also attach smart bullet list continuation to the project summary description textarea
    const summaryInput = document.querySelector<HTMLTextAreaElement>(
      'textarea[name="summary"]'
    );
    if (summaryInput) {
      SmartEditorService.attach(summaryInput, {
        enableAutoList: true,
        enableSmartTab: true,
        enablePairs: false,
        enableShortcuts: false,
      });
    }

    mdViewWrite?.addEventListener("click", () => setMdMode("write"));
    mdViewPreview?.addEventListener("click", () => setMdMode("preview"));
    mdViewSplit?.addEventListener("click", () => setMdMode("split"));
    mdFullscreenBtn?.addEventListener("click", toggleFullscreen);

    mdClearBtn?.addEventListener("click", () => {
      if (!mdTextarea) return;
      if (confirm("Are you sure you want to clear the editor content?")) {
        mdTextarea.value = "";
        updateMdCharCount();
        renderMdPreview();
      }
    });

    // README Drawer Toggling & Fetching
    mdToggleReadmeBtn?.addEventListener("click", () => {
      if (!mdReadmeDrawer) return;
      const isHidden = mdReadmeDrawer.classList.contains("d-none");
      if (isHidden) {
        mdReadmeDrawer.classList.remove("d-none");
        mdToggleReadmeBtn.classList.add("active");
        if (
          mdReadmeUrlInput &&
          !mdReadmeUrlInput.value &&
          projectGithubInput?.value
        ) {
          mdReadmeUrlInput.value = projectGithubInput.value.trim();
        }
        mdReadmeUrlInput?.focus();
      } else {
        mdReadmeDrawer.classList.add("d-none");
        mdToggleReadmeBtn.classList.remove("active");
      }
    });

    mdReadmeCloseBtn?.addEventListener("click", () => {
      mdReadmeDrawer?.classList.add("d-none");
      mdToggleReadmeBtn?.classList.remove("active");
    });

    mdUseProjectGithubBtn?.addEventListener("click", () => {
      if (projectGithubInput?.value && mdReadmeUrlInput) {
        mdReadmeUrlInput.value = projectGithubInput.value.trim();
      }
    });

    mdFetchReadmeBtn?.addEventListener("click", async () => {
      const url = mdReadmeUrlInput?.value.trim();
      if (!url) {
        if (mdReadmeStatus) {
          mdReadmeStatus.className =
            "small mt-2 p-2 rounded-2 bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50";
          mdReadmeStatus.textContent =
            "Please enter a GitHub repository or raw README URL.";
          mdReadmeStatus.classList.remove("d-none");
        }
        return;
      }

      mdFetchSpinner?.classList.remove("d-none");
      mdFetchIcon?.classList.add("d-none");
      if (mdReadmeStatus) mdReadmeStatus.classList.add("d-none");

      const { markdown: text, error } = await ReadmeService.fetchReadme(url);

      mdFetchSpinner?.classList.add("d-none");
      mdFetchIcon?.classList.remove("d-none");

      if (text && mdTextarea) {
        const isAppend = mdReadmeAppendCheck?.checked;
        if (isAppend && mdTextarea.value.trim()) {
          mdTextarea.value = mdTextarea.value.trim() + "\n\n" + text;
        } else {
          mdTextarea.value = text;
        }

        updateMdCharCount();
        renderMdPreview();
        setMdMode("preview");

        if (mdReadmeStatus) {
          mdReadmeStatus.className =
            "small mt-2 p-2 rounded-2 bg-success bg-opacity-25 text-success border border-success border-opacity-50";
          mdReadmeStatus.innerHTML = `<i class="bi bi-check-circle me-1"></i>Successfully loaded README (${text.length} characters)!`;
          mdReadmeStatus.classList.remove("d-none");
        }

        setTimeout(() => {
          mdReadmeDrawer?.classList.add("d-none");
          mdToggleReadmeBtn?.classList.remove("active");
        }, 1500);
      } else {
        if (mdReadmeStatus) {
          mdReadmeStatus.className =
            "small mt-2 p-2 rounded-2 bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50";
          mdReadmeStatus.innerHTML = `<i class="bi bi-x-circle me-1"></i>${error || "Failed to fetch README."}`;
          mdReadmeStatus.classList.remove("d-none");
        }
      }
    });

    mdToolbar?.querySelectorAll<HTMLButtonElement>(".md-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const action = btn.getAttribute("data-action");
        if (action === "bold") insertMarkdown("**", "**", "bold text");
        else if (action === "italic") insertMarkdown("*", "*", "italic text");
        else if (action === "strike")
          insertMarkdown("~~", "~~", "strikethrough text");
        else if (action === "h1") insertMarkdown("# ", "", "Heading 1");
        else if (action === "h2") insertMarkdown("## ", "", "Heading 2");
        else if (action === "h3") insertMarkdown("### ", "", "Heading 3");
        else if (action === "bullet") insertMarkdown("- ", "", "List item");
        else if (action === "numbered") insertMarkdown("1. ", "", "List item");
        else if (action === "task") insertMarkdown("- [ ] ", "", "Task item");
        else if (action === "quote") insertMarkdown("> ", "", "Quote text");
        else if (action === "inline-code") insertMarkdown("`", "`", "code");
        else if (action === "code-block")
          insertMarkdown("```ts\n", "\n```\n", "// Code snippet");
        else if (action === "link")
          insertMarkdown("[", "](https://)", "Link text");
        else if (action === "image")
          insertMarkdown("![", "](https://)", "Image description");
        else if (action === "table")
          insertMarkdown(
            "\n| Column 1 | Column 2 |\n| --- | --- |\n| Item 1 | Detail 1 |\n| Item 2 | Detail 2 |\n",
          );
        else if (action === "hr") insertMarkdown("\n\n---\n\n");
      });
    });
  });
</script>
