    ) !important;
    border-color: var(--color-primary-light, #ff79c6) !important;
    color: #ffffff !important;
    box-shadow: 0 0 14px rgba(var(--color-secondary-rgb, 155, 93, 229), 0.5);
    transform: translateY(-1px);
  }

  /* View Switcher, Fullscreen, & Drawer Buttons */
  .md-view-btn,
