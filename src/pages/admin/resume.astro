---
// src/pages/admin/resume.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase, getAdminCounts } from '../../utils/supabase';
import { groupSkillsByCategory } from '../../utils/skills';
import { ResumeService } from '../../services/resumeService';
import { GitHubProjectsService } from '../../services/githubProjectsService';
import '../../styles/resume-styles.scss';

// Fetch data & counts for tab counters (including skills and unified projects)
const [portfolioProjectsResult, { data: experiences }, { data: skills }, adminCounts, savedConfig] = await Promise.all([
  GitHubProjectsService.getPortfolioProjects(supabase),
  supabase.from('work_experience').select('*').order('order_index', { ascending: true }),
  supabase.from('skills').select('*').order('category', { ascending: true }).order('order_index', { ascending: true }),
  getAdminCounts(supabase),
  ResumeService.getConfig(supabase)
]);

const projects = portfolioProjectsResult?.projects || [];
const safeProjectsJson = JSON.stringify(projects || []);
const safeExperiencesJson = JSON.stringify(experiences || []);
const safeSkillsJson = JSON.stringify(skills || []);
const safeSavedConfigJson = JSON.stringify(savedConfig || {});

// Group skills by category for the checklist display
const groupedSkills = groupSkillsByCategory(skills || []);
---

<AdminLayout 
  activePage="resume" 
  title="Interactive Resume Builder"
  counts={adminCounts}
>
  <div 
    id="resume-builder-root" 
    data-projects={safeProjectsJson} 
    data-experiences={safeExperiencesJson}
    data-skills={safeSkillsJson}
    data-saved-config={safeSavedConfigJson}
    class="row g-4"
  >
    <!-- Left: Configuration & Selection Form -->
    <div class="col-lg-5 no-print">
      <div class="card border border-secondary p-4 rounded-4 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
          <h3 class="text-gradient h5 mb-0 fw-bold">Resume Builder Options</h3>
          
          <!-- Actions: Save to DB, Reset, Downloads (.docx & .pdf) -->
          <div class="d-flex flex-wrap gap-2">
            <button type="button" id="save-db-btn" class="btn btn-success btn-sm px-3 shadow-sm d-flex align-items-center gap-1 font-monospace">
              <i class="bi bi-cloud-arrow-up"></i>
              <span id="save-btn-text">Save to DB</span>
            </button>

            <button type="button" id="reset-defaults-btn" class="btn btn-outline-secondary btn-sm px-2 text-light" title="Reset fields to defaults">
              <i class="bi bi-arrow-counterclockwise"></i>
            </button>

            <button type="button" id="download-docx-btn" class="btn btn-primary btn-sm px-3 shadow-sm d-flex align-items-center gap-1">
              <i class="bi bi-file-earmark-word"></i>
              <span>.docx</span>
            </button>

            <button type="button" id="download-pdf-btn" class="btn btn-outline-info text-accent btn-sm px-3 shadow-sm d-flex align-items-center gap-1">
              <i class="bi bi-file-earmark-pdf"></i>
              <span>.pdf</span>
            </button>
          </div>
        </div>

        <!-- AI Job Description Optimizer & Refinement -->
        <div class="card bg-dark bg-opacity-50 border border-info border-opacity-50 rounded-3 p-3 mb-3">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label text-accent small fw-bold mb-0 d-flex align-items-center gap-2">
              <i class="bi bi-stars"></i>
              <span>AI Target Job Optimizer</span>
            </label>
            <span class="badge bg-info bg-opacity-25 text-accent font-monospace" style="font-size: 0.65rem;">Gemini AI</span>
          </div>
          
          <div class="mb-2">
            <label class="form-label text-light small mb-1" for="ai-job-url">LinkedIn or Job Posting URL</label>
            <input type="url" id="ai-job-url" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://www.linkedin.com/jobs/view/... or Indeed..." />
          </div>

          <div class="mb-2">
            <label class="form-label text-light small mb-1" for="ai-job-desc">Job Description Text</label>
            <textarea id="ai-job-desc" class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" placeholder="Paste full job description text directly (or leave empty if using URL)..."></textarea>
          </div>

          <div class="mb-2">
            <input type="password" id="ai-api-key" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Gemini API Key (optional if GEMINI_API_KEY in .env)" />
          </div>

          <button type="button" id="ai-optimize-btn" class="btn btn-outline-info text-accent btn-sm w-100 d-flex align-items-center justify-content-center gap-2 font-monospace mb-2">
            <i class="bi bi-magic"></i>
            <span id="ai-btn-text">Generate Tailored Resume & Cover Letter</span>
          </button>

          <!-- Interactive AI Refinement Chat (Directly on Builder) -->
          <div class="border-top border-secondary border-opacity-25 pt-2 mt-2">
            <label class="form-label text-muted small fw-bold mb-1 d-flex align-items-center gap-1" for="ai-refine-input" style="font-size: 0.75rem;">
              <i class="bi bi-chat-dots"></i>
              <span>Talk to Gemini / Make Corrections</span>
            </label>
            <div class="input-group input-group-sm mb-1">
              <input type="text" id="ai-refine-input" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. 'Add Docker & SQL', 'Keep to 1 page', 'Bold key metrics'..." />
              <button class="btn btn-outline-info text-accent font-monospace" type="button" id="ai-refine-btn">
                <span id="ai-refine-btn-text">Send</span>
              </button>
            </div>
            <div class="text-muted" style="font-size: 0.7rem;">Gemini will directly switch checkboxes, rewrite bullets, and update your preview.</div>
          </div>
        </div>

        <!-- AI Change Log (Shown once when AI generates or refines - styled strictly with active theme vars) -->
        <div id="ai-change-log" class="card p-3 mb-3 rounded-3 shadow-sm d-none" style="background: color-mix(in srgb, var(--color-primary) 12%, var(--card-bg)); border: 1px solid color-mix(in srgb, var(--color-primary) 45%, var(--card-border-color)); font-size: 0.8rem;">
          <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-secondary border-opacity-25">
            <span class="fw-bold text-accent d-flex align-items-center gap-1 font-monospace" style="color: var(--color-primary-light) !important;">
              <i class="bi bi-stars"></i>
              <span>Gemini Update Log</span>
            </span>
            <button type="button" id="close-change-log-btn" class="btn-close btn-close-white" style="font-size: 0.65rem;" aria-label="Close"></button>
          </div>
          <div id="ai-change-log-content" style="color: var(--body-color);"></div>
        </div>

        <!-- Single Page Status Indicator Banner -->
        <div id="page-status-banner" class="d-flex align-items-center justify-content-between p-2 mb-3 rounded-3" style="font-size: 0.8rem; background: color-mix(in srgb, var(--color-success) 12%, var(--card-bg)); border: 1px solid color-mix(in srgb, var(--color-success) 45%, var(--card-border-color)); color: var(--body-color);">
          <div class="d-flex align-items-center gap-2">
            <span id="page-status-icon">✅</span>
            <span id="page-status-text"><strong>Fits perfectly on 1 page (11")</strong></span>
          </div>
          <span id="page-height-metric" class="font-monospace small" style="color: var(--color-text-muted-light);">0%</span>
        </div>

        <!-- Template Style Selector -->
        <div class="mb-3">
          <label class="form-label text-accent small fw-bold">Resume Template Style</label>
          <div class="btn-group w-100" role="group">
            <input type="radio" class="btn-check" name="resume-style" id="style-modern" value="modern" checked />
            <label class="btn btn-outline-secondary btn-sm" for="style-modern">Modern</label>

            <input type="radio" class="btn-check" name="resume-style" id="style-classic" value="classic" />
            <label class="btn btn-outline-secondary btn-sm" for="style-classic">Classic</label>

            <input type="radio" class="btn-check" name="resume-style" id="style-minimal" value="minimal" />
            <label class="btn btn-outline-secondary btn-sm" for="style-minimal">Minimal</label>
          </div>
        </div>

        <!-- Compact Mode Toggle for 1-Page Fitting -->
        <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded-3 bg-dark bg-opacity-50 border border-secondary border-opacity-50">
          <div>
            <label class="form-check-label text-light small fw-bold" for="compact-mode-toggle">Compact Spacing</label>
            <div class="text-muted" style="font-size: 0.7rem;">Tightens line-height to fit dense content onto 1 page</div>
          </div>
          <div class="form-check form-switch mb-0">
            <input class="form-check-input" type="checkbox" id="compact-mode-toggle" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-light small fw-bold">Full Name</label>
          <input type="text" id="resume-name" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. Alex Morgan" />
        </div>

        <!-- Dedicated Contact & Link Fields -->
        <div class="row g-2 mb-2">
          <div class="col-6">
            <label class="form-label text-light small">Location</label>
            <input type="text" id="resume-location" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. City, State" />
          </div>
          <div class="col-6">
            <label class="form-label text-light small">Phone Number</label>
            <input type="tel" id="resume-phone" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="(555) 012-3456" maxlength="14" />
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label text-light small">Email Address</label>
          <input type="email" id="resume-email" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="e.g. user@example.com" />
        </div>

        <div class="row g-2 mb-2">
          <div class="col-6">
            <label class="form-label text-light small">GitHub URL</label>
            <input type="url" id="resume-github" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://github.com/username" />
          </div>
          <div class="col-6">
            <label class="form-label text-light small">LinkedIn URL</label>
            <input type="url" id="resume-linkedin" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://linkedin.com/in/username" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label text-light small">Portfolio / Personal Site URL</label>
          <input type="url" id="resume-portfolio" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="https://example.com" />
        </div>

        <div class="mb-3">
          <label class="form-label text-light small fw-bold">Professional Summary</label>
          <textarea id="resume-summary" class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" placeholder="Enter summary points or paragraph..."></textarea>
        </div>

        <!-- Skills Checklist Section with Per-Category "Select All" -->
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label class="form-label text-accent small fw-bold mb-0">Include Technical Skills</label>
            <small class="text-muted" style="font-size: 0.7rem;">Check to include</small>
          </div>
          <div class="border border-secondary rounded-3 p-2 bg-dark bg-opacity-50" style="max-height: 200px; overflow-y: auto;">
            {Object.keys(groupedSkills).length > 0 ? (
              Object.entries(groupedSkills).map(([cat, catSkills]) => {
                const safeCatId = cat.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
                return (
                  <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-25 pb-1 mb-1">
                      <span class="text-muted font-monospace small fw-bold" style="font-size: 0.75rem;">
                        {cat}
                      </span>
                      <div class="form-check form-check-sm mb-0">
                        <input 
                          class="form-check-input skill-category-toggle" 
                          type="checkbox" 
                          id={`cat-toggle-${safeCatId}`} 
                          data-category={cat}
                        />
                        <label class="form-check-label text-muted user-select-none" for={`cat-toggle-${safeCatId}`} style="font-size: 0.7rem;">
                          All
                        </label>
                      </div>
                    </div>
                    <div class="row row-cols-2 g-1 ps-1">
                      {catSkills?.map((s) => (
                        <div class="col">
                          <div class="form-check form-check-sm mb-1 text-truncate">
                            <input 
                              class="form-check-input resume-skill-cb" 
                              type="checkbox" 
                              value={s.id} 
                              id={`rb-skill-${s.id}`} 
                              data-category={cat}
                            />
                            <label class="form-check-label text-muted user-select-none text-truncate" for={`rb-skill-${s.id}`} title={s.name} style="color: var(--color-text-muted-mid)">
                              {s.name}
                            </label>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })
            ) : (
              <p class="text-muted small mb-0 p-2">No skills available to display.</p>
            )}
          </div>
        </div>

        <!-- Experience Selection List -->
        <div class="mb-3">
          <label class="form-label text-accent small fw-bold mb-1">Select Professional Experience</label>
          <div class="border border-secondary rounded-3 p-2 bg-dark bg-opacity-50" style="max-height: 150px; overflow-y: auto;">
            {(experiences || []).map((e: any) => (
              <div class="form-check form-check-sm mb-1 text-truncate">
                <input class="form-check-input resume-exp-cb" type="checkbox" value={e.id} id={`rb-exp-${e.id}`} />
                <label class="form-check-label text-light user-select-none text-truncate small" for={`rb-exp-${e.id}`}>
                  {e.company} — <span class="text-muted">{e.role}</span>
                </label>
              </div>
            ))}
          </div>
        </div>

        <!-- Projects Selection List -->
        <div class="mb-3">
          <label class="form-label text-accent small fw-bold mb-1">Select Projects</label>
          <div class="border border-secondary rounded-3 p-2 bg-dark bg-opacity-50" style="max-height: 150px; overflow-y: auto;">
            {(projects || []).map((p: any) => (
              <div class="form-check form-check-sm mb-1 text-truncate">
                <input class="form-check-input resume-project-cb" type="checkbox" value={p.id} id={`rb-proj-${p.id}`} />
                <label class="form-check-label text-light user-select-none text-truncate small" for={`rb-proj-${p.id}`}>
                  {p.title}
                </label>
              </div>
            ))}
          </div>
        </div>

        <!-- Education -->
        <div>
          <label class="form-label text-light small fw-bold">Education</label>
          <textarea id="resume-education" class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" placeholder="University, Degree, Year"></textarea>
        </div>

      </div>
    </div>

    <!-- Right: Real-time Live Sheet Preview (Auto-Scaled) & Cover Letter Tab -->
    <div class="col-lg-7">
      <div class="card border border-secondary p-3 p-md-4 rounded-4 shadow-sm bg-dark bg-opacity-25 print-container-clean">
        <!-- Preview Navigation Tabs & Metrics Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 no-print">
          <ul class="nav nav-pills" id="preview-mode-tabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active py-1 px-3 small font-monospace d-flex align-items-center gap-1" id="tab-resume-btn" data-bs-toggle="pill" data-bs-target="#tab-resume-pane" type="button" role="tab" aria-controls="tab-resume-pane" aria-selected="true">
                <i class="bi bi-file-earmark-person"></i>
                <span>Resume (8.5" × 11")</span>
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link py-1 px-3 small font-monospace d-flex align-items-center gap-1 position-relative" id="tab-cover-letter-btn" data-bs-toggle="pill" data-bs-target="#tab-cover-letter-pane" type="button" role="tab" aria-controls="tab-cover-letter-pane" aria-selected="false">
                <i class="bi bi-envelope-paper"></i>
                <span>Cover Letter</span>
                <span id="cover-letter-ready-dot" class="badge rounded-pill bg-info p-1 ms-1 d-none" style="font-size: 0.5rem;">New</span>
              </button>
            </li>
          </ul>

          <div class="d-flex align-items-center gap-2">
            <span id="page-badge-counter" class="badge bg-success font-monospace small">1 PAGE</span>
          </div>
        </div>

        <!-- Tab Content -->
        <div class="tab-content" id="previewTabContent">
          <!-- Tab 1: Resume Paper Preview -->
          <div class="tab-pane fade show active" id="tab-resume-pane" role="tabpanel" aria-labelledby="tab-resume-btn" tabindex="0">
            <!-- Scroller container that tracks available viewport size -->
            <div 
              id="paper-viewport-scroller" 
              class="paper-viewport-scroller w-100 d-flex justify-content-center align-items-start rounded-3 p-2 p-md-3 bg-dark bg-opacity-50 border border-secondary border-opacity-50 overflow-auto" 
              style="min-height: 600px; height: 85vh; max-height: 960px;"
            >
              <!-- Dynamic Wrapper sized to match scaled paper dimensions -->
              <div id="paper-scale-wrapper" class="paper-scale-wrapper position-relative">
                <div id="resume-sheet-preview" class="resume-sheet resume-style-modern text-dark bg-white shadow-lg">
                  
                  <!-- Content Wrapper to accurately measure height against 1056px -->
                  <div id="resume-content-measurer" class="w-100">
                    <!-- Header -->
                    <div class="text-center resume-header">
                      <h2 id="prev-name" class="fw-bold mb-1 text-uppercase fs-4 text-dark"></h2>
                      <div id="prev-contact-line1" class="small resume-contact-text mb-1"></div>
                      <div id="prev-contact-line2" class="small resume-links-text"></div>
                    </div>

                    <!-- Summary -->
                    <div class="mb-2" id="prev-summary-container">
                      <div class="resume-section-title">Professional Summary</div>
                      <div id="prev-summary" class="small mb-0" style="line-height: 1.35;"></div>
                    </div>

                    <!-- Technical Skills Section -->
                    <div class="mb-2" id="prev-skills-container">
                      <div class="resume-section-title">Technical Skills</div>
                      <div id="prev-skills" class="small mb-0 text-dark" style="font-size: 0.8rem; line-height: 1.4;"></div>
                    </div>

                    <!-- Experience -->
                    <div class="mb-2" id="prev-experience-container">
                      <div class="resume-section-title">Professional Experience</div>
                      <div id="prev-experience" class="d-flex flex-column gap-2"></div>
                    </div>

                    <!-- Projects -->
                    <div class="mb-2" id="prev-projects-container">
                      <div class="resume-section-title">Selected Projects</div>
                      <div id="prev-projects" class="d-flex flex-column gap-2"></div>
                    </div>

                    <!-- Education -->
                    <div id="prev-education-container">
                      <div class="resume-section-title">Education</div>
                      <div id="prev-education" class="small mb-0" style="line-height: 1.35;"></div>
                    </div>
                  </div>

                  <!-- 1-Page Cutoff Red Guideline -->
                  <div id="page-cutoff-line" class="position-absolute start-0 end-0 border-top border-2 border-danger border-opacity-75 d-none" style="top: 1056px; z-index: 100;">
                    <span class="badge bg-danger position-absolute end-0 top-0 translate-middle-y me-2 font-monospace" style="font-size: 0.65rem;">Page 2 Cutoff</span>
                  </div>

                </div>
              </div>
            </div>
          </div>

          <!-- Tab 2: Cover Letter Tab Pane -->
          <div class="tab-pane fade" id="tab-cover-letter-pane" role="tabpanel" aria-labelledby="tab-cover-letter-btn" tabindex="0">
            <!-- Cover Letter Actions Header -->
            <div class="d-flex justify-content-between align-items-center mb-2 px-1">
              <span class="text-accent small fw-bold font-monospace d-flex align-items-center gap-1">
                <i class="bi bi-file-earmark-text"></i>
                <span>Generated Cover Letter</span>
              </span>
              <div class="d-flex gap-2">
                <button type="button" id="copy-cover-letter-btn" class="btn btn-outline-secondary btn-sm py-1 px-3 font-monospace d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                  <i class="bi bi-clipboard"></i>
                  <span>Copy Text</span>
                </button>
                <button type="button" id="download-cover-letter-pdf-btn" class="btn btn-outline-info text-accent btn-sm py-1 px-3 shadow-sm font-monospace d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                  <i class="bi bi-file-earmark-pdf"></i>
                  <span>Download PDF</span>
                </button>
              </div>
            </div>

            <!-- Cover Letter Paper Preview Card -->
            <div class="paper-viewport-scroller w-100 d-flex justify-content-center align-items-start rounded-3 p-2 p-md-3 bg-dark bg-opacity-50 border border-secondary border-opacity-50" style="min-height: 600px; height: 85vh; max-height: 960px; overflow-y: auto;">
              <div class="cover-letter-sheet bg-white text-dark shadow-lg rounded-2 p-4 p-md-5" style="max-width: 816px; width: 100%; min-height: 700px; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; background-color: #ffffff !important; color: #111827 !important;">
                <!-- Cover Letter Header -->
                <div class="cover-letter-header border-bottom border-2 border-primary pb-3 mb-4 text-center text-md-start">
                  <h3 id="cl-prev-name" class="fw-bold mb-1 text-uppercase fs-4 text-dark" style="color: #0f172a !important;"></h3>
                  <div id="cl-prev-contact" class="cover-letter-contact small mb-1" style="color: #4b5563 !important;"></div>
                  <div id="cl-prev-links" class="cover-letter-links small font-monospace" style="color: #4b5563 !important;"></div>
                </div>

                <!-- Cover Letter Body -->
                <div id="cover-letter-body-display" class="cover-letter-body text-dark" style="font-size: 0.95rem; line-height: 1.65; white-space: pre-wrap; color: #111827 !important;">
                  <div class="cover-letter-placeholder fst-italic py-4 text-center" style="color: #64748b !important;">
                    No cover letter generated yet. Paste a job description or URL on the left and click "Generate Tailored Resume & Cover Letter" to produce a tailored letter.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</AdminLayout>

<style>
  /* Fixed true-to-life physical US Letter dimensions: 8.5" x 11" at 96 DPI = 816px x 1056px */
  .resume-sheet {
    width: 816px !important;
    min-height: 1056px !important;
    padding: 36px 40px !important;
    box-sizing: border-box !important;
    transform-origin: top center;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    overflow: visible;
  }

  .resume-sheet.compact-mode {
    padding: 24px 32px !important;
  }

  .resume-sheet.compact-mode #prev-summary,
  .resume-sheet.compact-mode #prev-skills,
  .resume-sheet.compact-mode p,
  .resume-sheet.compact-mode li {
    font-size: 0.76rem !important;
    line-height: 1.25 !important;
  }

  .resume-sheet.compact-mode .mb-2 {
    margin-bottom: 0.35rem !important;
  }

  .paper-scale-wrapper {
    transition: width 0.15s ease, height 0.15s ease;
  }

  .paper-viewport-scroller {
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .cover-letter-sheet {
    background-color: #ffffff !important;
    color: #111827 !important;
  }

  .cover-letter-sheet h1,
  .cover-letter-sheet h2,
  .cover-letter-sheet h3,
  .cover-letter-sheet h4,
  .cover-letter-sheet h5,
  .cover-letter-sheet h6,
