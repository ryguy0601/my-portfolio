  }
</style>

<script>
  import { SmartEditorService } from '../../services/smartEditorService';
  import { Document, Paragraph, TextRun, Packer, HeadingLevel } from 'docx';
  import { downloadResumeDirectPdf, downloadCoverLetterDirectPdf } from '../../utils/resumePdfGenerator';

  const builderRoot = document.getElementById('resume-builder-root');
  if (builderRoot) {
    const rawProjects = JSON.parse(builderRoot.getAttribute('data-projects') || '[]');
    const rawExperiences = JSON.parse(builderRoot.getAttribute('data-experiences') || '[]');
    const rawSkills = JSON.parse(builderRoot.getAttribute('data-skills') || '[]');
    const savedConfig = JSON.parse(builderRoot.getAttribute('data-saved-config') || '{}');

    // Helper: matches a project by any of its identifier variants (id, numeric_id, slug, repo_name)
    function matchesProjectId(project: any, targetId: any): boolean {
      if (!project || targetId === undefined || targetId === null) return false;
      const t = String(targetId).trim().toLowerCase();
      if (!t) return false;
      return (
        String(project.id || '').trim().toLowerCase() === t ||
        String(project.numeric_id || '').trim().toLowerCase() === t ||
        String(project.slug || '').trim().toLowerCase() === t ||
        String(project.repo_name || '').trim().toLowerCase() === t
      );
    }

    const nameInput = document.getElementById('resume-name') as HTMLInputElement;
    const locationInput = document.getElementById('resume-location') as HTMLInputElement;
    const phoneInput = document.getElementById('resume-phone') as HTMLInputElement;
    const emailInput = document.getElementById('resume-email') as HTMLInputElement;
    const githubInput = document.getElementById('resume-github') as HTMLInputElement;
    const linkedinInput = document.getElementById('resume-linkedin') as HTMLInputElement;
    const portfolioInput = document.getElementById('resume-portfolio') as HTMLInputElement;
    const summaryInput = document.getElementById('resume-summary') as HTMLTextAreaElement;
    const educationInput = document.getElementById('resume-education') as HTMLTextAreaElement;
    const compactToggle = document.getElementById('compact-mode-toggle') as HTMLInputElement;

    const prevName = document.getElementById('prev-name');
    const prevContactLine1 = document.getElementById('prev-contact-line1');
    const prevContactLine2 = document.getElementById('prev-contact-line2');
    const prevSummary = document.getElementById('prev-summary');
    const prevSkillsContainer = document.getElementById('prev-skills-container');
    const prevSkills = document.getElementById('prev-skills');
    const prevExp = document.getElementById('prev-experience');
    const prevProj = document.getElementById('prev-projects');
    const prevEdu = document.getElementById('prev-education');

    const sheet = document.getElementById('resume-sheet-preview');
    const contentMeasurer = document.getElementById('resume-content-measurer');
    const scaleWrapper = document.getElementById('paper-scale-wrapper');
    const scroller = document.getElementById('paper-viewport-scroller');
    const cutoffLine = document.getElementById('page-cutoff-line');

    const pageStatusBanner = document.getElementById('page-status-banner');
    const pageStatusIcon = document.getElementById('page-status-icon');
    const pageStatusText = document.getElementById('page-status-text');
    const pageHeightMetric = document.getElementById('page-height-metric');
    const pageBadgeCounter = document.getElementById('page-badge-counter');

    const saveDbBtn = document.getElementById('save-db-btn');
    const saveBtnText = document.getElementById('save-btn-text');

    const STORAGE_KEY = 'admin_resume_builder_cache_v5';
    const ONE_PAGE_MAX_HEIGHT = 1056; // 11 inches at 96 DPI
    let currentPreviewScale = 1;

    function getPreviewScale(): number {
      return currentPreviewScale || 1;
    }

    function fitPaperToViewport() {
      if (!sheet || !scaleWrapper || !scroller) return;

      const SHEET_WIDTH = 816;
      // Fixed height of 1 page is exactly 11 inches = 1056px at 96 DPI.
      // If content overflows ONE_PAGE_MAX_HEIGHT (1056px), the sheet height expands
      // and the preview viewport container scrolls so the user can inspect overflow past the cutoff line.
      const contentHeight = Math.max(ONE_PAGE_MAX_HEIGHT, sheet.offsetHeight || ONE_PAGE_MAX_HEIGHT);

      const containerWidth = scroller.clientWidth - 32;
      const containerHeight = scroller.clientHeight - 32;

      if (containerWidth <= 0 || containerHeight <= 0) return;

      // Fit width to available viewport while scaling
      const scaleX = containerWidth / SHEET_WIDTH;
      const scaleY = containerHeight / ONE_PAGE_MAX_HEIGHT;
      const scale = Math.min(scaleX, scaleY, 1);
      currentPreviewScale = scale;

      sheet.style.transform = `translateX(-50%) scale(${scale})`;

      scaleWrapper.style.width = `${SHEET_WIDTH * scale}px`;
      scaleWrapper.style.height = `${contentHeight * scale}px`;
    }

    const resumeTabBtn = document.getElementById('tab-resume-btn');
    resumeTabBtn?.addEventListener('shown.bs.tab', () => {
      setTimeout(fitPaperToViewport, 50);
    });

    function formatPhoneNumber(value: string): string {
      if (!value) return '';
      const cleaned = value.replace(/\D/g, '');
      if (cleaned.length === 0) return '';
      if (cleaned.length < 4) return `(${cleaned}`;
      if (cleaned.length < 7) return `(${cleaned.slice(0, 3)}) ${cleaned.slice(3)}`;
      return `(${cleaned.slice(0, 3)}) ${cleaned.slice(3, 6)}-${cleaned.slice(6, 10)}`;
    }

    function ensureHttp(url: string): string {
      const trimmed = url.trim();
      if (!trimmed) return '';
      if (/^https?:\/\//i.test(trimmed)) return trimmed;
      return `https://${trimmed}`;
    }

    function syncCategoryCheckboxes() {
      document.querySelectorAll<HTMLInputElement>('.skill-category-toggle').forEach(catToggle => {
        const category = catToggle.getAttribute('data-category');
        if (!category) return;

        const childCheckboxes = Array.from(
          document.querySelectorAll<HTMLInputElement>('.resume-skill-cb')
        ).filter(cb => cb.getAttribute('data-category') === category);

        if (childCheckboxes.length === 0) return;

        const checkedCount = childCheckboxes.filter(cb => cb.checked).length;
        if (checkedCount === 0) {
          catToggle.checked = false;
          catToggle.indeterminate = false;
        } else if (checkedCount === childCheckboxes.length) {
          catToggle.checked = true;
          catToggle.indeterminate = false;
        } else {
          catToggle.checked = false;
          catToggle.indeterminate = true;
        }
      });
    }

    function getSelectedStyle(): 'modern' | 'classic' | 'minimal' {
      const checkedRadio = document.querySelector<HTMLInputElement>('input[name="resume-style"]:checked');
      return (checkedRadio?.value as any) || 'modern';
    }

    function setSelectedStyle(styleName: string) {
      const radio = document.querySelector<HTMLInputElement>(`input[name="resume-style"][value="${styleName}"]`);
      if (radio) {
        radio.checked = true;
      }
      applyTemplateClass(styleName);
    }

    let customTailoredProjects: any[] | null = null;

    function applyTemplateClass(styleName: string) {
      if (!sheet) return;
      sheet.classList.remove('resume-style-modern', 'resume-style-classic', 'resume-style-minimal');
      sheet.classList.add(`resume-style-${styleName}`);
    }

    function loadInitialState() {
      let cached: any = {};
      try {
        const cachedRaw = localStorage.getItem(STORAGE_KEY);
        if (cachedRaw) {
          cached = JSON.parse(cachedRaw);
        }
      } catch (err) {
        console.error('Failed to parse resume cache:', err);
      }

      // Merge order: localStorage cache -> savedConfig from Supabase
      const config = { ...savedConfig, ...cached };

      nameInput.value = config.name || '';
      locationInput.value = config.location || '';
      phoneInput.value = formatPhoneNumber(config.phone || '');
      emailInput.value = config.email || '';
      githubInput.value = config.github || '';
      linkedinInput.value = config.linkedin || '';
      portfolioInput.value = config.portfolio || '';
      summaryInput.value = config.summary || '';
      educationInput.value = config.education || '';

      if (config.compactMode) {
        compactToggle.checked = true;
      }

      setSelectedStyle(config.style || 'modern');

      const hasCachedProjects = Array.isArray(config.selectedProjects) && config.selectedProjects.length > 0;
      let matchedAnyProject = false;
      document.querySelectorAll<HTMLInputElement>('.resume-project-cb').forEach((cb, idx) => {
        const proj = rawProjects.find((p: any) => matchesProjectId(p, cb.value));
        const isMatched = hasCachedProjects && config.selectedProjects.some((targetId: any) => {
          return String(cb.value).trim().toLowerCase() === String(targetId).trim().toLowerCase() ||
                 (proj && matchesProjectId(proj, targetId));
        });
        if (isMatched) matchedAnyProject = true;
        cb.checked = isMatched;
      });

      // If cached project IDs were from legacy database numbers and matched nothing, default to top 3 projects
      if (!matchedAnyProject) {
        document.querySelectorAll<HTMLInputElement>('.resume-project-cb').forEach((cb, idx) => {
          cb.checked = idx < 3;
        });
      }

      const hasCachedExperiences = Array.isArray(config.selectedExperiences) && config.selectedExperiences.length > 0;
      document.querySelectorAll<HTMLInputElement>('.resume-exp-cb').forEach(cb => {
        cb.checked = hasCachedExperiences ? config.selectedExperiences.map(String).includes(String(cb.value)) : true;
      });

      const hasCachedSkills = Array.isArray(config.selectedSkills) && config.selectedSkills.length > 0;
      document.querySelectorAll<HTMLInputElement>('.resume-skill-cb').forEach(cb => {
        cb.checked = hasCachedSkills ? config.selectedSkills.map(String).includes(String(cb.value)) : true;
      });

      if (Array.isArray(config.tailoredProjects) && config.tailoredProjects.length > 0) {
        customTailoredProjects = config.tailoredProjects;
      }

      syncCategoryCheckboxes();
      setTimeout(fitPaperToViewport, 50);
    }

    function getCurrentState() {
      const selectedProjects = Array.from(
        document.querySelectorAll<HTMLInputElement>(`.resume-project-cb:checked`)
      ).map(cb => cb.value);

      const selectedExperiences = Array.from(
        document.querySelectorAll<HTMLInputElement>(`.resume-exp-cb:checked`)
      ).map(cb => cb.value);

      const selectedSkills = Array.from(
        document.querySelectorAll<HTMLInputElement>(`.resume-skill-cb:checked`)
      ).map(cb => cb.value);

      return {
        name: nameInput.value,
        location: locationInput.value,
        phone: phoneInput.value,
        email: emailInput.value,
        github: githubInput.value,
        linkedin: linkedinInput.value,
        portfolio: portfolioInput.value,
        summary: summaryInput.value,
        education: educationInput.value,
        style: getSelectedStyle(),
        compactMode: compactToggle.checked,
        selectedProjects,
        tailoredProjects: customTailoredProjects,
        selectedExperiences,
        selectedSkills
      };
    }

    function saveCachedState() {
      try {
        const data = getCurrentState();
        localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      } catch (err) {
        console.error('Failed to save resume cache:', err);
      }
    }

    function checkPageHeight() {
      if (!contentMeasurer || !sheet) return;

      // Accurately measure the unscaled content height plus actual vertical padding
      const isCompact = compactToggle.checked;
      const verticalPadding = isCompact ? 48 : 72; // 24px * 2 in compact, 36px * 2 in standard
      const totalHeight = Math.round(contentMeasurer.getBoundingClientRect().height / (getPreviewScale() || 1)) + verticalPadding;
      const percentage = Math.round((totalHeight / ONE_PAGE_MAX_HEIGHT) * 100);

      if (pageHeightMetric) {
        pageHeightMetric.textContent = `${totalHeight}px / ${ONE_PAGE_MAX_HEIGHT}px (${percentage}%)`;
      }

      if (totalHeight > ONE_PAGE_MAX_HEIGHT) {
        // Exceeds 1 page!
        if (pageStatusBanner) {
          pageStatusBanner.style.background = 'color-mix(in srgb, var(--color-warning) 12%, var(--card-bg))';
          pageStatusBanner.style.border = '1px solid color-mix(in srgb, var(--color-warning) 50%, var(--card-border-color))';
          pageStatusBanner.style.color = 'var(--body-color)';
        }
        if (pageStatusIcon) pageStatusIcon.textContent = '⚠️';
        if (pageStatusText) {
          pageStatusText.innerHTML = `<strong>Exceeds 1 page (${totalHeight - ONE_PAGE_MAX_HEIGHT}px over)</strong> — Enable Compact Spacing or trim items`;
        }
        if (pageBadgeCounter) {
          pageBadgeCounter.className = 'badge bg-warning text-dark font-monospace small';
          pageBadgeCounter.textContent = 'OVER 1 PAGE';
        }
        if (cutoffLine) {
          cutoffLine.classList.remove('d-none');
        }
      } else {
        // Fits comfortably
        if (pageStatusBanner) {
          pageStatusBanner.style.background = 'color-mix(in srgb, var(--color-success) 12%, var(--card-bg))';
          pageStatusBanner.style.border = '1px solid color-mix(in srgb, var(--color-success) 45%, var(--card-border-color))';
          pageStatusBanner.style.color = 'var(--body-color)';
        }
        if (pageStatusIcon) pageStatusIcon.textContent = '✅';
        if (pageStatusText) {
          pageStatusText.innerHTML = `<strong>Fits on 1 page (${ONE_PAGE_MAX_HEIGHT - totalHeight}px remaining)</strong>`;
        }
        if (pageBadgeCounter) {
          pageBadgeCounter.className = 'badge bg-success font-monospace small';
          pageBadgeCounter.textContent = '1 PAGE';
        }
        if (cutoffLine) {
          cutoffLine.classList.add('d-none');
        }
      }
    }

    function splitBullets(text: string): string[] {
      if (!text) return [];
      return text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
    }

    function formatBoldText(t: string): string {
      if (!t) return '';
      return t
        .replace(/\*\*(.*?)\*\*/gs, '<strong class="fw-bold">$1</strong>')
        .replace(/__(.*?)__/gs, '<strong class="fw-bold">$1</strong>');
    }

    function createHtmlBulletList(lines: string[]): string {
      if (lines.length === 0) return '';
      if (lines.length === 1) {
        return `<p class="small mb-0 text-dark" style="font-size: 0.8rem; line-height: 1.3;">${formatBoldText(lines[0])}</p>`;
      }
      return `<ul class="small mb-0 text-dark ps-3" style="font-size: 0.8rem; line-height: 1.3;">${lines.map(l => `<li style="margin-bottom: 2px;">${formatBoldText(l)}</li>`).join('')}</ul>`;
    }

    function renderPreview() {
      saveCachedState();
      syncCategoryCheckboxes();

      if (compactToggle.checked) {
        sheet?.classList.add('compact-mode');
      } else {
        sheet?.classList.remove('compact-mode');
      }

      applyTemplateClass(getSelectedStyle());

      if (prevName) prevName.textContent = nameInput.value || 'YOUR NAME';
      if (prevEdu) prevEdu.innerHTML = formatBoldText(educationInput.value).replace(/\n/g, '<br/>');

      const contactElements: string[] = [];
      if (locationInput.value.trim()) contactElements.push(locationInput.value.trim());
      if (phoneInput.value.trim()) contactElements.push(phoneInput.value.trim());
      if (emailInput.value.trim()) contactElements.push(emailInput.value.trim());

      if (prevContactLine1) {
        prevContactLine1.innerHTML = contactElements.join(' &bull; ');
        prevContactLine1.style.display = contactElements.length > 0 ? 'block' : 'none';
      }

      const linkElements: string[] = [];
      if (githubInput.value.trim()) {
        const href = ensureHttp(githubInput.value);
        linkElements.push(`<a href="${href}" target="_blank" class="text-dark text-decoration-underline">GitHub</a>`);
      }
      if (linkedinInput.value.trim()) {
        const href = ensureHttp(linkedinInput.value);
        linkElements.push(`<a href="${href}" target="_blank" class="text-dark text-decoration-underline">LinkedIn</a>`);
      }
      if (portfolioInput.value.trim()) {
        const href = ensureHttp(portfolioInput.value);
        linkElements.push(`<a href="${href}" target="_blank" class="text-dark text-decoration-underline">Portfolio</a>`);
      }

      if (prevContactLine2) {
        prevContactLine2.innerHTML = linkElements.join(' &bull; ');
        prevContactLine2.style.display = linkElements.length > 0 ? 'block' : 'none';
      }

      const summaryText = summaryInput.value.trim();
      if (prevSummary) {
        prevSummary.innerHTML = createHtmlBulletList(splitBullets(summaryText));
      }
      const prevSummaryContainer = document.getElementById('prev-summary-container');
      if (prevSummaryContainer) {
        prevSummaryContainer.style.display = summaryText ? 'block' : 'none';
      }

      const selectedSkillIds = Array.from(document.querySelectorAll<HTMLInputElement>('.resume-skill-cb:checked')).map(cb => cb.value);
      const activeSkills = rawSkills.filter((s: any) => selectedSkillIds.includes(String(s.id)));

      if (prevSkills) {
        if (activeSkills.length === 0) {
          prevSkills.innerHTML = '';
          if (prevSkillsContainer) prevSkillsContainer.style.display = 'none';
        } else {
          if (prevSkillsContainer) prevSkillsContainer.style.display = 'block';
          const grouped: Record<string, string[]> = {};
          activeSkills.forEach((s: any) => {
            const cat = s.category || 'General';
            if (!grouped[cat]) grouped[cat] = [];
            grouped[cat].push(s.name);
          });

          prevSkills.innerHTML = Object.entries(grouped).map(([cat, list]) => `
            <div class="mb-1">
              <strong>${cat}:</strong> ${list.join(', ')}
            </div>
          `).join('');
        }
      }

      const selectedExpIds = Array.from(document.querySelectorAll<HTMLInputElement>('.resume-exp-cb:checked')).map(cb => cb.value);
      if (prevExp) {
        prevExp.innerHTML = '';
        rawExperiences.filter((e: any) => selectedExpIds.includes(String(e.id))).forEach((exp: any) => {
          const div = document.createElement('div');
          div.className = 'mb-2';
          div.innerHTML = `
            <div class="d-flex justify-content-between fw-bold small text-dark mb-1">
              <span>${exp.company} — <span class="fw-normal">${exp.role}</span></span>
              <span class="font-monospace resume-date-text">${exp.start_date} – ${exp.end_date || 'Present'}</span>
            </div>
            ${createHtmlBulletList(splitBullets(exp.description))}
          `;
          prevExp.appendChild(div);
        });
      }

      const selectedProjIds = Array.from(document.querySelectorAll<HTMLInputElement>('.resume-project-cb:checked')).map(cb => cb.value);
      if (prevProj) {
        prevProj.innerHTML = '';
        rawProjects.filter((p: any) => selectedProjIds.some(id => matchesProjectId(p, id))).forEach((proj: any) => {
          const linkParts: string[] = [];
          if (proj.github_url) {
            linkParts.push(`<a href="${ensureHttp(proj.github_url)}" target="_blank" class="text-dark text-decoration-underline font-monospace">GitHub</a>`);
          }

          // If we have AI-tailored bullets for this project, use them!
          const tailored = (customTailoredProjects || []).find((tp: any) => matchesProjectId(tp, proj.id));
          const bullets = tailored && Array.isArray(tailored.bullets) && tailored.bullets.length > 0
            ? tailored.bullets
            : splitBullets(proj.summary || proj.content?.trim() || '');
          const techStack = tailored?.tech_stack || proj.tech_stack || '';

          const div = document.createElement('div');
          div.className = 'mb-2';
          div.innerHTML = `
            <div class="d-flex justify-content-between align-items-baseline fw-bold small text-dark">
              <span>${proj.title} ${techStack ? `<span class="fw-normal resume-meta-text" style="font-size: 0.78rem;">— ${techStack}</span>` : ''}</span>
              ${linkParts.length > 0 ? `<span class="small font-monospace">${linkParts.join(' | ')}</span>` : ''}
            </div>
            ${createHtmlBulletList(bullets)}
          `;
          prevProj.appendChild(div);
        });
      }

      fitPaperToViewport();
      setTimeout(checkPageHeight, 50);
    }

    // Save to Database Button
    saveDbBtn?.addEventListener('click', async () => {
      if (saveBtnText) saveBtnText.textContent = 'Saving...';
      try {
        const payload = getCurrentState();
        const res = await fetch('/api/resume-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          if (saveBtnText) saveBtnText.textContent = 'Saved!';
          setTimeout(() => {
            if (saveBtnText) saveBtnText.textContent = 'Save to DB';
          }, 2000);
        } else {
          alert('Failed to save to database.');
          if (saveBtnText) saveBtnText.textContent = 'Save to DB';
        }
      } catch (err: any) {
        alert('Network error saving to database: ' + err.message);
        if (saveBtnText) saveBtnText.textContent = 'Save to DB';
      }
    });

    loadInitialState();

    document.querySelectorAll<HTMLInputElement>('input[name="resume-style"]').forEach(radio => {
      radio.addEventListener('change', renderPreview);
    });

    compactToggle?.addEventListener('change', renderPreview);

    document.querySelectorAll<HTMLInputElement>('.skill-category-toggle').forEach(catToggle => {
      catToggle.addEventListener('change', () => {
        const category = catToggle.getAttribute('data-category');
        if (!category) return;
        
        const isChecked = catToggle.checked;
        document.querySelectorAll<HTMLInputElement>('.resume-skill-cb').forEach(childCb => {
          if (childCb.getAttribute('data-category') === category) {
            childCb.checked = isChecked;
          }
        });

        renderPreview();
      });
    });

    phoneInput?.addEventListener('input', (e) => {
      const input = e.target as HTMLInputElement;
      input.value = formatPhoneNumber(input.value);
      renderPreview();
    });

    document.getElementById('reset-defaults-btn')?.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      loadInitialState();
      renderPreview();
    });

    [
      nameInput, locationInput, emailInput, 
      githubInput, linkedinInput, portfolioInput, 
      summaryInput, educationInput
    ].forEach(el => el?.addEventListener('input', renderPreview));

    document.querySelectorAll<HTMLInputElement>('.resume-skill-cb, .resume-exp-cb, .resume-project-cb').forEach(cb => {
      cb.addEventListener('change', renderPreview);
    });

    // AI Optimizer & Refinement State
    let currentAiResult: any = null;
    let currentCoverLetter: string = '';
    const aiOptimizeBtn = document.getElementById('ai-optimize-btn');
    const aiBtnText = document.getElementById('ai-btn-text');
    const aiJobUrl = document.getElementById('ai-job-url') as HTMLInputElement;
    const aiJobDesc = document.getElementById('ai-job-desc') as HTMLTextAreaElement;
    const aiApiKey = document.getElementById('ai-api-key') as HTMLInputElement;

    const aiRefineBtn = document.getElementById('ai-refine-btn');
    const aiRefineInput = document.getElementById('ai-refine-input') as HTMLInputElement;
    const aiRefineBtnText = document.getElementById('ai-refine-btn-text');

    const aiChangeLog = document.getElementById('ai-change-log');
    const aiChangeLogContent = document.getElementById('ai-change-log-content');
    const closeChangeLogBtn = document.getElementById('close-change-log-btn');

    const clPrevName = document.getElementById('cl-prev-name');
    const clPrevContact = document.getElementById('cl-prev-contact');
    const clPrevLinks = document.getElementById('cl-prev-links');
    const coverLetterBodyDisplay = document.getElementById('cover-letter-body-display');
    const coverLetterReadyDot = document.getElementById('cover-letter-ready-dot');

    closeChangeLogBtn?.addEventListener('click', () => {
      aiChangeLog?.classList.add('d-none');
    });

    function formatMarkdownBold(text: string): string {
      return formatBoldText(text);
    }

    function updateCoverLetterPreview(text: string) {
      currentCoverLetter = text || '';
      if (clPrevName) clPrevName.textContent = nameInput.value || 'RYAN CUCCURULLO';
      
      const contactList = [locationInput.value, phoneInput.value, emailInput.value].filter(Boolean);
      if (clPrevContact) clPrevContact.textContent = contactList.join(' • ');

      const linksList = [linkedinInput.value ? 'LinkedIn' : '', githubInput.value ? 'GitHub' : '', portfolioInput.value ? 'Portfolio' : ''].filter(Boolean);
      if (clPrevLinks) clPrevLinks.textContent = linksList.join(' • ');

      if (coverLetterBodyDisplay) {
        if (text && text.trim()) {
          coverLetterBodyDisplay.innerHTML = formatMarkdownBold(text.trim());
          if (coverLetterReadyDot) coverLetterReadyDot.classList.remove('d-none');
        } else {
          coverLetterBodyDisplay.innerHTML = `
            <div class="cover-letter-placeholder fst-italic py-4 text-center" style="color: #64748b !important;">
              No cover letter generated yet. Paste a job description or URL on the left and click "Generate Tailored Resume & Cover Letter" to produce a tailored letter.
            </div>
          `;
          if (coverLetterReadyDot) coverLetterReadyDot.classList.add('d-none');
        }
      }
    }

    function applyAiResultDirectly(result: any, changeTitle: string = 'Gemini Applied Changes') {
      currentAiResult = result;

      // 1. Update Professional Summary
      if (result.tailoredSummary) {
        summaryInput.value = result.tailoredSummary;
      }

      // 2. Update Skills Checkboxes
      if (Array.isArray(result.selectedSkillIds) && result.selectedSkillIds.length > 0) {
        const idSet = new Set(result.selectedSkillIds.map(String));
        document.querySelectorAll<HTMLInputElement>('.resume-skill-cb').forEach(cb => {
          cb.checked = idSet.has(String(cb.value));
        });
      }

      // 3. Update Projects & custom tailored bullets
      if (Array.isArray(result.tailoredProjects) && result.tailoredProjects.length > 0) {
        customTailoredProjects = result.tailoredProjects;
      }
      if (Array.isArray(result.selectedProjectIds) && result.selectedProjectIds.length > 0) {
        document.querySelectorAll<HTMLInputElement>('.resume-project-cb').forEach(cb => {
          const proj = rawProjects.find((p: any) => matchesProjectId(p, cb.value));
          cb.checked = result.selectedProjectIds.some((targetId: any) => {
            return String(cb.value).trim().toLowerCase() === String(targetId).trim().toLowerCase() ||
                   (proj && matchesProjectId(proj, targetId));
          });
        });
      }

      // 4. Update Work Experiences
      if (Array.isArray(result.selectedExperienceIds) && result.selectedExperienceIds.length > 0) {
        const idSet = new Set(result.selectedExperienceIds.map(String));
        document.querySelectorAll<HTMLInputElement>('.resume-exp-cb').forEach(cb => {
          cb.checked = idSet.has(String(cb.value));
        });
      }

      // 5. Update Cover Letter
      if (result.coverLetter) {
        updateCoverLetterPreview(result.coverLetter);
      }

      // 6. Display Change Log Once to the User
      if (aiChangeLog && aiChangeLogContent) {
        let insightsHtml = '';
        if (Array.isArray(result.matchingInsights) && result.matchingInsights.length > 0) {
          insightsHtml = `<ul class="mb-0 ps-3">${result.matchingInsights.map((i: string) => `<li class="mb-1">${formatMarkdownBold(i)}</li>`).join('')}</ul>`;
        } else if (result.matchingInsights) {
          insightsHtml = `<p class="mb-0">${formatMarkdownBold(result.matchingInsights)}</p>`;
        } else {
          insightsHtml = `<p class="mb-0">Selected skills, experience, projects, and summary tailored to your target job.</p>`;
        }
        aiChangeLogContent.innerHTML = insightsHtml;
        aiChangeLog.classList.remove('d-none');
      }

      // 7. Re-render builder resume preview immediately
      renderPreview();
    }

    aiOptimizeBtn?.addEventListener('click', async () => {
      const urlVal = aiJobUrl?.value.trim() || '';
      const descVal = aiJobDesc?.value.trim() || '';
      const keyVal = aiApiKey?.value.trim() || '';

      if (!urlVal && !descVal) {
        alert('Please provide a job URL or paste the job description text.');
        return;
      }

      if (aiBtnText) aiBtnText.textContent = 'Optimizing & Updating...';
      if (aiOptimizeBtn) (aiOptimizeBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/optimize-resume', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            jobUrl: urlVal,
            jobDescription: descVal,
            apiKey: keyVal,
            currentProfile: {
              name: nameInput.value,
              summary: summaryInput.value,
              education: educationInput.value
            }
          })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Optimization request failed');
        }

        applyAiResultDirectly(data.data, 'Target Job Optimization Completed');
      } catch (err: any) {
        alert('Error: ' + err.message);
      } finally {
        if (aiBtnText) aiBtnText.textContent = 'Generate Tailored Resume & Cover Letter';
        if (aiOptimizeBtn) (aiOptimizeBtn as HTMLButtonElement).disabled = false;
      }
    });

    async function sendRefinement() {
      const instructions = aiRefineInput?.value.trim();
      if (!instructions) return;
      if (!currentAiResult) {
        alert('Please click "Generate Tailored Resume & Cover Letter" first, or let Gemini analyze a job description.');
        return;
      }

      if (aiRefineBtnText) aiRefineBtnText.textContent = '...';
      if (aiRefineBtn) (aiRefineBtn as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch('/api/optimize-resume', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            instructions,
            previousResult: currentAiResult,
            apiKey: aiApiKey?.value.trim() || '',
            currentProfile: {
              name: nameInput.value,
              summary: summaryInput.value,
              education: educationInput.value
            }
          })
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          throw new Error(data.error || 'Refinement failed');
        }

        applyAiResultDirectly(data.data, 'Gemini Refinement Applied');
        aiRefineInput.value = '';
      } catch (err: any) {
        alert('Error refining with Gemini: ' + err.message);
      } finally {
        if (aiRefineBtnText) aiRefineBtnText.textContent = 'Send';
        if (aiRefineBtn) (aiRefineBtn as HTMLButtonElement).disabled = false;
      }
    }

    aiRefineBtn?.addEventListener('click', sendRefinement);
    aiRefineInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        sendRefinement();
      }
    });

    document.getElementById('copy-cover-letter-btn')?.addEventListener('click', () => {
      if (currentCoverLetter) {
        navigator.clipboard.writeText(currentCoverLetter);
        alert('Cover letter copied to clipboard!');
      } else {
        alert('No cover letter available to copy.');
      }
    });

    document.getElementById('download-cover-letter-pdf-btn')?.addEventListener('click', async () => {
      if (!currentCoverLetter) {
        alert('No cover letter generated yet.');
        return;
      }

      const btn = document.getElementById('download-cover-letter-pdf-btn') as HTMLButtonElement;
      if (btn) btn.disabled = true;

      try {
        await downloadCoverLetterDirectPdf({
          name: nameInput.value || 'Ryan Cuccurullo',
          location: locationInput.value,
          phone: phoneInput.value,
          email: emailInput.value,
          linkedin: linkedinInput.value
        }, currentCoverLetter, `${(nameInput.value || 'Ryan_Cuccurullo').replace(/\s+/g, '_')}_Cover_Letter.pdf`);
      } catch (err: any) {
        alert('Failed to generate cover letter PDF: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // Print PDF helper function that prints any resume state directly without modifying the database or main preview
    function printResumeDirectly(data: any) {
      const selectedSkillIds = data.selectedSkills || [];
      const skillsToPrint = rawSkills.filter((s: any) => selectedSkillIds.includes(String(s.id)));

      const selectedExpIds = data.selectedExperiences || [];
      const expToPrint = rawExperiences.filter((e: any) => selectedExpIds.includes(String(e.id)));

      const selectedProjIds = data.selectedProjects || [];
      const projToPrint = rawProjects.filter((p: any) => selectedProjIds.some(id => matchesProjectId(p, id)));

      const contactList: string[] = [];
      if (data.location) contactList.push(data.location);
      if (data.phone) contactList.push(data.phone);
      if (data.email) contactList.push(data.email);

      const linksList: string[] = [];
      if (data.linkedin) linksList.push(`<a href="${ensureHttp(data.linkedin)}" target="_blank">LinkedIn</a>`);
      if (data.github) linksList.push(`<a href="${ensureHttp(data.github)}" target="_blank">GitHub</a>`);
      if (data.portfolio) linksList.push(`<a href="${ensureHttp(data.portfolio)}" target="_blank">Portfolio</a>`);

      const grouped: Record<string, string[]> = {};
      skillsToPrint.forEach((s: any) => {
        const cat = s.category || 'General';
        if (!grouped[cat]) grouped[cat] = [];
        grouped[cat].push(s.name);
      });

      const summaryBullets = splitBullets(data.summary || '');
      const styleClass = `resume-style-${data.style || 'modern'}`;
      const isCompact = data.compactMode ? 'compact-mode' : '';

      const printWin = window.open('', '_blank');
      if (!printWin) {
        alert('Please allow popups to open the print dialog.');
        return;
      }

      printWin.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="utf-8" />
          <title>${data.name || 'Resume'} - Print</title>
          <style>
            @page { size: letter portrait; margin: 0.4in; }
            body {
              margin: 0; padding: 0; background: #ffffff; color: #111827;
              font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
              font-size: 9.5pt; line-height: 1.35;
            }
            .header { text-align: center; border-bottom: 2px solid #2563eb; padding-bottom: 6px; margin-bottom: 10px; }
            .header h1 { margin: 0 0 4px 0; font-size: 18pt; font-weight: bold; text-transform: uppercase; color: #0f172a; }
            .contact, .links { font-size: 8.5pt; color: #4b5563; margin-bottom: 2px; }
            a { color: #1d4ed8; text-decoration: underline; }
            .section-title {
              font-weight: bold; text-transform: uppercase; font-size: 8.5pt;
              letter-spacing: 0.05em; color: #1e3a8a; border-bottom: 1px solid #93c5fd;
              padding-bottom: 2px; margin-top: 8px; margin-bottom: 5px;
            }
            ul { margin: 2px 0 6px 18px; padding: 0; }
            li { margin-bottom: 2px; line-height: 1.3; }
            .exp-item, .proj-item { margin-bottom: 6px; }
            .exp-header, .proj-header {
              display: flex; justify-content: space-between; align-items: baseline; font-size: 9pt; margin-bottom: 2px;
            }
            .date, .tech { color: #4b5563; font-size: 8.5pt; }
            .compact-mode body { font-size: 9pt; line-height: 1.25; }
            .compact-mode li { margin-bottom: 1px; }
            .resume-style-classic { font-family: 'Georgia', 'Cambria', serif; }
            .resume-style-classic .header { border-bottom: 2px solid #111; }
            .resume-style-classic .section-title { color: #111; border-bottom: 1px solid #444; }
            .resume-style-minimal { font-family: 'Calibri', 'Arial', sans-serif; }
            .resume-style-minimal .header { border-bottom: 1.5px solid #475569; }
            .resume-style-minimal .section-title { color: #334155; border-bottom: 1px solid #cbd5e1; }
          </style>
        </head>
        <body class="${styleClass} ${isCompact}">
          <div class="header">
            <h1>${data.name || 'RYAN CUCCURULLO'}</h1>
            <div class="contact">${contactList.join(' &bull; ')}</div>
            <div class="links">${linksList.join(' &bull; ')}</div>
          </div>

          ${summaryBullets.length > 0 ? `
            <div class="section-title">Professional Summary</div>
            ${summaryBullets.length === 1 ? `<p style="margin: 0 0 6px 0;">${formatBoldText(summaryBullets[0])}</p>` : `
              <ul>${summaryBullets.map((b: string) => `<li>${formatBoldText(b)}</li>`).join('')}</ul>
            `}
          ` : ''}

          ${Object.keys(grouped).length > 0 ? `
            <div class="section-title">Technical Skills</div>
            <div style="font-size: 8.5pt; margin-bottom: 6px;">
              ${Object.entries(grouped).map(([cat, list]) => `
                <div><strong>${cat}:</strong> ${(list as string[]).join(', ')}</div>
              `).join('')}
            </div>
          ` : ''}

          ${expToPrint.length > 0 ? `
            <div class="section-title">Professional Experience</div>
            ${expToPrint.map((exp: any) => `
              <div class="exp-item">
                <div class="exp-header">
                  <span><strong>${exp.company}</strong> — ${exp.role}</span>
                  <span class="date">${exp.start_date} – ${exp.end_date || 'Present'}</span>
                </div>
                <ul>${splitBullets(exp.description || '').map((b: string) => `<li>${formatBoldText(b)}</li>`).join('')}</ul>
              </div>
            `).join('')}
          ` : ''}

          ${projToPrint.length > 0 ? `
            <div class="section-title">Selected Projects</div>
            ${projToPrint.map((proj: any) => `
              <div class="proj-item">
                <div class="proj-header">
                  <span><strong>${proj.title}</strong> ${proj.tech_stack ? `— <span class="tech">${proj.tech_stack}</span>` : ''}</span>
                  ${proj.github_url ? `<a href="${ensureHttp(proj.github_url)}" target="_blank">GitHub</a>` : ''}
                </div>
                <ul>${splitBullets(proj.summary || proj.content || '').map((b: string) => `<li>${formatBoldText(b)}</li>`).join('')}</ul>
              </div>
            `).join('')}
          ` : ''}

          ${data.education ? `
            <div class="section-title">Education</div>
            <div style="font-size: 8.5pt; white-space: pre-line;">${formatBoldText(data.education)}</div>
          ` : ''}

          <script>
            window.onload = function() {
              window.print();
            };
          <\/script>
        </body>
        </html>
      `);
      printWin.document.close();
    }

    // Main PDF Download Button (Direct File Download - Clean, No URL/Headers)
    document.getElementById('download-pdf-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('download-pdf-btn') as HTMLButtonElement;
      if (btn) btn.disabled = true;

      try {
        const state = getCurrentState();
        const selectedSkills = rawSkills.filter((s: any) => state.selectedSkills.includes(String(s.id)));
        const selectedExperiences = rawExperiences.filter((e: any) => state.selectedExperiences.includes(String(e.id)));

        // Filter projects checked in the UI and enrich with custom tailored bullets/tech stack while preserving repo github_url
        let selectedProjects = rawProjects
          .filter((p: any) => state.selectedProjects.some(id => matchesProjectId(p, id)))
          .map((p: any) => {
            const tailored = (customTailoredProjects || []).find((tp: any) => matchesProjectId(tp, p.id));
            if (tailored) {
              return {
                ...p,
                title: tailored.title || p.title,
                tech_stack: tailored.tech_stack || p.tech_stack,
                bullets: tailored.bullets || p.bullets,
                github_url: tailored.github_url || p.github_url
              };
            }
            return p;
          });

        if (selectedProjects.length === 0 && Array.isArray(customTailoredProjects) && customTailoredProjects.length > 0) {
          selectedProjects = customTailoredProjects.map((tp: any) => {
            const matchedRaw = rawProjects.find((p: any) => matchesProjectId(p, tp.id));
            return {
              ...tp,
              github_url: tp.github_url || matchedRaw?.github_url
            };
          });
        }

        await downloadResumeDirectPdf({
          ...state,
          selectedSkills,
          selectedProjects,
          selectedExperiences
        }, `${(state.name || 'Resume').replace(/\s+/g, '_')}.pdf`);
      } catch (err: any) {
        alert('Failed to generate PDF: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    document.getElementById('download-docx-btn')?.addEventListener('click', async () => {
      const current = getCurrentState();
      const children: any[] = [];

      children.push(new Paragraph({
        text: current.name || 'RYAN CUCCURULLO',
        heading: HeadingLevel.TITLE
      }));

      const contact = [current.location, current.phone, current.email].filter(Boolean).join(' | ');
      if (contact) {
        children.push(new Paragraph({ text: contact }));
      }

      if (current.summary) {
        children.push(new Paragraph({ text: 'PROFESSIONAL SUMMARY', heading: HeadingLevel.HEADING_1 }));
        children.push(new Paragraph({ text: current.summary }));
      }

      children.push(new Paragraph({ text: 'EDUCATION', heading: HeadingLevel.HEADING_1 }));
      children.push(new Paragraph({ text: current.education || 'Farmingdale State College' }));

      const doc = new Document({
        sections: [{ properties: {}, children }]
      });

      const blob = await Packer.toBlob(doc);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${(current.name || 'Resume').replace(/\s+/g, '_')}_Resume.docx`;
      a.click();
      URL.revokeObjectURL(url);
    });

    renderPreview();
  }
</script>
