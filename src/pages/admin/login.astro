---
// src/pages/admin/login.astro
import '../../styles/main.scss';

import { generateSecret, verify, generateURI } from 'otplib';
import QRCode from 'qrcode';
import {
  setAdminSession,
  setPendingMfaSecret,
  getPendingMfaSecret,
  clearPendingMfaSecret,
  getLoginThrottle,
  recordLoginFailure,
  clearLoginFailures
} from '../../utils/auth';

let errorMessage = '';
let qrCodeUrl = '';
let setupSecret = '';

function readEnv(key: string): string {
  const fromProcess = typeof process !== 'undefined' ? process.env?.[key] : undefined;
  const fromImport = (import.meta as any).env?.[key];
  return String(fromProcess || fromImport || '').trim();
}

const MASTER_PASSWORD = readEnv('ADMIN_PASSWORD');
const mfaEnvSetting = readEnv('ADMIN_MFA_SECRET');

// Only enter enrolment mode when explicitly requested. An empty value is a
// configuration error, not an invitation to enrol a new device.
const showQrSetup = mfaEnvSetting === 'INIT';

function getClientIdentifier(): string {
  try {
    if (Astro.clientAddress) return Astro.clientAddress;
  } catch {
    /* adapter without clientAddress support */
  }
  return (
    Astro.request.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
    Astro.request.headers.get('x-real-ip') ||
    'unknown'
  );
}

// Enrolment mode: keep the candidate secret server-side (httpOnly cookie) so the
// QR code and the secret shown on screen stay identical across re-renders.
// It is never read back from the submitted form.
if (showQrSetup) {
  setupSecret = getPendingMfaSecret(Astro.cookies);
  if (!setupSecret) {
    setupSecret = generateSecret();
    setPendingMfaSecret(Astro.cookies, setupSecret);
  }

  const otpauth = generateURI({
    issuer: 'RyanPortfolio',
    label: 'ryan@portfolio',
    secret: setupSecret,
  });
  qrCodeUrl = await QRCode.toDataURL(otpauth);
}

if (Astro.request.method === 'POST') {
  const identifier = getClientIdentifier();
  const throttle = getLoginThrottle(identifier);

  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString();
  const token = formData.get('token')?.toString();

  // The MFA secret is resolved server-side only. In enrolment mode it comes
  // from the httpOnly cookie issued when the page was rendered.
  const activeSecret = showQrSetup
    ? getPendingMfaSecret(Astro.cookies)
    : mfaEnvSetting;

  if (throttle.blocked) {
    errorMessage = `Too many attempts. Try again in ${Math.ceil(throttle.retryAfterSeconds / 60)} minute(s).`;
  } else if (!MASTER_PASSWORD) {
    errorMessage = 'Configuration error: ADMIN_PASSWORD is not set in your .env file.';
  } else if (password !== MASTER_PASSWORD) {
    recordLoginFailure(identifier);
    errorMessage = 'Incorrect password.';
  } else if (!token) {
    recordLoginFailure(identifier);
    errorMessage = 'Please enter your 6-digit authenticator code.';
  } else if (!activeSecret) {
    errorMessage = 'Configuration error: ADMIN_MFA_SECRET is not set in your .env file.';
  } else {
    const result = await verify({ token, secret: activeSecret });

    if (result.valid) {
      setAdminSession(Astro.cookies);
      clearPendingMfaSecret(Astro.cookies);
      clearLoginFailures(identifier);
      return Astro.redirect('/admin');
    }

    recordLoginFailure(identifier);
    errorMessage = 'Invalid authenticator code. Check your app and try again.';
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Authentication &bull; Ryan Cuccurullo</title>
  </head>
  <body class="bg-body text-light d-flex align-items-center justify-content-center vh-100">
    <div class="card p-4 shadow-lg border border-secondary" style="width: var(--admin-login-width); max-width: calc(100vw - 2rem); background-color: var(--card-bg);">
      <h3 class="mb-3 text-gradient fw-bold text-center">Restricted Access</h3>
      <p class="text-muted small text-center mb-4">Personal portfolio administration gatekeeper.</p>

      {errorMessage && <div class="alert alert-danger py-2 small">{errorMessage}</div>}

      <form method="POST" autocomplete="off">
        <div class="mb-3">
          <label class="form-label small text-muted" for="admin-password">Master Password</label>
          <input
            id="admin-password"
            type="password"
            name="password"
            class="form-control bg-dark text-light border-secondary"
            autocomplete="current-password"
            required
          />
        </div>

        {showQrSetup ? (
          <div class="mb-3 text-center">
            <p class="small text-accent mb-2">First-Time Setup: Scan this QR code with Google Authenticator or Authy:</p>
            <img src={qrCodeUrl} alt="MFA QR Code" class="img-fluid mb-3 bg-white p-2 rounded" />
            <p class="small text-muted mb-2">Then save this secret in your <code>.env</code> file and restart the server:</p>
            <code class="text-accent small d-block mb-2 user-select-all">ADMIN_MFA_SECRET="{setupSecret}"</code>
            <p class="small text-warning mb-0">
              This secret is held in a short-lived cookie. If you do not save it, you will need to start setup again.
            </p>
          </div>
        ) : null}

        <div class="mb-4">
          <label class="form-label small text-muted" for="admin-token">6-Digit Authenticator Code</label>
          <input
            id="admin-token"
            type="text"
            name="token"
            class="form-control bg-dark text-light border-secondary text-center fs-3 tracking-widest font-monospace muted-placeholder"
            style="color: var(--color-text-muted-mid)"
            maxlength="6"
            inputmode="numeric"
            pattern="[0-9]*"
            placeholder="000000"
            autocomplete="one-time-code"
            required
          />
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Authorize Access</button>
      </form>
    </div>
  </body>
</html>
