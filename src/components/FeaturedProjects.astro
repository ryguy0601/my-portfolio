---
// src/components/FeaturedProjects.astro
import TechBadgeList from './TechBadgeList.astro';
import type { Project } from '../utils/projects';
import { parseProjectImages } from '../utils/projects';
import { splitLines } from '../utils/text';

interface Props {
  projects: Project[] | null;
  showArchiveLink?: boolean;
}

const { projects = [], showArchiveLink = true } = Astro.props;

// Group into sets of 2 to give cards substantial horizontal room
const ITEMS_PER_SLIDE = 2;
const chunkedProjects: Project[][] = [];
if (projects) {
  for (let i = 0; i < projects.length; i += ITEMS_PER_SLIDE) {
    chunkedProjects.push(projects.slice(i, i + ITEMS_PER_SLIDE));
  }
}

// Check if pagination/carousel sliding is needed (> 2 projects)
const hasMultiplePages = Boolean(projects && projects.length > ITEMS_PER_SLIDE);
---

<!-- Featured Work Showcase Section -->
<section class="position-relative py-5 bg-card border-top border-secondary overflow-hidden" style="z-index: 1;">
  <div class="container py-4">
    
    <!-- Section Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-5">
      <div>
        <h2 class="fw-bold text-gradient mb-1">Featured Work Showcase</h2>
        <p class="text-muted mb-0">Immersive project cards scaling fluidly with a locked aspect ratio.</p>
      </div>

      {showArchiveLink && (
        <a href="/projects" class="btn btn-outline-secondary btn-sm px-3 text-accent d-inline-flex align-items-center gap-2 shadow-sm flex-shrink-0">
          <span>Explore All Projects Archive</span>
          <span>&rarr;</span>
        </a>
      )}
    </div>

    {projects && projects.length > 0 ? (
      <div class="container-fluid px-lg-5 position-relative">
        
        <!-- Outer Carousel -->
        <div id="portfolioOuterCarousel" class={`carousel slide project-carousel-wrapper ${hasMultiplePages ? '' : 'no-carousel'}`} data-bs-ride={hasMultiplePages ? 'carousel' : 'false'}>
          
          <div class="carousel-inner overflow-hidden py-3">
            {chunkedProjects.map((group, groupIndex) => (
              <div class={`carousel-item ${groupIndex === 0 ? 'active' : ''}`} data-bs-interval="6000">
                <div class="row g-4 justify-content-center">
                  {group.map((project, index) => {
                    const images = parseProjectImages(project);
                    const innerCarouselId = `projectCardCarousel_${project.id}`;
                    const summaryPoints = splitLines(project.summary);

                    return (
                      <div class="col-12 col-md-10 col-lg-6 d-flex justify-content-center">
                        <div class="project-card-unit w-100 d-flex flex-column align-items-center" style={`animation-delay: ${index * 0.12}s;`}>
                          
                          <!-- Centered Title Above Card (Wraps naturally instead of truncating) -->
                          <div class="project-header w-100 text-center mb-3 px-2 d-flex justify-content-center">
                            <h3 class="fw-bold text-gradient mb-0 text-center text-wrap text-break">
                              {project.title}
                            </h3>
                          </div>

                          <!-- Interactive Media Card Centered Below Title -->
                          <div class="card bg-dark shadow-lg rounded-4 overflow-hidden border border-secondary project-card-dimension w-100 mx-auto animate-slide-fade position-relative">
                            
                            <!-- Inner Manual Image Carousel with Fade Transition -->
                            {images.length > 0 ? (
                              <div id={innerCarouselId} class="carousel slide carousel-fade position-absolute top-0 start-0 w-100 h-100 bg-dark" data-bs-interval="false">
                                <div class="carousel-inner w-100 h-100">
                                  {images.map((imgPath: string, imgIdx: number) => (
                                    <div class={`carousel-item w-100 h-100 d-flex align-items-center justify-content-center bg-black ${imgIdx === 0 ? 'active' : ''}`}>
                                      <img 
                                        src={imgPath} 
                                        class="d-block w-100 h-100 object-fit-contain p-2" 
                                        alt={`${project.title} screenshot ${imgIdx + 1}`} 
                                      />
                                    </div>
                                  ))}
                                </div>

                                {images.length > 1 && (
                                  <>
                                    <button class="carousel-control-prev inner-control-btn" type="button" data-bs-target={`#${innerCarouselId}`} data-bs-slide="prev" aria-label="Previous screenshot">
                                      <span class="carousel-control-prev-icon bg-dark rounded-circle p-2 border border-secondary shadow" aria-hidden="true"></span>
                                      <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next inner-control-btn" type="button" data-bs-target={`#${innerCarouselId}`} data-bs-slide="next" aria-label="Next screenshot">
                                      <span class="carousel-control-next-icon bg-dark rounded-circle p-2 border border-secondary shadow" aria-hidden="true"></span>
                                      <span class="visually-hidden">Next</span>
                                    </button>
                                  </>
                                )}
                              </div>
                            ) : (
                              <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark d-flex align-items-center justify-content-center text-muted">
                                <span>No Screenshot Provided</span>
                              </div>
                            )}

                            <!-- Hover Overlay: Summary & Tech Stack Badges -->
                            <div class="card-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4 p-md-5">
                              
                              <!-- Multiline summary rendered as bulleted list -->
                              {summaryPoints.length > 1 ? (
                                <ul class="text-light mb-3 ps-3 flex-grow-0 text-shadow">
                                  {summaryPoints.map((point: string) => (
                                    <li class="mb-1">{point}</li>
                                  ))}
                                </ul>
                              ) : (
                                <p class="text-light mb-3 flex-grow-0 text-shadow">
                                  {summaryPoints[0] || ''}
                                </p>
                              )}

                              <!-- Universal Technology Icon Badges -->
                              <div>
                                <TechBadgeList techStack={project.tech_stack} boxSize={38} iconSize={20} />
                              </div>

                              <a
                                href={`/projects/${project.id}`}
                                class="btn btn-outline-light btn-sm align-self-start mt-3 d-inline-flex align-items-center gap-2 shadow-sm detail-preview-link"
                              >
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5h10M9 12h10M9 19h10M5 5h.01M5 12h.01M5 19h.01" />
                                </svg>
                                <span>View Details</span>
                              </a>

                            </div>

                          </div>

                          <!-- Centered Action Buttons Below Card -->
                          <div class="project-actions-footer w-100 d-flex flex-wrap align-items-center justify-content-center gap-2 mt-3 px-1">
                              {project.live_url && (
                                <a 
                                  href={project.live_url} 
                                  target="_blank" 
                                  rel="noopener noreferrer" 
                                  class="btn btn-primary btn-sm px-3 d-inline-flex align-items-center gap-2 shadow-sm"
                                >
                                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                  </svg>
                                  <span>Live Demo</span>
                                </a>
                              )}

                              {project.github_url && (
                                <a 
                                  href={project.github_url} 
                                  target="_blank" 
                                  rel="noopener noreferrer" 
                                  class="btn btn-sm px-3 d-inline-flex align-items-center gap-2 shadow-sm custom-github-btn"
                                >
                                  <svg width="15" height="15" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                                  </svg>
                                  <span>View Repository</span>
                                </a>
                              )}
                          </div>

                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>

          <!-- Outer Carousel Arrows & Controls -->
          {hasMultiplePages && (
            <>
              <button class="carousel-control-prev outer-control-btn" type="button" data-bs-target="#portfolioOuterCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-dark rounded-circle p-3 border border-secondary shadow" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next outer-control-btn" type="button" data-bs-target="#portfolioOuterCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-dark rounded-circle p-3 border border-secondary shadow" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </>
          )}

        </div>
      </div>
    ) : (
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card bg-dark border border-secondary text-center p-5 rounded-4">
            <p class="text-muted mb-0">No featured projects found. Go to the <a href="/admin" class="text-accent text-decoration-none">Admin Dashboard</a> and check "Feature on Homepage" for your projects!</p>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .project-card-unit {
    max-width: 100%;
  }

  .project-header h3 {
    max-width: 100%;
    line-height: 1.3;
    white-space: normal;
    word-wrap: break-word;
  }

  .project-card-dimension {
    width: 100%;
    min-height: 520px;
    aspect-ratio: 16 / 10;
  }

  /* Keep inner arrows stacked ABOVE the hover overlay and always clickable */
  .inner-control-btn {
    z-index: 10 !important;
    width: 52px;
    height: 100%;
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .inner-control-btn:hover {
    opacity: 1;
    transform: scale(1.08);
  }

  /* Overlay starts hidden and slides up on hover */
  .card-overlay {
    background: var(--project-image-overlay);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    backdrop-filter: blur(4px);
    z-index: 5;
    padding-left: clamp(1rem, 4vw, 3.5rem);
    padding-right: clamp(1rem, 4vw, 3.5rem);
  }

  /* Reveal description and tech badges strictly on mouse hover */
  .project-card-dimension:hover .card-overlay {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Suppress the overlay entirely if any arrow button is actively hovered */
  .project-card-dimension:has(.inner-control-btn:hover) .card-overlay {
    opacity: 0 !important;
    visibility: hidden !important;
    transform: translateY(12px) !important;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .project-card-dimension {
      min-height: 420px;
      aspect-ratio: 4 / 3;
    }
  }

  /* GitHub Button Clean & Glowing Hover State */
  .custom-github-btn {
    background-color: var(--surface-card-subtle);
    border: 1px solid rgba(var(--card-border-rgb), 0.15);
    color: var(--body-color);
    transition: all 0.2s ease-in-out;
  }

  .custom-github-btn:hover {
    background-color: rgba(var(--color-github-glow-rgb), 0.12);
    border-color: var(--color-github-glow);
    color: var(--color-github-glow);
    transform: translateY(-2px);
    box-shadow: var(--shadow-github-glow) !important;
  }

  .custom-github-btn:active {
    transform: translateY(0);
  }
</style>