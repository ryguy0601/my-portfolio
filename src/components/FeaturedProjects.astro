---
// src/components/FeaturedProjects.astro
interface Project {
  id: number;
  title: string;
  summary: string;
  tech_stack: string;
  github_url?: string;
  image_url?: string;
  image_filenames?: string[];
}

interface Props {
  projects: Project[] | null;
  showArchiveLink?: boolean; // New optional parameter, defaults to true
}

const { projects = [], showArchiveLink = true } = Astro.props;

// Helper to chunk featured projects into groups of 3 for the outer carousel slides
const chunkedProjects: Project[][] = [];
if (projects) {
  for (let i = 0; i < projects.length; i += 3) {
    chunkedProjects.push(projects.slice(i, i + 3));
  }
}

// Check if there are enough projects to require pagination/carousel sliding (> 3 projects)
const hasMultiplePages = projects && projects.length > 3;
---

<!-- Featured Work Showcase Section -->
<section class="position-relative py-5 bg-card border-top border-secondary overflow-hidden" style="z-index: 1;">
  <div class="container py-4">
    
    <!-- Section Header (Archive button conditionally renders based on showArchiveLink prop) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mb-5">
      <div>
        <h2 class="fw-bold text-gradient mb-1">Featured Work Showcase</h2>
        <p class="text-muted mb-0">Immersive project cards scaling fluidly with a locked aspect ratio.</p>
      </div>

      {showArchiveLink && (
        <a href="/projects" class="btn btn-outline-secondary btn-sm px-3 text-accent d-inline-flex align-items-center gap-2 shadow-sm flex-shrink-0">
          <span>Explore All Projects Archive</span>
          <span>&rarr;</span>
        </a>
      )}
    </div>

    {projects && projects.length > 0 ? (
      <div class="container-fluid px-lg-5 position-relative">
        
        <!-- Outer Carousel (Auto-sliding & arrows rendered ONLY if > 3 projects exist) -->
        <div id="portfolioOuterCarousel" class={`carousel slide project-carousel-wrapper ${hasMultiplePages ? '' : 'no-carousel'}`} data-bs-ride={hasMultiplePages ? 'carousel' : 'false'}>
          
          <div class="carousel-inner overflow-hidden py-3">
            {chunkedProjects.map((group, groupIndex) => (
              <div class={`carousel-item ${groupIndex === 0 ? 'active' : ''}`} data-bs-interval="6000">
                <div class="row g-4 justify-content-center">
                  {group.map((project, index) => {
                    const images = project.image_filenames && project.image_filenames.length > 0 
                      ? project.image_filenames 
                      : (project.image_url ? [project.image_url] : []);
                    
                    const innerCarouselId = `projectCardCarousel_${project.id}`;

                    return (
                      <div class="col-12 col-md-6 col-lg-4 d-flex justify-content-center">
                        <div class="card shadow-lg rounded-4 overflow-hidden border border-secondary project-card-dimension animate-slide-fade position-relative" style={`animation-delay: ${index * 0.12}s;`}>
                          
                          <!-- Inner Manual Image Carousel -->
                          {images.length > 0 ? (
                            <div id={innerCarouselId} class="carousel slide position-absolute top-0 start-0 w-100 h-100" data-bs-interval="false">
                              <div class="carousel-inner w-100 h-100">
                                {images.map((imgPath: string, imgIdx: number) => (
                                  <div class={`carousel-item w-100 h-100 ${imgIdx === 0 ? 'active' : ''}`}>
                                    <img src={imgPath} class="d-block w-100 h-100 object-fit-cover" alt={`${project.title} screenshot ${imgIdx + 1}`} />
                                  </div>
                                ))}
                              </div>

                              {images.length > 1 && (
                                <>
                                  <button class="carousel-control-prev z-2" type="button" data-bs-target={`#${innerCarouselId}`} data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon bg-dark rounded-circle p-2 border border-secondary shadow" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                  </button>
                                  <button class="carousel-control-next z-2" type="button" data-bs-target={`#${innerCarouselId}`} data-bs-slide="next">
                                    <span class="carousel-control-next-icon bg-dark rounded-circle p-2 border border-secondary shadow" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                  </button>
                                </>
                              )}
                            </div>
                          ) : (
                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark d-flex align-items-center justify-content-center text-muted">
                              <span>No Screenshot Provided</span>
                            </div>
                          )}

                          <!-- Dark Gradient Overlay for Readability -->
                          <div class="card-overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end p-4">
                            <h4 class="text-primary fw-bold mb-2 text-shadow">{project.title}</h4>
                            <p class="text-light small mb-3 flex-grow-0 text-shadow">{project.summary}</p>
                            <div class="mb-3">
                              <span class="badge bg-dark border border-secondary text-accent font-monospace shadow-sm" style="font-size: 0.75rem;">{project.tech_stack}</span>
                            </div>
                            {project.github_url && (
                              <a href={project.github_url} target="_blank" class="btn btn-sm btn-outline-primary align-self-start text-accent bg-dark bg-opacity-75 d-inline-flex align-items-center gap-2 shadow">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                                </svg>
                                <span>View Repository</span>
                              </a>
                            )}
                          </div>

                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>

          <!-- Outer Carousel Arrows & Controls (Rendered ONLY if multiple pages exist) -->
          {hasMultiplePages && (
            <>
              <button class="carousel-control-prev outer-control-btn" type="button" data-bs-target="#portfolioOuterCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon bg-dark rounded-circle p-3 border border-secondary shadow" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next outer-control-btn" type="button" data-bs-target="#portfolioOuterCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon bg-dark rounded-circle p-3 border border-secondary shadow" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            </>
          )}

        </div>
      </div>
    ) : (
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card bg-dark border border-secondary text-center p-5 rounded-4">
            <p class="text-muted mb-0">No featured projects found. Go to the <a href="/admin" class="text-accent text-decoration-none">Admin Dashboard</a> and check "Feature on Homepage" for your projects!</p>
          </div>
        </div>
      </div>
    )}
  </div>
</section>