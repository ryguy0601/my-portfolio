---
// src/components/CommandPalette.astro
import { getBaseUrl } from '../utils/url';
const baseUrl = getBaseUrl();
---

<!-- Global Command Palette Modal (Cmd + K / Ctrl + K) -->
<dialog id="command-palette-dialog" class="cmd-palette-dialog rounded-4 p-0 shadow-2xl">
  <div class="cmd-palette-wrapper d-flex flex-column">
    
    <!-- Search Input Strip -->
    <div class="cmd-search-bar d-flex align-items-center gap-2 px-3 py-3 border-bottom border-secondary border-opacity-25">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="text-accent flex-shrink-0">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        id="cmd-input" 
        type="text" 
        placeholder="Type a command or search projects... (ESC to close)" 
        class="cmd-input flex-grow-1 bg-transparent border-0 text-light shadow-none outline-none font-monospace"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmd-badge text-muted font-monospace small px-2 py-1 rounded">ESC</kbd>
    </div>

    <!-- Quick Navigation Groups & Results -->
    <div id="cmd-results" class="cmd-results-list p-2 overflow-auto" style="max-height: 380px;">
      
      <!-- Primary Navigation -->
      <div class="cmd-group-label text-muted font-monospace small px-2 py-1">NAVIGATION</div>
      <a href={baseUrl} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon font-monospace text-accent">&#x2302;</span>
          <div>
            <div class="cmd-title fw-semibold small">Home</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Landing overview & telemetry</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <a href={`${baseUrl}projects`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon font-monospace text-accent">&#9776;</span>
          <div>
            <div class="cmd-title fw-semibold small">All Projects</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Browse full engineering catalog</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <a href={`${baseUrl}experience`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon font-monospace text-accent">&#9874;</span>
          <div>
            <div class="cmd-title fw-semibold small">Work Experience</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Career history & enterprise engineering</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <a href={`${baseUrl}resume`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon font-monospace text-accent">&#9997;</span>
          <div>
            <div class="cmd-title fw-semibold small">Resume</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Interactive document view & PDF export</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <!-- Quick Links -->
      <div class="cmd-group-label text-muted font-monospace small px-2 py-1 mt-2">EXTERNAL LINKS</div>
      <a href="https://github.com/ryguy0601" target="_blank" rel="noopener noreferrer" class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon text-muted"><i class="bi bi-github"></i></span>
          <div>
            <div class="cmd-title fw-semibold small">GitHub Profile</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">github.com/ryguy0601</div>
          </div>
        </div>
        <span class="cmd-key font-monospace small text-muted">&#8599;</span>
      </a>

      <a href="https://www.linkedin.com/in/ryan-cuccurullo-48b242261/" target="_blank" rel="noopener noreferrer" class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon text-muted"><i class="bi bi-linkedin"></i></span>
          <div>
            <div class="cmd-title fw-semibold small">LinkedIn Profile</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">linkedin.com/in/ryan-cuccurullo</div>
          </div>
        </div>
        <span class="cmd-key font-monospace small text-muted">&#8599;</span>
      </a>

      <!-- Direct Project Quick Shortcuts -->
      <div class="cmd-group-label text-muted font-monospace small px-2 py-1 mt-2">POPULAR PROJECTS</div>
      <a href={`${baseUrl}projects/tailscale-kvm`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon text-accent font-monospace small">&gt;_</span>
          <div>
            <div class="cmd-title fw-semibold small">Tailscale Universal KVM</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Cross-platform mesh software KVM (Rust)</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <a href={`${baseUrl}projects/visualcompare`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon text-accent font-monospace small">&gt;_</span>
          <div>
            <div class="cmd-title fw-semibold small">VisualCompare Engine</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">DOM-aware visual regression engine (Python)</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

      <a href={`${baseUrl}projects/seniorproject`} class="cmd-item d-flex align-items-center justify-content-between p-2 rounded-2 text-decoration-none text-light">
        <div class="d-flex align-items-center gap-3">
          <span class="cmd-icon text-accent font-monospace small">&gt;_</span>
          <div>
            <div class="cmd-title fw-semibold small">BlockIntel Analytics</div>
            <div class="cmd-desc text-muted font-monospace small" style="font-size: 0.72rem;">Crypto intelligence & portfolio tracking platform</div>
          </div>
        </div>
        <kbd class="cmd-key font-monospace small text-muted">&rarr;</kbd>
      </a>

    </div>

    <!-- Footer Tip -->
    <div class="cmd-palette-footer d-flex align-items-center justify-content-between px-3 py-2 border-top border-secondary border-opacity-25 font-monospace small text-muted" style="font-size: 0.72rem;">
      <div class="d-flex align-items-center gap-2">
        <span>Press <kbd class="px-1 bg-dark border border-secondary rounded">ESC</kbd> to dismiss</span>
      </div>
      <div>Ryan Cuccurullo Portfolio</div>
    </div>

  </div>
</dialog>

<style>
  .cmd-palette-dialog {
    width: 90vw;
    max-width: 580px;
    background: rgba(var(--card-bg-rgb), 0.94);
    border: 1px solid var(--border-glass-card);
    color: var(--body-color);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
  }

  .cmd-palette-dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .cmd-input {
    font-size: 0.95rem;
  }
  .cmd-input:focus {
    outline: none !important;
  }

  .cmd-badge, .cmd-key {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cmd-item {
    transition: all 0.15s ease;
  }
  .cmd-item:hover, .cmd-item.selected {
    background: rgba(var(--color-primary-rgb), 0.14) !important;
    transform: translateX(2px);
  }
  .cmd-item:hover .cmd-title, .cmd-item.selected .cmd-title {
    color: var(--color-primary) !important;
  }
</style>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement | null;
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('cmd-results');
    if (!dialog || !input || !resultsContainer) return;

    const openPalette = () => {
      dialog.showModal();
      input.value = '';
      filterItems('');
      input.focus();
    };

    const closePalette = () => {
      dialog.close();
    };

    // Global keyboard shortcut: Cmd + K or Ctrl + K
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) {
          closePalette();
        } else {
          openPalette();
        }
      }
    });

    // Close on clicking backdrop
    dialog.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const inDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!inDialog) {
        closePalette();
      }
    });

    // Filtering items on input
    const filterItems = (query: string) => {
      const q = query.toLowerCase().trim();
      const items = resultsContainer.querySelectorAll<HTMLAnchorElement>('.cmd-item');
      let hasVisible = false;

      items.forEach((item) => {
        const title = item.querySelector('.cmd-title')?.textContent?.toLowerCase() || '';
        const desc = item.querySelector('.cmd-desc')?.textContent?.toLowerCase() || '';
        const match = !q || title.includes(q) || desc.includes(q);
        item.style.display = match ? 'flex' : 'none';
        if (match) hasVisible = true;
      });

      // Show/hide group labels based on whether any item in section is visible
      const groupLabels = resultsContainer.querySelectorAll<HTMLElement>('.cmd-group-label');
      groupLabels.forEach((label) => {
        let sibling = label.nextElementSibling;
        let groupHasVisible = false;
        while (sibling && !sibling.classList.contains('cmd-group-label')) {
          if (sibling.classList.contains('cmd-item') && (sibling as HTMLElement).style.display !== 'none') {
            groupHasVisible = true;
            break;
          }
          sibling = sibling.nextElementSibling;
        }
        label.style.display = groupHasVisible ? 'block' : 'none';
      });
    };

    input.addEventListener('input', () => {
      filterItems(input.value);
    });

    // Wire any nav triggers (e.g. search icons or navbar cmd-k button)
    document.querySelectorAll('[data-open-cmd-palette]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openPalette();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCommandPalette);
  } else {
    setupCommandPalette();
  }
  document.addEventListener('astro:page-load', setupCommandPalette);
</script>
