---
import "../styles/main.scss";

// You can optionally accept a title property for different pages
interface Props {
  title?: string;
}

const { title = "Ryan Cuccurullo — Software Engineer Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-body text-light">
    <!-- Upgraded Navigation Bar (Using fixed-top so it floats seamlessly over the canvas) -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top py-3">
      <div class="container">
        <!-- Brand Logo with Gradient Accents -->
        <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-1 text-decoration-none" href="/">
          <span class="text-accent fw-light">&lt;</span>
          <span class="text-gradient px-1">RC</span>
          <span class="text-accent fw-light">&gt;</span>
        </a>

        <!-- Mobile Toggle Button -->
        <button
          class="navbar-toggler border-secondary shadow-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav align-items-center gap-lg-4 mt-3 mt-lg-0">
            <li class="nav-item">
              <a class="nav-link text-light px-2 py-1 custom-nav-link" href="/#about">About</a>
            </li>
            <li class="nav-item">
              <a class="nav-link text-light px-2 py-1 custom-nav-link" href="/#projects">Projects</a>
            </li>
            <li class="nav-item mt-2 mt-lg-0">
              <a class="btn btn-outline-primary btn-sm px-3 text-accent shadow-sm custom-nav-btn" href="/admin">
                Admin Dashboard
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Page Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Bootstrap JS Bundle (Required for mobile navbar toggle dropdowns) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>
