---
import "../styles/main.scss";
import { supabase } from '../utils/supabase';
import { ThemeService, themeStyle } from '../services/themeService';
import { getBaseUrl, getAdminUrl } from '../utils/url';

interface Props {
  title?: string;
  hasHero?: boolean;
}

const { 
  title = "Ryan Cuccurullo — Software Engineer Portfolio", 
  hasHero = false 
} = Astro.props;

const baseUrl = getBaseUrl();
const adminUrl = getAdminUrl();
const persistedTheme = await ThemeService.getTheme(supabase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" href={`${baseUrl}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style set:html={themeStyle(persistedTheme)}></style>
  </head>
  <body class="bg-body text-light">
    <!-- Navigation Bar (Fixed Top) -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-glass fixed-top py-3">
      <div class="container">
        <!-- Brand Logo with Gradient Accents -->
        <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-1 text-decoration-none" href={baseUrl}>
          <span class="text-accent fw-light">&lt;</span>
          <span class="text-gradient px-1">RC</span>
          <span class="text-accent fw-light">&gt;</span>
        </a>

        <!-- Mobile Toggle Button -->
        <button
          class="navbar-toggler border-secondary shadow-none"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNav"
          aria-controls="navbarNav"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
          <ul class="navbar-nav align-items-center gap-lg-4 mt-3 mt-lg-0">
            <!-- Dynamic Projects Link -->
            <li class="nav-item">
              <a class="nav-link text-light px-2 py-1 custom-nav-link" href={`${baseUrl}projects`} id="projects-nav-link">
                Projects
              </a>
            </li>

            <li class="nav-item mt-2 mt-lg-0">
              <a class="btn btn-outline-info btn-sm px-3 shadow-sm custom-nav-btn" href={adminUrl}>
                Admin Dashboard
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Page Content Slot -->
    <main class={hasHero ? "" : "site-content-pad"}>
      <slot />
    </main>

    <!-- Client-side script to handle smooth scrolling only when on homepage -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const projectsLink = document.getElementById("projects-nav-link");
        if (!projectsLink) return;

        projectsLink.addEventListener("click", (e) => {
          const path = window.location.pathname;
          
          if (path === "/" || path === "") {
            e.preventDefault();
            const projectsSection = document.getElementById("projects") || document.querySelector(".hero-section + section");
            if (projectsSection) {
              projectsSection.scrollIntoView({ behavior: "smooth" });
            } else {
              window.scrollTo({ top: window.innerHeight, behavior: "smooth" });
            }
          } else {
            window.location.href = "/projects";
          }
        });
      });
    </script>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  </body>
</html>

<style>
  /* Offsets content safely beneath the fixed navbar */
  .site-content-pad {
    padding-top: clamp(80px, 10vh, 100px);
  }

  .custom-nav-btn {
    border-color: var(--nav-hover-color, var(--color-secondary));
    color: var(--nav-hover-color, var(--color-secondary));
    transition: all 0.2s ease;

    &:hover {
      background-color: var(--nav-hover-color, var(--color-secondary));
      border-color: var(--nav-hover-color, var(--color-secondary));
      color: var(--nav-bg, var(--body-bg));
    }
  }
</style>