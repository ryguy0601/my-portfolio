---
// src/layouts/AdminLayout.astro
import Layout from './Layout.astro';

interface Props {
  activePage: 'projects' | 'experience' | 'skills' | 'links' | 'resume' | 'theme';
  title?: string;
  errorMessage?: string;
  successMessage?: string;
  counts?: {
    projects?: number;
    experience?: number;
    skills?: number;
    links?: number;
  };
}

const {
  activePage,
  title = 'Portfolio Control Center',
  errorMessage = '',
  successMessage = '',
  counts = {}
} = Astro.props;
---

<Layout title={`Admin — ${title}`}>
  <div class="container-fluid px-lg-5 py-4 mt-4">
    <!-- Top Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
      <div>
        <h1 class="text-gradient fw-bold fs-3 mb-1">Portfolio Control Center</h1>
        <p class="text-muted small mb-0">Manage projects, work experience, technical skills, associations, and export resumes.</p>
      </div>
      <div class="d-flex gap-2 align-items-center">
        <a href="/" class="btn btn-outline-secondary btn-sm text-accent">&larr; Live Portfolio</a>
        <a href="/projects" class="btn btn-outline-secondary btn-sm text-light">Projects Page</a>
        <a href="/admin/logout" class="btn btn-outline-danger btn-sm">Log Out</a>
      </div>
    </div>

    {errorMessage && <div class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger mb-4 py-2">{errorMessage}</div>}
    {successMessage && <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success mb-4 py-2">{successMessage}</div>}

    <!-- Tab Navigation -->
    <ul class="nav nav-pills custom-admin-tabs mb-4 border-bottom border-secondary border-opacity-25 pb-3">
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'projects' ? 'active' : ''}`} href="/admin">
          Projects {counts.projects !== undefined && `(${counts.projects})`}
        </a>
      </li>
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'experience' ? 'active' : ''}`} href="/admin/experience">
          Work Experience {counts.experience !== undefined && `(${counts.experience})`}
        </a>
      </li>
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'skills' ? 'active' : ''}`} href="/admin/skills">
          Skills {counts.skills !== undefined && `(${counts.skills})`}
        </a>
      </li>
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'links' ? 'active' : ''}`} href="/admin/links">
          Experience Links {counts.links !== undefined && `(${counts.links})`}
        </a>
      </li>
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'resume' ? 'active' : ''}`} href="/admin/resume">
          Resume Builder
        </a>
      </li>
      <li class="nav-item">
        <a class={`nav-link ${activePage === 'theme' ? 'active' : ''}`} href="/admin/theme">
          Theme
        </a>
      </li>
    </ul>

    <!-- Slot for Page Content -->
    <slot />
  </div>
</Layout>

<style is:global>
  .custom-admin-tabs .nav-link {
    color: var(--color-text-muted-light);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    transition: var(--transition-interactive);
    margin-right: 0.5rem;

    &:hover {
      color: var(--color-secondary);
      background: var(--border-glass-minimal);
    }

    &.active {
      background: var(--gradient-primary);
      color: var(--color-on-accent) !important;
      box-shadow: var(--shadow-primary-button);
    }
  }

  .scroll-grid-container {
    max-height: 440px;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgba(var(--color-primary-rgb), 0.5) rgba(var(--card-bg-rgb), 0.8);
  }

  .scroll-grid-container::-webkit-scrollbar {
    width: 6px;
  }
  .scroll-grid-container::-webkit-scrollbar-track {
    background: rgba(var(--card-bg-rgb), 0.8);
  }
  .scroll-grid-container::-webkit-scrollbar-thumb {
    background-color: rgba(var(--color-primary-rgb), 0.5);
    border-radius: var(--radius-xs);
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .remove-input-btn {
    line-height: 1;
    padding: 0 0.5rem;
  }
</style>